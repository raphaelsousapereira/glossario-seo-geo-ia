      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/structured-data/search-gallery"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-crawler",
      "termCode": "ai-crawler",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Robô de IA"
        },
        {
          "@language": "en",
          "@value": "AI Crawler"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Robô que coleta páginas para empresas de IA. Há três usos: treino (GPTBot, ClaudeBot, Google-Extended como controle), busca (OAI-SearchBot, Claude-SearchBot, PerplexityBot) e acesso a pedido do usuário (ChatGPT-User, Claude-User, Perplexity-User)."
        },
        {
          "@language": "en",
          "@value": "Bot that collects pages for AI companies. There are three uses: training (GPTBot, ClaudeBot, Google-Extended as a control), search (OAI-SearchBot, Claude-SearchBot, PerplexityBot) and on-demand user fetches (ChatGPT-User, Claude-User, Perplexity-User)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#crawler",
      "termCode": "crawler",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Robô de rastreamento"
        },
        {
          "@language": "en",
          "@value": "Crawler (Bot, Spider)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Programa que visita páginas automaticamente para coletar o conteúdo, como o Googlebot, o Bingbot e os robôs das empresas de IA."
        },
        {
          "@language": "en",
          "@value": "Program that visits pages automatically to collect content, such as Googlebot, Bingbot and AI companies' bots."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-salience",
      "termCode": "entity-salience",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Saliência da entidade"
        },
        {
          "@language": "en",
          "@value": "Entity Salience"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quão central uma entidade é num texto. Páginas em que a marca é o assunto principal, e não uma menção de passagem, reforçam a associação."
        },
        {
          "@language": "en",
          "@value": "How central an entity is in a text. Pages where the brand is the main subject, not a passing mention, strengthen the association."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
