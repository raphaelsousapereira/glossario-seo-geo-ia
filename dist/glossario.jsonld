    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-governance",
      "termCode": "ai-governance",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Governança de IA"
        },
        {
          "@language": "en",
          "@value": "AI Governance"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Políticas, papéis, controles e registros que uma organização usa para decidir como desenvolve, compra e usa IA com responsabilidade."
        },
        {
          "@language": "en",
          "@value": "Policies, roles, controls and records an organization uses to decide how it builds, buys and uses AI responsibly."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#knowledge-graph",
      "termCode": "knowledge-graph",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Grafo de conhecimento"
        },
        {
          "@language": "en",
          "@value": "Knowledge Graph"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Base de entidades e das relações entre elas. O do Google alimenta painéis e respostas; cada site também pode publicar o seu com JSON-LD."
        },
        {
          "@language": "en",
          "@value": "Database of entities and the relationships between them. Google's feeds panels and answers; each site can also publish its own with JSON-LD."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#code-graph",
      "termCode": "code-graph",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Grafo de código"
        },
        {
          "@language": "en",
          "@value": "Code Graph"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Representação de um projeto de software como grafo de arquivos, funções e dependências, usada por agentes de programação para entender o impacto de cada mudança."
        },
        {
          "@language": "en",
          "@value": "Representation of a software project as a graph of files, functions and dependencies, used by coding agents to understand the impact of each change."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#qf-geo",
      "termCode": "qf-geo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Grafo de desdobramento da consulta (QF-GEO)"
        },
        {
          "@language": "en",
          "@value": "Query Fan-Out Graph and Coverage Profile (QF-GEO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Proposta de Raphael Sousa Pereira (preprint no Zenodo, setembro de 2026, DOI 10.5281/zenodo.22096956) com o Query Fan-Out Graph (QFG) e o Query Fan-Out Coverage Profile (QFCP), para representar o espaço de necessidades de informação que a busca por IA desdobra e medir quanto dele um site cobre."
        },
        {
          "@language": "en",
          "@value": "Proposal by Raphael Sousa Pereira (Zenodo preprint, September 2026, DOI 10.5281/zenodo.22096956) with the Query Fan-Out Graph (QFG) and the Query Fan-Out Coverage Profile (QFCP), to represent the space of information needs AI search fans out into and measure how much of it a site covers."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://raphaelsousapereira.com.br/publicacoes-em-seo-geo/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-graph",
      "termCode": "entity-graph",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Grafo de entidades do site"
        },
        {
          "@language": "en",
          "@value": "Entity Graph (Site)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Rede de entidades que o site declara em JSON-LD (Organization, Person, WebSite, Service), ligadas por @id, que dá às máquinas um retrato coerente da marca."
        },
        {
          "@language": "en",
          "@value": "Network of entities a site declares in JSON-LD (Organization, Person, WebSite, Service), linked by @id, giving machines a coherent picture of the brand."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#llm",
      "termCode": "llm",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Grande modelo de linguagem"
        },
        {
          "@language": "en",
          "@value": "Large Language Model (LLM)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de rede neural treinado em grandes volumes de texto para prever e gerar linguagem. Exemplos: GPT, Claude, Gemini, Llama."
        },
        {
          "@language": "en",
          "@value": "Neural network model trained on large volumes of text to predict and generate language. Examples: GPT, Claude, Gemini, Llama."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#graphrag",
      "termCode": "graphrag",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "GraphRAG"
        },
        {
          "@language": "en",
          "@value": "GraphRAG"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Variante de RAG que usa um grafo de entidades e relações, além de trechos de texto, para responder perguntas que exigem ligar informações."
        },
        {
          "@language": "en",
          "@value": "RAG variant that uses a graph of entities and relationships, in addition to text chunks, to answer questions that require connecting information."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#hospedeiro-geo",
      "termCode": "hospedeiro-geo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Hospedeiro (em GEO)"
        },
        {
          "@language": "en",
          "@value": "Host Site (GEO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Nome dado por Raphael Sousa Pereira a um site de conteúdo que publica listas, rankings ou guias em que uma marca de terceiro recebe destaque, funcionando para buscadores e IAs como fonte aparentemente independente sobre essa marca."
        },
        {
          "@language": "en",
          "@value": "Name given by Raphael Sousa Pereira to a content site that publishes lists, rankings or guides in which a third-party brand is featured, acting for search engines and AI as a seemingly independent source about that brand."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/anatomia-de-um-hospedeiro-em-geo/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#https",
      "termCode": "https",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "HTTPS"
        },
        {
          "@language": "en",
          "@value": "HTTPS"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Versão criptografada do HTTP, com certificado TLS. É requisito básico de confiança e sinal leve de ranqueamento."
        },
        {
          "@language": "en",
          "@value": "Encrypted version of HTTP, using a TLS certificate. It is a basic trust requirement and a light ranking signal."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#human-in-the-loop",
      "termCode": "human-in-the-loop",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Humano no circuito"
        },
        {
          "@language": "en",
          "@value": "Human in the Loop"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Desenho em que uma pessoa revisa ou aprova etapas críticas do sistema de IA antes que tenham efeito."
        },
        {
          "@language": "en",
          "@value": "Design in which a person reviews or approves critical steps of an AI system before they take effect."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#constitutional-ai",
      "termCode": "constitutional-ai",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "IA constitucional"
        },
        {
          "@language": "en",
          "@value": "Constitutional AI"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Método da Anthropic em que o modelo critica e revisa as próprias respostas seguindo uma lista escrita de princípios, reduzindo a dependência de rótulos humanos para segurança."
        },
        {
          "@language": "en",
          "@value": "Anthropic method in which the model critiques and revises its own answers by following a written list of principles, reducing reliance on human labels for safety."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2212.08073"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#generative-ai",
      "termCode": "generative-ai",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "IA generativa"
        },
        {
          "@language": "en",
          "@value": "Generative AI"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelos que criam conteúdo novo, como texto, imagem, áudio, vídeo ou código, a partir de um pedido."
        },
        {
          "@language": "en",
          "@value": "Models that create new content, such as text, images, audio, video or code, from a request."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#schema-id",
      "termCode": "schema-id",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Identificador @id"
        },
        {
          "@language": "en",
          "@value": "@id (Node Identifier)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Propriedade do JSON-LD que dá a cada entidade um identificador único, para ligar nós (Organization, Person, WebSite) entre páginas e formar um grafo."
        },
        {
          "@language": "en",
          "@value": "JSON-LD property giving each entity a unique identifier, linking nodes (Organization, Person, WebSite) across pages into a graph."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#place-id",
      "termCode": "place-id",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Identificador da ficha no Google"
        },
        {
          "@language": "en",
          "@value": "Place ID / CID"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Código único que o Google atribui a cada lugar no Maps (Place ID na API, CID na URL da ficha). Serve para ligar o site, o schema e os relatórios à ficha certa, sem confusão com homônimos."
        },
        {
          "@language": "en",
          "@value": "Unique code Google assigns to each place on Maps (Place ID in the API, CID in the listing URL). It links the site, schema and reports to the right listing, without confusion with namesakes."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/maps/documentation/places/web-service/place-id"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#imperativo-de-formato",
      "termCode": "imperativo-de-formato",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Imperativo de Formato"
        },
        {
          "@language": "en",
          "@value": "Format Imperative"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Hipótese de Raphael Sousa Pereira de que modelos de linguagem aprendem, no ajuste por feedback humano, uma pressão de conformidade de gênero que os leva a inserir marcadores de autoridade (formato acadêmico, citações) sem recuperação factual proporcional."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's hypothesis that language models learn, during human-feedback tuning, a genre-conformity pressure that leads them to insert authority markers (academic format, citations) without proportional factual retrieval."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/engenharia-de-prompt-em-geo/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#generative-impression",
      "termCode": "generative-impression",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Impressão generativa"
        },
        {
          "@language": "en",
          "@value": "Generative Impression"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Exibição de uma página ou marca dentro de uma resposta gerada por IA, com ou sem clique. No Search Console, aparições nos recursos de IA do Google entram no total de impressões da busca, sem relatório separado."
        },
        {
          "@language": "en",
          "@value": "Display of a page or brand inside an AI-generated answer, with or without a click. In Search Console, appearances in Google's AI features count in overall search impressions, with no separate report."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#impressions",
      "termCode": "impressions",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Impressões"
        },
        {
          "@language": "en",
          "@value": "Impressions"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quantas vezes uma página apareceu nos resultados para alguém, mesmo sem clique."
        },
        {
          "@language": "en",
          "@value": "How many times a page appeared in someone's results, even without a click."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#quotation-addition",
      "termCode": "quotation-addition",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Inclusão de citações"
        },
        {
          "@language": "en",
          "@value": "Quotation Addition"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Acrescentar citações atribuídas a especialistas ou fontes. Também apareceu entre os métodos eficazes no estudo original de GEO."
        },
        {
          "@language": "en",
          "@value": "Adding quotes attributed to experts or sources. It also appeared among the effective methods in the original GEO study."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2311.09735"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#statistics-addition",
      "termCode": "statistics-addition",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Inclusão de estatísticas"
        },
        {
          "@language": "en",
          "@value": "Statistics Addition"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Acrescentar dados quantitativos com fonte ao texto. No estudo original de GEO, estava entre os métodos que mais aumentaram a visibilidade nas respostas."
        },
        {
          "@language": "en",
          "@value": "Adding sourced quantitative data to text. In the original GEO study it was among the methods that most increased visibility in answers."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2311.09735"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#answer-inclusion",
      "termCode": "answer-inclusion",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Inclusão na resposta"
        },
        {
          "@language": "en",
          "@value": "Answer Inclusion"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando o conteúdo da página é usado para compor a resposta, mesmo que a página não seja citada explicitamente."
        },
        {
          "@language": "en",
          "@value": "When a page's content is used to build the answer, even if the page is not explicitly cited."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#indexing",
      "termCode": "indexing",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Indexação"
        },
        {
          "@language": "en",
          "@value": "Indexing"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Etapa em que o buscador processa a página rastreada, entende o conteúdo e a guarda no índice, de onde ela pode ser recuperada para uma consulta."
        },
        {
          "@language": "en",
          "@value": "Step in which the search engine processes a crawled page, understands its content and stores it in the index, from which it can be retrieved for a query."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/fundamentals/how-search-works"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#mobile-first-indexing",
      "termCode": "mobile-first-indexing",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Indexação mobile-first"
        },
        {
          "@language": "en",
          "@value": "Mobile-first Indexing"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "O Google usa a versão para celular da página para indexar e classificar. Conteúdo que falta no celular conta como ausente."
        },
        {
          "@language": "en",
          "@value": "Google uses the mobile version of a page for indexing and ranking. Content missing on mobile counts as absent."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/mobile/mobile-sites-mobile-first-indexing"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#indexnow",
      "termCode": "indexnow",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "IndexNow"
        },
        {
          "@language": "en",
          "@value": "IndexNow"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo aberto para o site avisar buscadores participantes, como Bing e Yandex, que uma URL foi criada, alterada ou removida. O Google não participa."
        },
        {
          "@language": "en",
          "@value": "Open protocol for a site to notify participating search engines, such as Bing and Yandex, that a URL was created, changed or removed. Google does not participate."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.indexnow.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#inference",
      "termCode": "inference",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Inferência"
        },
        {
          "@language": "en",
          "@value": "Inference"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Uso do modelo já treinado para gerar uma resposta. É o custo pago a cada pergunta."
        },
        {
          "@language": "en",
          "@value": "Using an already trained model to generate an answer. It is the cost paid for every question."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#prompt-injection",
      "termCode": "prompt-injection",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Injeção de prompt"
        },
        {
          "@language": "en",
          "@value": "Prompt Injection"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ataque em que um texto, inclusive escondido numa página ou documento, traz instruções que fazem o modelo desobedecer às regras originais. É o principal risco da lista OWASP para aplicações com LLM."
        },
        {
          "@language": "en",
          "@value": "Attack in which text, including text hidden in a page or document, carries instructions that make the model disobey its original rules. It tops the OWASP list of risks for LLM applications."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://genai.owasp.org/llm-top-10/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#artificial-intelligence",
      "termCode": "artificial-intelligence",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Inteligência artificial (IA)"
        },
        {
          "@language": "en",
          "@value": "Artificial Intelligence (AI)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Área da computação que cria sistemas capazes de realizar tarefas associadas à inteligência humana, como entender linguagem, reconhecer imagens, prever e decidir."
        },
        {
          "@language": "en",
          "@value": "Field of computing that builds systems able to perform tasks associated with human intelligence, such as understanding language, recognizing images, predicting and deciding."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#search-intent",
      "termCode": "search-intent",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Intenção de busca"
        },
        {
          "@language": "en",
          "@value": "Search Intent"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "O objetivo por trás de uma consulta: informar-se, navegar até um site, comparar opções ou comprar. Páginas que atendem a intenção dominante tendem a se posicionar melhor."
        },
        {
          "@language": "en",
          "@value": "The goal behind a query: to learn, to reach a site, to compare options or to buy. Pages that match the dominant intent tend to rank better."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#inp",
      "termCode": "inp",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Interação até a próxima renderização"
        },
        {
          "@language": "en",
          "@value": "Interaction to Next Paint (INP)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tempo que a página leva para responder visualmente às interações do usuário ao longo da visita. Substituiu o FID em março de 2024. Bom: até 200 ms."
        },
        {
          "@language": "en",
          "@value": "Time the page takes to respond visually to user interactions throughout the visit. It replaced FID in March 2024. Good: 200 ms or less."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://web.dev/articles/inp"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#late-interaction",
      "termCode": "late-interaction",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Interação tardia"
        },
        {
          "@language": "en",
          "@value": "Late Interaction (ColBERT)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Método de recuperação que compara a pergunta e o documento token a token, mais preciso que um único vetor por documento."
        },
        {
          "@language": "en",
          "@value": "Retrieval method that compares the question and the document token by token, more accurate than a single vector per document."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2004.12832"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#api",
      "termCode": "api",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Interface de programação de aplicações"
        },
        {
          "@language": "en",
          "@value": "Application Programming Interface (API)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Forma padronizada de um programa usar outro. As empresas de IA vendem acesso a modelos por API, cobrando por token."
        },
        {
          "@language": "en",
          "@value": "Standard way for one program to use another. AI companies sell model access through APIs, charging per token."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#confidence-interval",
      "termCode": "confidence-interval",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Intervalo de confiança"
        },
        {
          "@language": "en",
          "@value": "Confidence Interval"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Faixa de valores em que a medida verdadeira provavelmente está, dada a variação das respostas. Uma taxa de 40% com intervalo de 25% a 55% diz muito menos do que parece."
        },
        {
          "@language": "en",
          "@value": "Range of values in which the true measure probably lies, given the variation in answers. A 40% rate with an interval of 25% to 55% says much less than it seems."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#jailbreak",
      "termCode": "jailbreak",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Jailbreak"
        },
        {
          "@language": "en",
          "@value": "Jailbreak"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Técnica de prompt para fazer o modelo ignorar suas regras de segurança."
        },
        {
          "@language": "en",
          "@value": "Prompting technique to make a model ignore its safety rules."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#context-window",
      "termCode": "context-window",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Janela de contexto"
        },
        {
          "@language": "en",
          "@value": "Context Window"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quantidade máxima de tokens que o modelo considera de uma vez, somando instruções, documentos, conversa e resposta."
        },
        {
          "@language": "en",
          "@value": "Maximum number of tokens the model considers at once, counting instructions, documents, conversation and answer."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#json-ld",
      "termCode": "json-ld",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "JSON-LD"
        },
        {
          "@language": "en",
          "@value": "JSON-LD"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Formato de dados ligados em JSON, recomendado pelo Google para dados estruturados. Fica num bloco <script> separado do HTML visível."
        },
        {
          "@language": "en",
          "@value": "JSON-based linked-data format recommended by Google for structured data. It lives in a <script> block separate from the visible HTML."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.w3.org/TR/json-ld11/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#latency",
      "termCode": "latency",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Latência"
        },
        {
          "@language": "en",
          "@value": "Latency"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tempo até o modelo começar ou terminar de responder. Afeta a experiência e o custo de agentes que fazem muitas chamadas."
        },
        {
          "@language": "en",
          "@value": "Time until the model starts or finishes answering. It affects the experience and the cost of agents making many calls."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#machine-readability",
      "termCode": "machine-readability",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Legibilidade por máquina"
        },
        {
          "@language": "en",
          "@value": "Machine Readability"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "O quanto o conteúdo pode ser lido sem esforço por robôs: HTML no servidor, estrutura semântica, dados estruturados e ausência de bloqueios por JavaScript, login ou CAPTCHA."
        },
        {
          "@language": "en",
          "@value": "How easily bots can read content: server-rendered HTML, semantic structure, structured data and no blocking by JavaScript, login or CAPTCHA."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#lei-da-coerencia-distribuida",
      "termCode": "lei-da-coerencia-distribuida",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Lei da Coerência Distribuída"
        },
        {
          "@language": "en",
          "@value": "Law of Distributed Coherence"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Axioma 1 da Física Semântica: a força semântica de uma entidade é proporcional ao número de fontes independentes que confirmam a mesma identidade central, ponderado pela autoridade de cada fonte. Mil posts no próprio perfil valem menos que poucas confirmações independentes."
        },
        {
          "@language": "en",
          "@value": "Axiom 1 of Semantic Physics: an entity's semantic strength is proportional to the number of independent sources confirming the same core identity, weighted by each source's authority. A thousand posts on one's own profile are worth less than a few independent confirmations."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/fisica-semantica-raphael-sousa-pereira/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entropia-semantica",
      "termCode": "entropia-semantica",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Lei da Entropia Semântica"
        },
        {
          "@language": "en",
          "@value": "Semantic Entropy (Law of)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Axioma 3 da Física Semântica: sem trabalho ativo, o estado semântico de uma entidade tende ao desalinhamento, à inconsistência e à dispersão, por mudanças de plataforma, avanço de concorrentes e evolução do próprio negócio sem atualizar as fontes."
        },
        {
          "@language": "en",
          "@value": "Axiom 3 of Semantic Physics: without active work, an entity's semantic state tends toward misalignment, inconsistency and dispersion, through platform changes, competitors' gains and the business evolving without updating its sources."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/fisica-semantica-raphael-sousa-pereira/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#eu-ai-act",
      "termCode": "eu-ai-act",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Lei de IA da União Europeia"
        },
        {
          "@language": "en",
          "@value": "EU AI Act"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Regulamento europeu de 2024 que classifica sistemas de IA por nível de risco e impõe obrigações, como transparência para conteúdo gerado por IA."
        },
        {
          "@language": "en",
          "@value": "2024 European regulation that classifies AI systems by risk level and imposes obligations, such as transparency for AI-generated content."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#scaling-laws",
      "termCode": "scaling-laws",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Leis de escala"
        },
        {
          "@language": "en",
          "@value": "Scaling Laws"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Relações empíricas mostrando que o desempenho dos modelos melhora de forma previsível com mais parâmetros, dados e computação."
        },
        {
          "@language": "en",
          "@value": "Empirical relationships showing model performance improves predictably with more parameters, data and compute."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2001.08361"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#lgpd-ai",
      "termCode": "lgpd-ai",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "LGPD e IA"
        },
        {
          "@language": "en",
          "@value": "LGPD and AI"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Aplicação da Lei Geral de Proteção de Dados (Lei 13.709/2018) ao uso de IA no Brasil: base legal para tratar dados pessoais, transparência e direito de revisão de decisões automatizadas."
        },
        {
          "@language": "en",
          "@value": "Application of Brazil's General Data Protection Law (Law 13,709/2018) to AI: a legal basis for processing personal data, transparency and the right to review automated decisions."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#limiar-de-confianca",
      "termCode": "limiar-de-confianca",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Limiar de confiança (Θ)"
        },
        {
          "@language": "en",
          "@value": "Trust Threshold (Θ)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Axioma 2 da Física Semântica: há um limiar de coerência semântica, específico por setor, local e tipo de entidade, abaixo do qual a chance de citação pela IA é quase nula e acima do qual a entidade entra no círculo de recomendação. A mudança é de estado, não gradual."
        },
        {
          "@language": "en",
          "@value": "Axiom 2 of Semantic Physics: there is a semantic-coherence threshold, specific to sector, location and entity type, below which the chance of AI citation is near zero and above which the entity enters the recommendation circle. The change is a state change, not gradual."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/fisica-semantica-raphael-sousa-pereira/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#internal-linking",
      "termCode": "internal-linking",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Linkagem interna"
        },
        {
          "@language": "en",
          "@value": "Internal Linking"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Links entre páginas do mesmo site. Distribuem autoridade, mostram a hierarquia e ajudam robôs a descobrir conteúdo."
        },
        {
          "@language": "en",
          "@value": "Links between pages on the same site. They spread authority, show hierarchy and help bots discover content."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-ranking-list",
      "termCode": "ai-ranking-list",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Lista de \"melhores\""
        },
        {
          "@language": "en",
          "@value": "Listicle (Best-of List)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página do tipo \"as 10 melhores empresas de X\". Está entre os formatos mais citados por IAs em perguntas de recomendação, o que atrai abuso por listas autopromocionais."
        },
        {
          "@language": "en",
          "@value": "Page of the \"top 10 companies for X\" kind. It is among the formats AI cites most for recommendation questions, which invites abuse through self-promotional lists."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-slop",
      "termCode": "ai-slop",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Lixo gerado por IA"
        },
        {
          "@language": "en",
          "@value": "AI Slop"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo produzido por IA em massa, genérico e sem verificação. Polui a web, perde confiança e pode ser enquadrado como abuso de conteúdo em escala."
        },
        {
          "@language": "en",
          "@value": "Mass-produced, generic, unverified AI content. It pollutes the web, loses trust and may count as scaled content abuse."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#llm-as-judge",
      "termCode": "llm-as-judge",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "LLM como avaliador"
        },
        {
          "@language": "en",
          "@value": "LLM-as-a-judge"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Usar um modelo para avaliar respostas de outro segundo critérios definidos. É barato, mas tem vieses e precisa ser calibrado com avaliação humana."
        },
        {
          "@language": "en",
          "@value": "Using one model to grade another's answers against defined criteria. It is cheap but biased and needs calibration against human review."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2306.05685"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#loop-de-feedback-semantico",
      "termCode": "loop-de-feedback-semantico",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Loop de Feedback Semântico"
        },
        {
          "@language": "en",
          "@value": "Semantic Feedback Loop"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conceito de Raphael Sousa Pereira: depois que a entidade cruza o limiar de confiança, mais coerência traz melhor posição, que traz mais engajamento, que traz mais sinais e mais coerência. Abaixo do limiar, o ciclo não existe."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's concept: once the entity crosses the trust threshold, more coherence brings a better position, which brings more engagement, more signals and more coherence. Below the threshold the loop does not exist."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/fisica-semantica-raphael-sousa-pereira/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#lora",
      "termCode": "lora",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "LoRA (adaptação de baixo posto)"
        },
        {
          "@language": "en",
          "@value": "LoRA (Low-Rank Adaptation)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Método de ajuste fino que treina poucas matrizes adicionais em vez de todos os pesos, reduzindo muito o custo."
        },
        {
          "@language": "en",
          "@value": "Fine-tuning method that trains a few additional matrices instead of all weights, greatly cutting cost."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2106.09685"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#lcp",
      "termCode": "lcp",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Maior renderização de conteúdo"
        },
        {
          "@language": "en",
          "@value": "Largest Contentful Paint (LCP)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tempo até o maior elemento visível da tela (imagem ou bloco de texto) aparecer. Bom: até 2,5 segundos."
        },
        {
          "@language": "en",
          "@value": "Time until the largest visible element (image or text block) renders. Good: 2.5 seconds or less."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://web.dev/articles/lcp"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#topical-map",
      "termCode": "topical-map",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Mapa de tópicos"
        },
        {
          "@language": "en",
          "@value": "Topical Map"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Planejamento de todos os temas e subtemas que um site precisa cobrir para ser referência num assunto, com as relações entre eles. Vem antes dos clusters e das páginas pilar."
        },
        {
          "@language": "en",
          "@value": "Plan of every topic and subtopic a site needs to cover to be a reference on a subject, with the relationships between them. It comes before clusters and pillar pages."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#watermarking",
      "termCode": "watermarking",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Marca d'água de IA"
        },
        {
          "@language": "en",
          "@value": "AI Watermarking"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Sinal embutido em conteúdo gerado por IA, visível ou não, que permite identificá-lo depois, como o SynthID do Google."
        },
        {
          "@language": "en",
          "@value": "Signal embedded in AI-generated content, visible or not, that lets it be identified later, such as Google's SynthID."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#markdown-for-agents",
      "termCode": "markdown-for-agents",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Markdown para agentes"
        },
        {
          "@language": "en",
          "@value": "Markdown for Agents"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Prática de oferecer versões em Markdown das páginas (por exemplo, a mesma URL com .md) para que agentes e LLMs leiam o conteúdo sem ruído de layout."
        },
        {
          "@language": "en",
          "@value": "Practice of offering Markdown versions of pages (for example, the same URL with .md) so agents and LLMs read the content without layout noise."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#semantic-mass",
      "termCode": "semantic-mass",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Massa semântica"
        },
        {
          "@language": "en",
          "@value": "Semantic Mass"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conceito de Raphael Sousa Pereira para a densidade total de sinais semânticos consistentes em torno de uma entidade."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's concept for the total density of consistent semantic signals around an entity."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/fisica-semantica-raphael-sousa-pereira/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#matriz-cm",
      "termCode": "matriz-cm",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Matriz CM"
        },
        {
          "@language": "en",
          "@value": "CM Matrix (Complexity × Maturity)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Framework de Raphael Sousa Pereira, declarado por ele como hipótese sem validação empírica externa, que classifica uma entidade em dois eixos, Complexidade (C1 a C4) e Maturidade Digital (M1 a M5), para estimar o esforço e o prazo necessários para torná-la citável por IA."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's framework, stated by him as a hypothesis without external empirical validation, that classifies an entity on two axes, Complexity (C1 to C4) and Digital Maturity (M1 to M5), to estimate the effort and time needed to make it citable by AI."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/quem-e-raphael-sousa-pereira-estrategista-de-citacao-de-entidade/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#g-cim",
      "termCode": "g-cim",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Matriz de Inteligência Competitiva Generativa (G-CIM)"
        },
        {
          "@language": "en",
          "@value": "Generative Competitive Intelligence Matrix (G-CIM)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Matriz de decisão ponderada (peso × valor) criada por Raphael Sousa Pereira para transformar auditorias de SEO e GEO em priorização de investimento, adaptando a Matriz do Processo Decisório de Siqueira e Gomi (1999, IPT/USP)."
        },
        {
          "@language": "en",
          "@value": "Weighted decision matrix (weight × value) created by Raphael Sousa Pereira to turn SEO and GEO audits into investment prioritization, adapting the Decision Process Matrix of Siqueira and Gomi (1999, IPT/USP)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://raphaelsousapereira.com.br/generative-competitive-intelligence-matrix/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#attention-mechanism",
      "termCode": "attention-mechanism",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Mecanismo de atenção"
        },
        {
          "@language": "en",
          "@value": "Attention Mechanism"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Parte do modelo que pesa quanto cada palavra do contexto importa para interpretar ou gerar cada outra palavra."
        },
        {
          "@language": "en",
          "@value": "Part of the model that weighs how much each word in the context matters for interpreting or generating every other word."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/1706.03762"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#agent-memory",
      "termCode": "agent-memory",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Memória do agente"
        },
        {
          "@language": "en",
          "@value": "Agent Memory"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Informações que um agente guarda entre etapas ou conversas, como preferências do usuário e resultados anteriores."
        },
        {
          "@language": "en",
          "@value": "Information an agent keeps across steps or conversations, such as user preferences and earlier results."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-mention",
      "termCode": "ai-mention",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Menção por IA"
        },
        {
          "@language": "en",
          "@value": "AI Mention"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando a marca aparece no texto da resposta de IA, com ou sem link para o site."
        },
        {
          "@language": "en",
          "@value": "When the brand appears in the AI answer text, with or without a link to the site."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#brand-mention",
      "termCode": "brand-mention",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Menção à marca"
        },
        {
          "@language": "en",
          "@value": "Brand Mention"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Citação do nome da marca em outro site, com ou sem link. Para IAs, menções em fontes confiáveis pesam tanto quanto links."
        },
        {
          "@language": "en",
          "@value": "Mention of the brand name on another site, with or without a link. For AI, mentions on trusted sources weigh as much as links."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#meta-description",
      "termCode": "meta-description",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Meta descrição"
        },
        {
          "@language": "en",
          "@value": "Meta Description"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Resumo da página em uma meta tag, que o buscador pode usar como trecho nos resultados. Não é fator de ranqueamento direto, mas afeta o clique."
        },
        {
          "@language": "en",
          "@value": "Page summary in a meta tag that the search engine may use as the result snippet. It is not a direct ranking factor, but it affects clicks."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/snippet"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#meta-robots",
      "termCode": "meta-robots",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Meta tag robots"
        },
        {
          "@language": "en",
          "@value": "Meta Robots Tag"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Meta tag no HTML que dá instruções de indexação e exibição por página, como noindex, nofollow, nosnippet e max-snippet."
        },
        {
          "@language": "en",
          "@value": "HTML meta tag giving per-page indexing and display instructions, such as noindex, nofollow, nosnippet and max-snippet."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/robots-meta-tag"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#mixture-of-experts",
      "termCode": "mixture-of-experts",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Mistura de especialistas"
        },
        {
          "@language": "en",
          "@value": "Mixture of Experts (MoE)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Arquitetura em que só parte dos parâmetros (os \"especialistas\" escolhidos) é usada para cada token, o que permite modelos grandes com custo de execução menor."
        },
        {
          "@language": "en",
          "@value": "Architecture in which only part of the parameters (the chosen \"experts\") is used for each token, allowing large models with lower running cost."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/1701.06538"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#diffusion-model",
      "termCode": "diffusion-model",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de difusão"
        },
        {
          "@language": "en",
          "@value": "Diffusion Model"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tipo de modelo generativo que cria imagens ou vídeos removendo ruído passo a passo, usado em ferramentas de geração de imagem."
        },
        {
          "@language": "en",
          "@value": "Type of generative model that creates images or video by removing noise step by step, used in image generation tools."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#foundation-model",
      "termCode": "foundation-model",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de fundação"
        },
        {
          "@language": "en",
          "@value": "Foundation Model"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo grande treinado em dados amplos que serve de base para muitas tarefas, adaptado por instruções, ajuste fino ou ferramentas."
        },
        {
          "@language": "en",
          "@value": "Large model trained on broad data that serves as the basis for many tasks, adapted through instructions, fine-tuning or tools."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#slm",
      "termCode": "slm",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de linguagem pequeno"
        },
        {
          "@language": "en",
          "@value": "Small Language Model (SLM)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo com menos parâmetros, mais barato e rápido, capaz de rodar no celular ou no computador, útil para tarefas específicas."
        },
        {
          "@language": "en",
          "@value": "Model with fewer parameters, cheaper and faster, able to run on a phone or laptop, useful for specific tasks."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#open-weight-model",
      "termCode": "open-weight-model",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de pesos abertos"
        },
        {
          "@language": "en",
          "@value": "Open-weight Model"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo cujos pesos podem ser baixados e rodados por qualquer um, como Llama, Mistral e Qwen. Não significa que os dados de treino sejam abertos."
        },
        {
          "@language": "en",
          "@value": "Model whose weights anyone can download and run, such as Llama, Mistral and Qwen. It does not mean the training data is open."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#prompt-template",
      "termCode": "prompt-template",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de prompt"
        },
        {
          "@language": "en",
          "@value": "Prompt Template"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Prompt com partes fixas e campos variáveis, reutilizado em escala com dados diferentes."
        },
        {
          "@language": "en",
          "@value": "Prompt with fixed parts and variable fields, reused at scale with different data."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#reasoning-model",
      "termCode": "reasoning-model",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de raciocínio"
        },
        {
          "@language": "en",
          "@value": "Reasoning Model"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "LLM treinado para \"pensar\" em etapas antes de responder, gastando mais tokens e tempo em troca de melhor desempenho em problemas difíceis."
        },
        {
          "@language": "en",
          "@value": "LLM trained to \"think\" in steps before answering, spending more tokens and time in exchange for better performance on hard problems."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#vision-language-model",
      "termCode": "vision-language-model",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de visão e linguagem"
        },
        {
          "@language": "en",
          "@value": "Vision-language Model (VLM)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo que lê imagens e texto juntos, capaz de descrever fotos, ler capturas de tela e interpretar gráficos."
        },
        {
          "@language": "en",
          "@value": "Model that reads images and text together, able to describe photos, read screenshots and interpret charts."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#multimodal-model",
      "termCode": "multimodal-model",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo multimodal"
        },
        {
          "@language": "en",
          "@value": "Multimodal Model"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo que entende ou gera mais de um tipo de dado, como texto, imagem, áudio e vídeo."
        },
        {
          "@language": "en",
          "@value": "Model that understands or generates more than one data type, such as text, images, audio and video."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#backlink-to-geo-operating-model",
      "termCode": "backlink-to-geo-operating-model",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo operacional Backlink-to-GEO"
        },
        {
          "@language": "en",
          "@value": "Backlink-to-GEO Operating Model"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de Raphael Sousa Pereira que liga aquisição de backlinks, relevância contextual, entidade, claims verificáveis e monitoramento de presença generativa. Um backlink só entra na camada GEO depois de contextualizado: quem citou, sobre qual tema e apontando para qual página."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's model linking backlink acquisition, contextual relevance, entity, verifiable claims and generative-presence monitoring. A backlink only enters the GEO layer once contextualized: who cited, on what topic and pointing to which page."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/como-usar-backlinks-em-sua-estrategia-de-seo-e-geo-guia-2026/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-mode",
      "termCode": "ai-mode",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modo IA"
        },
        {
          "@language": "en",
          "@value": "AI Mode"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modo de busca conversacional do Google, em aba própria, que decompõe a pergunta em várias buscas (query fan-out) e responde com fontes."
        },
        {
          "@language": "en",
          "@value": "Google's conversational search mode, in its own tab, that breaks the question into several searches (query fan-out) and answers with sources."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/ai-features"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#rank-tracking",
      "termCode": "rank-tracking",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Monitoramento de posições"
        },
        {
          "@language": "en",
          "@value": "Rank Tracking"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Acompanhamento periódico das posições do site para um conjunto de consultas, por local e dispositivo."
        },
        {
          "@language": "en",
          "@value": "Periodic tracking of a site's positions for a set of queries, by location and device."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#answer-engine",
      "termCode": "answer-engine",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Motor de resposta"
        },
        {
          "@language": "en",
          "@value": "Answer Engine"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Sistema que devolve a resposta em vez de uma lista de documentos, como Perplexity, assistentes de voz e chatbots com busca."
        },
        {
          "@language": "en",
          "@value": "System that returns the answer instead of a list of documents, such as Perplexity, voice assistants and chatbots with search."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#generative-engine",
      "termCode": "generative-engine",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Motor generativo"
        },
        {
          "@language": "en",
          "@value": "Generative Engine"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Sistema que responde a uma pergunta com texto gerado por um modelo de linguagem, em geral com base em documentos recuperados da web ou de um índice."
        },
        {
          "@language": "en",
          "@value": "System that answers a question with text generated by a language model, usually grounded in documents retrieved from the web or an index."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2311.09735"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#comparable-change",
      "termCode": "comparable-change",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Mudança comparável"
        },
        {
          "@language": "en",
          "@value": "Comparable Change"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Diferença entre duas medições feitas com o mesmo conjunto de perguntas, plataformas, método e denominador. Só ela pode ser tratada como evolução real."
        },
        {
          "@language": "en",
          "@value": "Difference between two measurements made with the same question set, platforms, method and denominator. Only this kind can be treated as real progress."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cls",
      "termCode": "cls",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Mudança cumulativa de layout"
        },
        {
          "@language": "en",
          "@value": "Cumulative Layout Shift (CLS)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Mede quanto o conteúdo pula de lugar durante o carregamento. Bom: até 0,1."
        },
        {
          "@language": "en",
          "@value": "Measures how much content jumps around while loading. Good: 0.1 or less."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://web.dev/articles/cls"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#vanity-metrics",
      "termCode": "vanity-metrics",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Métricas de vaidade"
        },
        {
          "@language": "en",
          "@value": "Vanity Metrics"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Números que parecem bons, como impressões, seguidores e posição de uma palavra, mas não se ligam a resultado de negócio."
        },
        {
          "@language": "en",
          "@value": "Numbers that look good, such as impressions, followers and a keyword's position, but are not tied to business results."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#agentic-browser",
      "termCode": "agentic-browser",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Navegador agêntico"
        },
        {
          "@language": "en",
          "@value": "Agentic Browser"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Navegador ou modo de assistente que navega, clica e preenche páginas sozinho para cumprir uma tarefa, como os modos agente do ChatGPT e do Gemini."
        },
        {
          "@language": "en",
          "@value": "Browser or assistant mode that browses, clicks and fills in pages on its own to complete a task, such as the agent modes of ChatGPT and Gemini."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#faceted-navigation",
      "termCode": "faceted-navigation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Navegação facetada"
        },
        {
          "@language": "en",
          "@value": "Faceted Navigation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Filtros de listagem (cor, tamanho, preço) que geram muitas combinações de URL e podem consumir o rastreamento com páginas quase iguais."
        },
        {
          "@language": "en",
          "@value": "Listing filters (color, size, price) that create many URL combinations and can waste crawling on near-identical pages."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/crawling-managing-faceted-navigation"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#b2a",
      "termCode": "b2a",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Negócio para agente"
        },
        {
          "@language": "en",
          "@value": "Business-to-Agent (B2A)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo em que a empresa projeta produtos, dados e atendimento para serem consumidos por agentes de IA, não só por pessoas."
        },
        {
          "@language": "en",
          "@value": "Model in which a company designs products, data and service to be consumed by AI agents, not only people."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#nap",
      "termCode": "nap",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Nome, endereço e telefone"
        },
        {
          "@language": "en",
          "@value": "NAP (Name, Address, Phone)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Dados de contato da empresa. Devem ser idênticos no site, no Perfil da Empresa, em diretórios e no schema, para que buscadores e IAs reconheçam a mesma entidade."
        },
        {
          "@language": "en",
          "@value": "Business contact details. They must be identical on the site, the Business Profile, directories and schema so search engines and AI recognize the same entity."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#notability",
      "termCode": "notability",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Notoriedade"
        },
        {
          "@language": "en",
          "@value": "Notability"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Critério da Wikipédia para um tema ter verbete: cobertura significativa em fontes confiáveis e independentes. Empresas e pessoas sem essa cobertura não devem forçar verbete, e o Wikidata não aceita uso promocional."
        },
        {
          "@language": "en",
          "@value": "Wikipedia's criterion for a topic to have an article: significant coverage in reliable, independent sources. Companies and people without such coverage should not force an article, and Wikidata does not accept promotional use."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://pt.wikipedia.org/wiki/Wikip%C3%A9dia:Notoriedade"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ontology",
      "termCode": "ontology",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Ontologia"
        },
        {
          "@language": "en",
          "@value": "Ontology"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Definição formal dos tipos de coisa de um domínio, das propriedades e das relações permitidas entre eles. O Schema.org funciona como uma ontologia leve para a web."
        },
        {
          "@language": "en",
          "@value": "Formal definition of a domain's kinds of things, their properties and the relationships allowed between them. Schema.org works as a lightweight ontology for the web."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.w3.org/TR/owl2-overview/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#self-reported-attribution",
      "termCode": "self-reported-attribution",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Origem declarada"
        },
        {
          "@language": "en",
          "@value": "Self-reported Attribution"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Pergunta \"como nos conheceu?\" no formulário ou no atendimento. Capta indicações de IA que a análise de tráfego não vê, com o limite da memória de quem responde."
        },
        {
          "@language": "en",
          "@value": "The \"how did you hear about us?\" question on a form or in service. It captures AI referrals that traffic analytics misses, limited by the respondent's memory."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#orchestration",
      "termCode": "orchestration",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Orquestração"
        },
        {
          "@language": "en",
          "@value": "Orchestration"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Camada que coordena modelos, ferramentas e etapas de um fluxo de IA, decidindo o que roda, em que ordem e com quais dados."
        },
        {
          "@language": "en",
          "@value": "Layer that coordinates models, tools and steps in an AI workflow, deciding what runs, in what order and with what data."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#crawl-budget",
      "termCode": "crawl-budget",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Orçamento de rastreamento"
        },
        {
          "@language": "en",
          "@value": "Crawl Budget"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quantidade de URLs que o robô se dispõe a rastrear num site em um período, limitada pela capacidade do servidor e pelo interesse do buscador. Importa sobretudo em sites grandes."
        },
        {
          "@language": "en",
          "@value": "Number of URLs a bot is willing to crawl on a site in a period, limited by server capacity and the search engine's demand. It matters mostly for large sites."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/large-site-managing-crawl-budget"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#macrodominios-de-geo",
      "termCode": "macrodominios-de-geo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Os 6 Macrodomínios de GEO"
        },
        {
          "@language": "en",
          "@value": "Six GEO Macrodomains"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Proposta taxonômica de Raphael Sousa Pereira que agrupa o GEO em seis macrodomínios de pesquisa, técnica, operação e valor econômico. O autor a apresenta como proposta, não como classificação acadêmica consolidada."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's taxonomic proposal grouping GEO into six macrodomains spanning research, technique, operations and economic value. The author presents it as a proposal, not an established academic classification."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://raphaelsousapereira.com.br/os-6-macrodominios-de-geo-uma-macroarquitetura-para-pesquisa-tecnica-operacao-e-valor-economico-geo-ia/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#sxo",
      "termCode": "sxo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização da experiência de busca"
        },
        {
          "@language": "en",
          "@value": "Search Experience Optimization (SXO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Junção de SEO e experiência do usuário: otimizar não só a posição, mas o clique, a continuidade entre a busca e a página e a conversão."
        },
        {
          "@language": "en",
          "@value": "Combination of SEO and user experience: optimizing not only position but the click, the continuity between search and page, and conversion."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cro",
      "termCode": "cro",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização da taxa de conversão"
        },
        {
          "@language": "en",
          "@value": "Conversion Rate Optimization (CRO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Melhoria da página para que mais visitantes realizem a ação desejada, com testes e análise de comportamento."
        },
        {
          "@language": "en",
          "@value": "Improving a page so more visitors complete the desired action, using tests and behavior analysis."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#chunk-optimization",
      "termCode": "chunk-optimization",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização de trechos"
        },
        {
          "@language": "en",
          "@value": "Chunk Optimization"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Escrever cada seção para funcionar sozinha quando for recortada em pedaços pelo sistema de recuperação: assunto explícito, sem pronomes soltos e com a resposta no início."
        },
        {
          "@language": "en",
          "@value": "Writing each section to work on its own when the retrieval system cuts it into pieces: explicit subject, no dangling pronouns and the answer first."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#dpo",
      "termCode": "dpo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização direta de preferências"
        },
        {
          "@language": "en",
          "@value": "Direct Preference Optimization (DPO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Alternativa mais simples ao RLHF que treina o modelo direto nas comparações de preferência, sem modelo de recompensa separado."
        },
        {
          "@language": "en",
          "@value": "Simpler alternative to RLHF that trains the model directly on preference comparisons, without a separate reward model."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2305.18290"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#search-everywhere-optimization",
      "termCode": "search-everywhere-optimization",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização para busca em todo lugar"
        },
        {
          "@language": "en",
          "@value": "Search Everywhere Optimization"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Leitura ampliada da sigla SEO usada no mercado: otimizar a presença da marca em todos os lugares onde as pessoas buscam, como Google, YouTube, TikTok, marketplaces, mapas e assistentes de IA, e não só no buscador tradicional."
        },
        {
          "@language": "en",
          "@value": "Broadened reading of the SEO acronym used in the market: optimizing a brand's presence everywhere people search, such as Google, YouTube, TikTok, marketplaces, maps and AI assistants, not only the traditional search engine."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#llmo",
      "termCode": "llmo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização para LLMs"
        },
        {
          "@language": "en",
          "@value": "LLM Optimization (LLMO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Outro nome usado no mercado para GEO, com foco em como os modelos de linguagem representam e citam a marca."
        },
        {
          "@language": "en",
          "@value": "Another market name for GEO, focused on how language models represent and cite the brand."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#seo",
      "termCode": "seo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização para mecanismos de busca"
        },
        {
          "@language": "en",
          "@value": "Search Engine Optimization (SEO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conjunto de práticas técnicas, editoriais e de autoridade que aumentam a chance de uma página ser rastreada, indexada e bem posicionada nos resultados orgânicos de buscadores."
        },
        {
          "@language": "en",
          "@value": "Set of technical, editorial and authority practices that increase the chance of a page being crawled, indexed and ranked well in a search engine's organic results."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/fundamentals/seo-starter-guide"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#aeo",
      "termCode": "aeo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização para motores de resposta"
        },
        {
          "@language": "en",
          "@value": "Answer Engine Optimization (AEO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Otimização para que o conteúdo seja escolhido como resposta direta, em trechos em destaque, assistentes de voz e respostas de IA. Muitas vezes usado como sinônimo parcial de GEO."
        },
        {
          "@language": "en",
          "@value": "Optimization so content is chosen as the direct answer in featured snippets, voice assistants and AI answers. Often used as a partial synonym of GEO."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#geo",
      "termCode": "geo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização para motores generativos"
        },
        {
          "@language": "en",
          "@value": "Generative Engine Optimization (GEO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Disciplina que aumenta a chance de uma marca, página ou fato ser encontrado, usado e citado corretamente por sistemas de IA generativa, como ChatGPT, Gemini, Perplexity, Copilot e os resumos de IA do Google. O termo vem do artigo de Aggarwal e colegas (2023)."
        },
        {
          "@language": "en",
          "@value": "Discipline that increases the chance of a brand, page or fact being found, used and correctly cited by generative AI systems such as ChatGPT, Gemini, Perplexity, Copilot and Google's AI summaries. The term comes from the paper by Aggarwal et al. (2023)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2311.09735"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#local-pack",
      "termCode": "local-pack",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Pacote local"
        },
        {
          "@language": "en",
          "@value": "Local Pack (Map Pack)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Bloco com mapa e três empresas que aparece no topo de buscas com intenção local."
        },
        {
          "@language": "en",
          "@value": "Block with a map and three businesses shown at the top of searches with local intent."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#pagerank",
      "termCode": "pagerank",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "PageRank"
        },
        {
          "@language": "en",
          "@value": "PageRank"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Algoritmo original do Google que mede a importância de uma página pelos links que ela recebe, ponderados pela importância de quem linka. Segue em uso, com muitas variações."
        },
        {
          "@language": "en",
          "@value": "Google's original algorithm measuring a page's importance by the links it receives, weighted by the importance of the linking pages. Still used, with many variations."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://research.google/pubs/the-anatomy-of-a-large-scale-hypertextual-web-search-engine/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#pagination",
      "termCode": "pagination",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Paginação"
        },
        {
          "@language": "en",
          "@value": "Pagination"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Divisão de uma lista longa em várias páginas. Cada página deve ter URL própria e rastreável e links para as outras."
        },
        {
          "@language": "en",
          "@value": "Splitting a long list across several pages. Each page needs its own crawlable URL and links to the others."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#knowledge-panel",
      "termCode": "knowledge-panel",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Painel de conhecimento"
        },
        {
          "@language": "en",
          "@value": "Knowledge Panel"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quadro com fatos sobre uma entidade (pessoa, empresa, lugar), alimentado pelo Knowledge Graph do Google."
        },
        {
          "@language": "en",
          "@value": "Box with facts about an entity (person, company, place), fed by Google's Knowledge Graph."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#keyword",
      "termCode": "keyword",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Palavra-chave"
        },
        {
          "@language": "en",
          "@value": "Keyword"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Termo ou expressão que as pessoas digitam no buscador e que uma página pretende atender."
        },
        {
          "@language": "en",
          "@value": "Word or phrase people type into a search engine and that a page aims to serve."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#long-tail-keyword",
      "termCode": "long-tail-keyword",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Palavra-chave de cauda longa"
        },
        {
          "@language": "en",
          "@value": "Long-tail Keyword"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Consulta mais específica e longa, com volume menor, concorrência menor e intenção geralmente mais clara."
        },
        {
          "@language": "en",
          "@value": "Longer, more specific query with lower volume, lower competition and usually clearer intent."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#share-of-voice",
      "termCode": "share-of-voice",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Participação de voz em IA"
        },
        {
          "@language": "en",
          "@value": "Share of Voice (AI)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Proporção das respostas de IA, num conjunto de perguntas, em que a marca aparece, comparada aos concorrentes."
        },
        {
          "@language": "en",
          "@value": "Share of AI answers, across a set of questions, in which the brand appears, compared with competitors."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#share-of-search",
      "termCode": "share-of-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Participação nas buscas"
        },
        {
          "@language": "en",
          "@value": "Share of Search"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Buscas pela marca divididas pelas buscas de todas as marcas da categoria. Estudos de Les Binet associaram esse indicador à participação de mercado futura."
        },
        {
          "@language": "en",
          "@value": "Searches for the brand divided by searches for all brands in the category. Studies by Les Binet linked this indicator to future market share."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#parameters",
      "termCode": "parameters",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Parâmetros (pesos)"
        },
        {
          "@language": "en",
          "@value": "Parameters (Weights)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Números internos ajustados no treinamento que guardam o que o modelo aprendeu. Modelos atuais têm de bilhões a trilhões de parâmetros."
        },
        {
          "@language": "en",
          "@value": "Internal numbers adjusted in training that store what the model learned. Current models have billions to trillions of parameters."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#passage",
      "termCode": "passage",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Passagem"
        },
        {
          "@language": "en",
          "@value": "Passage"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Trecho de texto (um parágrafo ou uma seção) tratado como unidade de recuperação e de ranqueamento. Buscadores e sistemas RAG avaliam passagens, não só páginas inteiras."
        },
        {
          "@language": "en",
          "@value": "Piece of text (a paragraph or a section) treated as a unit of retrieval and ranking. Search engines and RAG systems assess passages, not only whole pages."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#digital-footprint",
      "termCode": "digital-footprint",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Pegada digital"
        },
        {
          "@language": "en",
          "@value": "Digital Footprint"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conjunto de rastros públicos de uma pessoa ou empresa na internet: site, perfis, menções, avaliações, cadastros e publicações. Quanto maior e mais coerente, mais fácil para buscadores e IAs reconhecerem a entidade."
        },
        {
          "@language": "en",
          "@value": "Set of public traces a person or company leaves online: site, profiles, mentions, reviews, listings and publications. The larger and more consistent it is, the easier it is for search engines and AI to recognize the entity."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#lost-in-the-middle",
      "termCode": "lost-in-the-middle",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Perdido no meio"
        },
        {
          "@language": "en",
          "@value": "Lost in the Middle"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Efeito observado em LLMs que usam pior as informações no meio de um contexto longo do que as do começo e do fim."
        },
        {
          "@language": "en",
          "@value": "Effect observed in LLMs, which use information in the middle of a long context worse than at the start and end."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2307.03172"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#google-business-profile",
      "termCode": "google-business-profile",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Perfil da Empresa no Google"
        },
        {
          "@language": "en",
          "@value": "Google Business Profile (GBP)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ficha gratuita da empresa no Google Search e no Maps, com categoria, endereço, horário, fotos, avaliações e posts. Antigo Google Meu Negócio."
        },
        {
          "@language": "en",
          "@value": "Free business listing on Google Search and Maps, with category, address, hours, photos, reviews and posts. Formerly Google My Business."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://support.google.com/business"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#multi-hop-question",
      "termCode": "multi-hop-question",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Pergunta de vários saltos"
        },
        {
          "@language": "en",
          "@value": "Multi-hop Question"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Pergunta que só se responde juntando fatos de fontes diferentes, como \"o fundador da empresa X estudou onde?\". É onde grafos de conhecimento e GraphRAG mais ajudam."
        },
        {
          "@language": "en",
          "@value": "Question that can only be answered by combining facts from different sources, such as \"where did the founder of company X study?\". It is where knowledge graphs and GraphRAG help most."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#original-research",
      "termCode": "original-research",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Pesquisa própria"
        },
        {
          "@language": "en",
          "@value": "Original Research"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Dados coletados pela própria marca (pesquisas, testes, levantamentos). Geram links, menções e fatos que só ela pode oferecer, o que favorece a citação."
        },
        {
          "@language": "en",
          "@value": "Data collected by the brand itself (surveys, tests, studies). It earns links, mentions and facts only that brand can offer, which favors citation."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#content-pruning",
      "termCode": "content-pruning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Poda de conteúdo"
        },
        {
          "@language": "en",
          "@value": "Content Pruning"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Revisão de páginas fracas ou desatualizadas para melhorar, juntar, redirecionar ou remover."
        },
        {
          "@language": "en",
          "@value": "Reviewing weak or outdated pages to improve, merge, redirect or remove them."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#citation-position",
      "termCode": "citation-position",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Posição da citação"
        },
        {
          "@language": "en",
          "@value": "Citation Position"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ordem em que a fonte aparece na resposta ou na lista de fontes. Fontes citadas primeiro recebem mais atenção e cliques."
        },
        {
          "@language": "en",
          "@value": "Order in which a source appears in the answer or the source list. Sources cited first get more attention and clicks."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#average-position",
      "termCode": "average-position",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Posição média"
        },
        {
          "@language": "en",
          "@value": "Average Position"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Média da posição mais alta em que a página apareceu nas consultas em que foi exibida."
        },
        {
          "@language": "en",
          "@value": "Average of the highest position the page held across the queries where it appeared."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#citation-precision",
      "termCode": "citation-precision",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Precisão da citação"
        },
        {
          "@language": "en",
          "@value": "Citation Precision"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Proporção das citações em que a fonte citada de fato sustenta a afirmação a que está ligada. Uma IA pode citar uma página que não diz o que a resposta afirma."
        },
        {
          "@language": "en",
          "@value": "Share of citations in which the cited source actually supports the claim it is attached to. AI may cite a page that does not say what the answer claims."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#claim-scope-preservation",
      "termCode": "claim-scope-preservation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Preservação do escopo da afirmação"
        },
        {
          "@language": "en",
          "@value": "Claim-Scope Preservation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Critério de Raphael Sousa Pereira para auditoria em LLMO: condições, população, período e nível de certeza de uma afirmação não podem desaparecer quando a IA a resume."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's criterion for LLMO audits: a claim's conditions, population, period and level of certainty must not disappear when AI summarizes it."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/o-que-e-llmo-em-2026-guia-tecnico-sobre-otimizacao-para-llms-geo-e-ai-search/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#next-token-prediction",
      "termCode": "next-token-prediction",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Previsão do próximo token"
        },
        {
          "@language": "en",
          "@value": "Next-token Prediction"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tarefa básica de um LLM: estimar qual token vem a seguir dado o texto anterior. A geração repete isso token a token."
        },
        {
          "@language": "en",
          "@value": "An LLM's basic task: estimating which token comes next given the preceding text. Generation repeats this token by token."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#nlp",
      "termCode": "nlp",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Processamento de linguagem natural"
        },
        {
          "@language": "en",
          "@value": "Natural Language Processing (NLP)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Área da IA dedicada a fazer computadores entenderem e produzirem linguagem humana."
        },
        {
          "@language": "en",
          "@value": "Field of AI devoted to making computers understand and produce human language."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#crawl-depth",
      "termCode": "crawl-depth",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Profundidade de clique"
        },
        {
          "@language": "en",
          "@value": "Crawl Depth (Click Depth)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quantos cliques separam uma página da home. Páginas muito profundas tendem a ser rastreadas com menos frequência."
        },
        {
          "@language": "en",
          "@value": "How many clicks separate a page from the home page. Very deep pages tend to be crawled less often."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#content-depth",
      "termCode": "content-depth",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Profundidade de conteúdo"
        },
        {
          "@language": "en",
          "@value": "Content Depth"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Nível de detalhe com que cada aspecto de um tema é tratado: dados, exemplos, exceções e passos. Cobrir muitos subtemas sem profundidade gera conteúdo raso."
        },
        {
          "@language": "en",
          "@value": "Level of detail with which each aspect of a topic is covered: data, examples, exceptions and steps. Covering many subtopics without depth produces thin content."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#prompt",
      "termCode": "prompt",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Prompt"
        },
        {
          "@language": "en",
          "@value": "Prompt"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Texto de entrada que diz ao modelo o que fazer, com instruções, contexto, exemplos e formato desejado."
        },
        {
          "@language": "en",
          "@value": "Input text telling the model what to do, with instructions, context, examples and the desired format."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#few-shot",
      "termCode": "few-shot",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Prompt com poucos exemplos"
        },
        {
          "@language": "en",
          "@value": "Few-shot Prompting"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Incluir alguns exemplos de entrada e saída no prompt para mostrar o padrão esperado."
        },
        {
          "@language": "en",
          "@value": "Including a few input-output examples in the prompt to show the expected pattern."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#system-prompt",
      "termCode": "system-prompt",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Prompt de sistema"
        },
        {
          "@language": "en",
          "@value": "System Prompt"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Instruções de base que o desenvolvedor dá ao modelo, valendo para toda a conversa: papel, regras, tom e limites."
        },
        {
          "@language": "en",
          "@value": "Baseline instructions the developer gives the model for the whole conversation: role, rules, tone and limits."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#zero-shot",
      "termCode": "zero-shot",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Prompt sem exemplos"
        },
        {
          "@language": "en",
          "@value": "Zero-shot Prompting"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Pedir a tarefa sem dar exemplos, contando só com as instruções."
        },
        {
          "@language": "en",
          "@value": "Asking for the task without giving examples, relying only on instructions."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#agent-readiness",
      "termCode": "agent-readiness",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Prontidão para agentes"
        },
        {
          "@language": "en",
          "@value": "Agent Readiness"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quanto um site pode ser usado por agentes de IA: conteúdo legível, formulários com rótulos corretos, ações declaradas, APIs documentadas e políticas claras."
        },
        {
          "@language": "en",
          "@value": "How usable a site is for AI agents: readable content, correctly labeled forms, declared actions, documented APIs and clear policies."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#knowsabout",
      "termCode": "knowsabout",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Propriedade knowsAbout"
        },
        {
          "@language": "en",
          "@value": "knowsAbout"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Propriedade Schema.org que declara os temas que uma pessoa ou organização domina. Ajuda a ligar o autor aos assuntos, mas só pesa quando há publicações que comprovem."
        },
        {
          "@language": "en",
          "@value": "Schema.org property declaring the topics a person or organization is knowledgeable about. It helps tie the author to subjects, but only carries weight when publications back it up."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://schema.org/knowsAbout"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#same-as",
      "termCode": "same-as",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Propriedade sameAs"
        },
        {
          "@language": "en",
          "@value": "sameAs"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Propriedade Schema.org que aponta perfis oficiais da mesma entidade em outros lugares (Wikidata, LinkedIn, Instagram), ajudando a desambiguação."
        },
        {
          "@language": "en",
          "@value": "Schema.org property pointing to the same entity's official profiles elsewhere (Wikidata, LinkedIn, Instagram), helping disambiguation."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://schema.org/sameAs"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#brand-safety-ai",
      "termCode": "brand-safety-ai",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Proteção de marca em IA"
        },
        {
          "@language": "en",
          "@value": "Brand Protection in AI"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Monitorar e corrigir o que IAs dizem sobre a marca: fatos errados, confusão com homônimos, associação a temas negativos e conteúdo de concorrentes."
        },
        {
          "@language": "en",
          "@value": "Monitoring and correcting what AI says about the brand: wrong facts, confusion with namesakes, association with negative topics and competitor content."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#a2a",
      "termCode": "a2a",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo Agent2Agent"
        },
        {
          "@language": "en",
          "@value": "Agent2Agent Protocol (A2A)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo aberto, lançado pelo Google em 2025, para agentes de IA de fornecedores diferentes se descobrirem e trocarem tarefas."
        },
        {
          "@language": "en",
          "@value": "Open protocol, launched by Google in 2025, for AI agents from different vendors to discover each other and exchange tasks."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://a2a-protocol.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cc-geo",
      "termCode": "cc-geo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo de canal e coordenada (CC-GEO)"
        },
        {
          "@language": "en",
          "@value": "Channel-Coordinate Protocol (CC-GEO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo de Raphael Sousa Pereira que controla três variáveis na medição de GEO: coordenada geográfica, canal de coleta (API ou interface web) e declaração de automação aos provedores. A implementação de referência tem 25 ambientes, 40 prompts e 5 repetições."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's protocol that controls three variables in GEO measurement: geographic coordinate, collection channel (API or web interface) and disclosure of automation to providers. The reference implementation has 25 environments, 40 prompts and 5 repetitions."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://raphaelsousapereira.com.br/publicacoes-em-seo-geo/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#acp",
      "termCode": "acp",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo de comércio agêntico"
        },
        {
          "@language": "en",
          "@value": "Agentic Commerce Protocol (ACP)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Padrão aberto, lançado pela OpenAI e pela Stripe em 2025, para agentes de IA concluírem compras com lojistas, que continuam como vendedores responsáveis pelo pedido."
        },
        {
          "@language": "en",
          "@value": "Open standard, launched by OpenAI and Stripe in 2025, for AI agents to complete purchases with merchants, who remain the seller of record."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.agenticcommerce.dev"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#mcp",
      "termCode": "mcp",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo de contexto de modelo"
        },
        {
          "@language": "en",
          "@value": "Model Context Protocol (MCP)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo aberto, criado pela Anthropic em 2024, que padroniza como aplicações de IA se conectam a ferramentas e fontes de dados externas."
        },
        {
          "@language": "en",
          "@value": "Open protocol, created by Anthropic in 2024, that standardizes how AI applications connect to external tools and data sources."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://modelcontextprotocol.io"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#protocolo-evidencia-inferencia-hipotese",
      "termCode": "protocolo-evidencia-inferencia-hipotese",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo Evidência, Inferência e Hipótese"
        },
        {
          "@language": "en",
          "@value": "Evidence, Inference and Hypothesis Protocol"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo de Raphael Sousa Pereira que classifica cada afirmação de um estudo pelo tipo de prova que a sustenta: evidência (observada), inferência (deduzida da evidência) ou hipótese (ainda não testada)."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's protocol that classifies each claim in a study by the kind of proof behind it: evidence (observed), inference (deduced from evidence) or hypothesis (not yet tested)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://raphaelsousapereira.com.br/raphael-sousa-pereira/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#content-provenance",
      "termCode": "content-provenance",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Proveniência de conteúdo"
        },
        {
          "@language": "en",
          "@value": "Content Provenance (C2PA)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Registro verificável da origem e das edições de um arquivo de mídia, como no padrão C2PA, que mostra se a peça foi criada ou alterada por IA."
        },
        {
          "@language": "en",
          "@value": "Verifiable record of a media file's origin and edits, as in the C2PA standard, showing whether it was created or altered by AI."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://c2pa.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#pretraining",
      "termCode": "pretraining",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Pré-treinamento"
        },
        {
          "@language": "en",
          "@value": "Pretraining"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Primeira e mais cara etapa do treino, em que o modelo aprende linguagem e conhecimento geral prevendo tokens em textos enormes."
        },
        {
          "@language": "en",
          "@value": "First and most expensive training stage, in which the model learns language and general knowledge by predicting tokens in huge texts."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#brand-facts-page",
      "termCode": "brand-facts-page",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Página de fatos da marca"
        },
        {
          "@language": "en",
          "@value": "Brand Facts Page"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página com os fatos oficiais e verificáveis da empresa (fundação, sede, serviços, números com fonte e data), feita para ser lida e citada por pessoas e IAs."
        },
        {
          "@language": "en",
          "@value": "Page with the company's official, verifiable facts (founding, headquarters, services, sourced and dated figures), made to be read and cited by people and AI."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#serp",
      "termCode": "serp",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Página de resultados do buscador"
        },
        {
          "@language": "en",
          "@value": "Search Engine Results Page (SERP)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página que o buscador devolve para uma consulta, com resultados orgânicos, anúncios e recursos como mapas, vídeos, perguntas relacionadas e resumos gerados por IA."
        },
        {
          "@language": "en",
          "@value": "Page a search engine returns for a query, combining organic results, ads and features such as maps, videos, related questions and AI-generated summaries."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#pillar-page",
      "termCode": "pillar-page",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Página pilar"
        },
        {
          "@language": "en",
          "@value": "Pillar Page"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página abrangente sobre um tema central que liga e recebe links das páginas de detalhe do cluster."
        },
        {
          "@language": "en",
          "@value": "Comprehensive page on a core topic that links to and from the cluster's detail pages."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#orphan-page",
      "termCode": "orphan-page",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Página órfã"
        },
        {
          "@language": "en",
          "@value": "Orphan Page"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página sem nenhum link interno apontando para ela. Robôs e pessoas têm dificuldade para encontrá-la."
        },
        {
          "@language": "en",
          "@value": "Page with no internal links pointing to it. Bots and people struggle to find it."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-home",
      "termCode": "entity-home",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Página-casa da entidade"
        },
        {
          "@language": "en",
          "@value": "Entity Home"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página que a própria entidade controla e que define oficialmente quem ela é, normalmente a página \"Sobre\". Serve de referência para buscadores e IAs."
        },
        {
          "@language": "en",
          "@value": "Page the entity itself controls that officially defines who it is, usually the \"About\" page. It is the reference for search engines and AI."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#post-training",
      "termCode": "post-training",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Pós-treinamento"
        },
        {
          "@language": "en",
          "@value": "Post-training"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Etapas depois do pré-treino que tornam o modelo útil e seguro: ajuste com instruções, preferências humanas e reforço."
        },
        {
          "@language": "en",
          "@value": "Stages after pretraining that make the model helpful and safe: instruction tuning, human preferences and reinforcement."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#quantization",
      "termCode": "quantization",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Quantização"
        },
        {
          "@language": "en",
          "@value": "Quantization"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Redução da precisão numérica dos pesos (por exemplo, de 16 para 4 bits) para o modelo ocupar menos memória e rodar mais rápido, com pequena perda de qualidade."
        },
        {
          "@language": "en",
          "@value": "Reducing the numeric precision of weights (for example, from 16 to 4 bits) so the model uses less memory and runs faster, with a small quality loss."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#quem-voce-acompanha",
      "termCode": "quem-voce-acompanha",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Quem Você Acompanha"
        },
        {
          "@language": "en",
          "@value": "Who You Travel With"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Métrica nomeada por Raphael Sousa Pereira: o conjunto de marcas citadas junto com a sua nas respostas de IA. Funciona como assinatura de posicionamento e revela mais do que um ranking isolado."
        },
        {
          "@language": "en",
          "@value": "Metric named by Raphael Sousa Pereira: the set of brands cited alongside yours in AI answers. It works as a positioning signature and reveals more than an isolated ranking."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/geo-porto-alegre/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#crawling",
      "termCode": "crawling",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Rastreamento"
        },
        {
          "@language": "en",
          "@value": "Crawling"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Processo pelo qual o robô do buscador descobre e baixa páginas seguindo links e sitemaps."
        },
        {
          "@language": "en",
          "@value": "Process by which a search engine's bot discovers and downloads pages by following links and sitemaps."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/fundamentals/how-search-works"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#react-agent",
      "termCode": "react-agent",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "ReAct"
        },
        {
          "@language": "en",
          "@value": "ReAct"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Padrão em que o modelo alterna raciocínio e ação (usar uma ferramenta, observar o resultado) até concluir a tarefa."
        },
        {
          "@language": "en",
          "@value": "Pattern in which the model alternates reasoning and acting (using a tool, observing the result) until the task is done."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2210.03629"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#attributed-revenue",
      "termCode": "attributed-revenue",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Receita atribuída"
        },
        {
          "@language": "en",
          "@value": "Attributed Revenue"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Receita de pedidos ligados a uma origem (busca orgânica, IA, anúncio) por uma regra de atribuição declarada. Mostra associação, não prova que a origem causou a venda."
        },
        {
          "@language": "en",
          "@value": "Revenue from orders tied to a source (organic search, AI, ads) by a stated attribution rule. It shows association, not proof that the source caused the sale."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-recommendation",
      "termCode": "ai-recommendation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Recomendação por IA"
        },
        {
          "@language": "en",
          "@value": "AI Recommendation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando a resposta de IA indica a marca como opção para a necessidade do usuário, e não só a menciona. É o resultado que mais se aproxima de uma indicação comercial."
        },
        {
          "@language": "en",
          "@value": "When an AI answer suggests the brand as an option for the user's need instead of merely mentioning it. It is the outcome closest to a commercial referral."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#named-entity-recognition",
      "termCode": "named-entity-recognition",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Reconhecimento de entidades nomeadas"
        },
        {
          "@language": "en",
          "@value": "Named Entity Recognition (NER)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tarefa de identificar no texto nomes de pessoas, empresas, lugares, datas e valores."
        },
        {
          "@language": "en",
          "@value": "Task of identifying names of people, companies, places, dates and amounts in text."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#retrievability",
      "termCode": "retrievability",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Recuperabilidade"
        },
        {
          "@language": "en",
          "@value": "Retrievability"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Chance de uma página ser encontrada pela camada de recuperação para as perguntas que ela responde. Vem antes da citação: o que não é recuperado não entra na resposta."
        },
        {
          "@language": "en",
          "@value": "Chance of a page being found by the retrieval layer for the questions it answers. It comes before citation: what is not retrieved does not enter the answer."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#dense-retrieval",
      "termCode": "dense-retrieval",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Recuperação densa"
        },
        {
          "@language": "en",
          "@value": "Dense Retrieval"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Recuperação de passagens comparando embeddings da pergunta e dos documentos, em vez de palavras."
        },
        {
          "@language": "en",
          "@value": "Retrieving passages by comparing embeddings of the question and the documents instead of words."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2004.04906"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#serp-feature",
      "termCode": "serp-feature",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Recurso da página de resultados"
        },
        {
          "@language": "en",
          "@value": "SERP Feature"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Qualquer elemento além dos links azuis: trecho em destaque, painel de conhecimento, pacote local, carrossel, perguntas relacionadas, resumo por IA."
        },
        {
          "@language": "en",
          "@value": "Any element beyond the blue links: featured snippet, knowledge panel, local pack, carousel, related questions, AI summary."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#training-opt-out",
      "termCode": "training-opt-out",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Recusa de uso para treino"
        },
        {
          "@language": "en",
          "@value": "Training Opt-out"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Bloquear robôs de treino (por exemplo GPTBot) sem bloquear os de busca (OAI-SearchBot), para não ceder conteúdo ao treino e continuar aparecendo nas respostas."
        },
        {
          "@language": "en",
          "@value": "Blocking training bots (for example GPTBot) without blocking search bots (OAI-SearchBot), so content is not given to training but still appears in answers."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cdn",
      "termCode": "cdn",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Rede de distribuição de conteúdo"
        },
        {
          "@language": "en",
          "@value": "Content Delivery Network (CDN)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Rede de servidores espalhados que entrega arquivos do ponto mais próximo do visitante, reduzindo o tempo de carregamento. Alguns CDNs também bloqueiam robôs de IA por padrão."
        },
        {
          "@language": "en",
          "@value": "Network of distributed servers that delivers files from the point closest to the visitor, cutting load time. Some CDNs also block AI bots by default."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#neural-network",
      "termCode": "neural-network",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Rede neural"
        },
        {
          "@language": "en",
          "@value": "Neural Network"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo formado por camadas de unidades conectadas cujos pesos são ajustados no treinamento para transformar entradas em saídas."
        },
        {
          "@language": "en",
          "@value": "Model made of layers of connected units whose weights are adjusted in training to turn inputs into outputs."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#redirect-301",
      "termCode": "redirect-301",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Redirecionamento 301"
        },
        {
          "@language": "en",
          "@value": "301 Redirect"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Resposta HTTP que indica mudança permanente de endereço e transfere os sinais da URL antiga para a nova."
        },
        {
          "@language": "en",
          "@value": "HTTP response indicating a permanent move, passing the old URL's signals to the new one."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/301-redirects"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#knowledge-panel-claim",
      "termCode": "knowledge-panel-claim",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Reivindicar o painel de conhecimento"
        },
        {
          "@language": "en",
          "@value": "Claiming a Knowledge Panel"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Processo do Google para a própria pessoa ou organização verificar que é a entidade do painel e poder sugerir correções. Exige entrar por uma conta ligada a um site ou perfil oficial."
        },
        {
          "@language": "en",
          "@value": "Google process by which a person or organization verifies it is the panel's entity and can suggest corrections. It requires signing in with an account tied to an official site or profile."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://support.google.com/knowledgepanel/answer/7534902"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#closed-loop-reporting",
      "termCode": "closed-loop-reporting",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Relatório de ciclo fechado"
        },
        {
          "@language": "en",
          "@value": "Closed-loop Reporting"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Relatório que liga busca, sessão, contato, oportunidade e venda, com dados do CRM, para medir a contribuição real de um canal e não só o tráfego."
        },
        {
          "@language": "en",
          "@value": "Report linking search, session, lead, opportunity and sale, using CRM data, to measure a channel's real contribution, not just traffic."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#index-coverage",
      "termCode": "index-coverage",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Relatório de indexação"
        },
        {
          "@language": "en",
          "@value": "Index Coverage (Page Indexing Report)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Relatório do Google Search Console que mostra quais URLs estão indexadas e o motivo das que não estão."
        },
        {
          "@language": "en",
          "@value": "Google Search Console report showing which URLs are indexed and why the others are not."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#digital-pr",
      "termCode": "digital-pr",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Relações públicas digitais"
        },
        {
          "@language": "en",
          "@value": "Digital PR"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Produção de notícias, dados e histórias para conseguir menções e links em veículos e sites de autoridade."
        },
        {
          "@language": "en",
          "@value": "Producing news, data and stories to earn mentions and links from media and authoritative sites."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#proximity-relevance-prominence",
      "termCode": "proximity-relevance-prominence",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Relevância, distância e proeminência"
        },
        {
          "@language": "en",
          "@value": "Relevance, Distance and Prominence"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Os três critérios que o Google declara para ordenar resultados locais: quanto a empresa combina com a busca, quão perto está e quão conhecida é."
        },
        {
          "@language": "en",
          "@value": "The three criteria Google states for ordering local results: how well the business matches the search, how close it is and how well known it is."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://support.google.com/business/answer/7091"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#rendering",
      "termCode": "rendering",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Renderização"
        },
        {
          "@language": "en",
          "@value": "Rendering"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Execução do HTML, CSS e JavaScript da página para obter o conteúdo final que o usuário vê. Conteúdo que só aparece depois do JavaScript pode ser lido com atraso ou não ser lido por alguns robôs."
        },
        {
          "@language": "en",
          "@value": "Executing a page's HTML, CSS and JavaScript to obtain the final content the user sees. Content that only appears after JavaScript may be read late, or not at all, by some bots."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#server-side-rendering",
      "termCode": "server-side-rendering",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Renderização no servidor"
        },
        {
          "@language": "en",
          "@value": "Server-side Rendering (SSR)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "O servidor entrega o HTML já montado, em vez de deixar o navegador montar a página com JavaScript. Robôs, inclusive os de IA que não executam JavaScript, leem o conteúdo na hora."
        },
        {
          "@language": "en",
          "@value": "The server delivers fully built HTML instead of letting the browser build the page with JavaScript. Bots, including AI bots that do not run JavaScript, read the content immediately."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#reranking",
      "termCode": "reranking",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Reordenação"
        },
        {
          "@language": "en",
          "@value": "Reranking"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Segunda etapa que reavalia os documentos recuperados com um modelo mais preciso e escolhe os melhores para o contexto."
        },
        {
          "@language": "en",
          "@value": "Second step that re-scores retrieved documents with a more accurate model and picks the best for the context."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-resolution",
      "termCode": "entity-resolution",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Resolução de entidade"
        },
        {
          "@language": "en",
          "@value": "Entity Resolution (Reconciliation)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Processo em que um sistema decide que menções diferentes (\"Negócio no Mapa\", \"seonegocionomapa.com.br\", \"@negocionomapa\") são a mesma entidade e as liga a um único identificador."
        },
        {
          "@language": "en",
          "@value": "Process in which a system decides that different mentions (\"Negócio no Mapa\", \"seonegocionomapa.com.br\", \"@negocionomapa\") are the same entity and links them to a single identifier."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/knowledge-graph"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#valid-response",
      "termCode": "valid-response",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Resposta válida"
        },
        {
          "@language": "en",
          "@value": "Valid Response"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Resposta que entra na conta da medição: a coleta funcionou e a IA respondeu ao que foi perguntado. Recusas, erros e respostas fora do tema ficam de fora e precisam ser informados."
        },
        {
          "@language": "en",
          "@value": "Answer that counts in the measurement: collection worked and the AI answered what was asked. Refusals, errors and off-topic answers are excluded and must be reported."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#incrementality",
      "termCode": "incrementality",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Resultado incremental"
        },
        {
          "@language": "en",
          "@value": "Incrementality"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "O que aconteceu por causa de uma ação e não teria acontecido sem ela, medido comparando com um grupo ou período de controle."
        },
        {
          "@language": "en",
          "@value": "What happened because of an action and would not have happened without it, measured against a control group or period."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#rich-results",
      "termCode": "rich-results",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Resultados aprimorados"
        },
        {
          "@language": "en",
          "@value": "Rich Results"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Resultados com elementos extras, como estrelas, preço, perguntas ou eventos, gerados a partir de dados estruturados válidos."
        },
        {
          "@language": "en",
          "@value": "Results with extra elements, such as stars, price, questions or events, generated from valid structured data."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/structured-data/search-gallery"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-crawler",
      "termCode": "ai-crawler",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Robô de IA"
        },
        {
          "@language": "en",
          "@value": "AI Crawler"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Robô que coleta páginas para empresas de IA. Há três usos: treino (GPTBot, ClaudeBot, Google-Extended como controle), busca (OAI-SearchBot, Claude-SearchBot, PerplexityBot) e acesso a pedido do usuário (ChatGPT-User, Claude-User, Perplexity-User)."
        },
        {
          "@language": "en",
          "@value": "Bot that collects pages for AI companies. There are three uses: training (GPTBot, ClaudeBot, Google-Extended as a control), search (OAI-SearchBot, Claude-SearchBot, PerplexityBot) and on-demand user fetches (ChatGPT-User, Claude-User, Perplexity-User)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#crawler",
      "termCode": "crawler",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Robô de rastreamento"
        },
        {
          "@language": "en",
          "@value": "Crawler (Bot, Spider)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Programa que visita páginas automaticamente para coletar o conteúdo, como o Googlebot, o Bingbot e os robôs das empresas de IA."
        },
        {
          "@language": "en",
          "@value": "Program that visits pages automatically to collect content, such as Googlebot, Bingbot and AI companies' bots."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-salience",
      "termCode": "entity-salience",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Saliência da entidade"
        },
        {
          "@language": "en",
          "@value": "Entity Salience"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quão central uma entidade é num texto. Páginas em que a marca é o assunto principal, e não uma menção de passagem, reforçam a associação."
        },
        {
          "@language": "en",
          "@value": "How central an entity is in a text. Pages where the brand is the main subject, not a passing mention, strengthen the association."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#guardrails",
      "termCode": "guardrails",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Salvaguardas"
        },
        {
          "@language": "en",
          "@value": "Guardrails"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Controles em volta do modelo (filtros, validações, regras, revisões) que limitam o que ele recebe e o que pode responder ou fazer."
        },
        {
          "@language": "en",
          "@value": "Controls around the model (filters, validations, rules, reviews) that limit what it receives and what it can answer or do."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#structured-output",
      "termCode": "structured-output",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Saída estruturada"
        },
        {
          "@language": "en",
          "@value": "Structured Output"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Resposta do modelo num formato definido, como JSON que segue um esquema, para ser usada direto por programas."
        },
        {
          "@language": "en",
          "@value": "Model answer in a defined format, such as JSON following a schema, to be used directly by programs."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#article-schema",
      "termCode": "article-schema",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Schema Article"
        },
        {
          "@language": "en",
          "@value": "Article Schema"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Marcação de artigos com título, autor, data de publicação e de modificação e imagem. Liga o conteúdo ao autor como entidade."
        },
        {
          "@language": "en",
          "@value": "Article markup with headline, author, published and modified dates and image. It ties content to the author as an entity."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/structured-data/article"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#schema-authority",
      "termCode": "schema-authority",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Schema Authority"
        },
        {
          "@language": "en",
          "@value": "Schema Authority"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Método de Raphael Sousa Pereira, apresentado em livro, que avalia de 0 a 1000 os dados estruturados de um site por entidades, estrutura, coerência, prova e ação."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's method, presented in a book, that scores a site's structured data from 0 to 1000 by entities, structure, coherence, proof and action."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/schema-authority-2026-guia-de-schema-org-geo-e-ia/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#dataset-schema",
      "termCode": "dataset-schema",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Schema Dataset"
        },
        {
          "@language": "en",
          "@value": "Dataset Schema"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Marcação Schema.org para conjuntos de dados (tabelas, pesquisas, séries), com nome, descrição, autor, licença, cobertura e links de download. Faz o dado aparecer no Google Dataset Search e o torna citável como fonte."
        },
        {
          "@language": "en",
          "@value": "Schema.org markup for datasets (tables, surveys, series), with name, description, creator, license, coverage and download links. It makes the data appear in Google Dataset Search and citable as a source."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/structured-data/dataset"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#faqpage-schema",
      "termCode": "faqpage-schema",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Schema FAQPage"
        },
        {
          "@language": "en",
          "@value": "FAQPage Schema"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Marcação de perguntas e respostas. Desde 2023 o Google só mostra o resultado aprimorado de FAQ para sites governamentais e de saúde, mas a marcação continua legível por outros sistemas e IAs."
        },
        {
          "@language": "en",
          "@value": "Question-and-answer markup. Since 2023 Google shows the FAQ rich result only for government and health sites, but other systems and AI can still read the markup."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/structured-data/faqpage"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#local-business-schema",
      "termCode": "local-business-schema",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Schema LocalBusiness"
        },
        {
          "@language": "en",
          "@value": "LocalBusiness Schema"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Subtipo de Organization para negócios com atendimento físico, com endereço, geolocalização, horário e área atendida."
        },
        {
          "@language": "en",
          "@value": "Organization subtype for businesses with physical service, including address, geo coordinates, hours and area served."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://schema.org/LocalBusiness"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#organization-schema",
      "termCode": "organization-schema",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Schema Organization"
        },
        {
          "@language": "en",
          "@value": "Organization Schema"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Marcação que descreve a empresa: nome, logo, URL, contato, endereço, fundador e perfis sameAs. Base da identidade da marca para buscadores e IAs."
        },
        {
          "@language": "en",
          "@value": "Markup describing the company: name, logo, URL, contact, address, founder and sameAs profiles. The basis of brand identity for search engines and AI."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/structured-data/organization"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#product-schema",
      "termCode": "product-schema",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Schema Product"
        },
        {
          "@language": "en",
          "@value": "Product Schema"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Marcação de produto com nome, imagem, preço, disponibilidade, avaliações e identificadores como GTIN. Usada por buscadores e por assistentes de compra."
        },
        {
          "@language": "en",
          "@value": "Product markup with name, image, price, availability, reviews and identifiers such as GTIN. Used by search engines and shopping assistants."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/structured-data/product"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#profilepage-schema",
      "termCode": "profilepage-schema",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Schema ProfilePage"
        },
        {
          "@language": "en",
          "@value": "ProfilePage Schema"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tipo Schema.org para páginas focadas numa pessoa ou organização, como a página de autor. Liga o perfil à entidade Person ou Organization pela propriedade mainEntity."
        },
        {
          "@language": "en",
          "@value": "Schema.org type for pages focused on one person or organization, such as an author page. It ties the profile to the Person or Organization entity through the mainEntity property."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/structured-data/profile-page"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#speakable-schema",
      "termCode": "speakable-schema",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Schema Speakable"
        },
        {
          "@language": "en",
          "@value": "Speakable Schema"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Propriedade Schema.org que marca os trechos de uma página mais adequados para leitura em voz alta por assistentes. No Google, é recurso beta, restrito a notícias e a alguns países."
        },
        {
          "@language": "en",
          "@value": "Schema.org property marking the parts of a page best suited to be read aloud by assistants. At Google it is a beta feature, limited to news and some countries."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/structured-data/speakable"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#schema-org",
      "termCode": "schema-org",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Schema.org"
        },
        {
          "@language": "en",
          "@value": "Schema.org"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Vocabulário mantido por Google, Microsoft, Yahoo e Yandex para descrever entidades (Organization, Person, Product, LocalBusiness, FAQPage e centenas de outras) e suas propriedades."
        },
        {
          "@language": "en",
          "@value": "Vocabulary maintained by Google, Microsoft, Yahoo and Yandex to describe entities (Organization, Person, Product, LocalBusiness, FAQPage and hundreds more) and their properties."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://schema.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-safety",
      "termCode": "ai-safety",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Segurança de IA"
        },
        {
          "@language": "en",
          "@value": "AI Safety"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Campo que estuda como evitar que sistemas de IA causem danos, por erro, mau uso ou comportamento inesperado."
        },
        {
          "@language": "en",
          "@value": "Field studying how to keep AI systems from causing harm, through error, misuse or unexpected behavior."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#brand-sentiment",
      "termCode": "brand-sentiment",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Sentimento da marca em IA"
        },
        {
          "@language": "en",
          "@value": "Brand Sentiment (AI)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tom com que as respostas de IA descrevem a marca: positivo, neutro ou negativo, e os motivos citados."
        },
        {
          "@language": "en",
          "@value": "Tone in which AI answers describe the brand: positive, neutral or negative, and the reasons given."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-seo",
      "termCode": "entity-seo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "SEO de entidades"
        },
        {
          "@language": "en",
          "@value": "Entity SEO"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Prática de reduzir a ambiguidade sobre uma marca, pessoa ou produto para que buscadores e IAs a reconheçam como entidade única, com atributos e relações, e não como uma sequência de palavras."
        },
        {
          "@language": "en",
          "@value": "Practice of reducing ambiguity about a brand, person or product so search engines and AI recognize it as a unique entity with attributes and relationships, not as a string of words."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#image-seo",
      "termCode": "image-seo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "SEO de imagens"
        },
        {
          "@language": "en",
          "@value": "Image SEO"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Práticas para imagens serem encontradas e não atrasarem a página: nome de arquivo e alt descritivos, formato moderno, dimensões definidas e carregamento tardio fora da tela."
        },
        {
          "@language": "en",
          "@value": "Practices that make images findable without slowing the page: descriptive file names and alt text, modern formats, set dimensions and lazy loading below the fold."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/google-images"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#seo-de-protecao-de-marca",
      "termCode": "seo-de-protecao-de-marca",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "SEO de Proteção de Marca"
        },
        {
          "@language": "en",
          "@value": "Brand Protection SEO"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Disciplina, nomeada por Raphael Sousa Pereira para a camada de IA generativa, de monitorar e corrigir representações incorretas de uma marca em buscadores e em respostas de IA, como citações erradas, atribuições equivocadas e descrições distorcidas."
        },
        {
          "@language": "en",
          "@value": "Discipline, named by Raphael Sousa Pereira for the generative-AI layer, of monitoring and correcting incorrect representations of a brand in search engines and AI answers, such as wrong citations, misattributions and distorted descriptions."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/quem-e-o-especialista-em-seo-de-protecao-de-marca-no-brasil/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#international-seo",
      "termCode": "international-seo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "SEO internacional"
        },
        {
          "@language": "en",
          "@value": "International SEO"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Estrutura e conteúdo para atender vários países ou idiomas: domínios ou pastas por mercado, hreflang, tradução de verdade e sinais locais."
        },
        {
          "@language": "en",
          "@value": "Structure and content to serve several countries or languages: domains or folders per market, hreflang, genuine translation and local signals."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#local-seo",
      "termCode": "local-seo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "SEO local"
        },
        {
          "@language": "en",
          "@value": "Local SEO"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Otimização para buscas com intenção local, como \"dentista perto de mim\", com foco no Perfil da Empresa no Google, no mapa e nas avaliações."
        },
        {
          "@language": "en",
          "@value": "Optimization for searches with local intent, such as \"dentist near me\", focused on the Google Business Profile, the map and reviews."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#off-page-seo",
      "termCode": "off-page-seo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "SEO off-page"
        },
        {
          "@language": "en",
          "@value": "Off-page SEO"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ações fora do site que aumentam a autoridade e a reputação: backlinks, menções à marca, avaliações e presença em fontes de referência."
        },
        {
          "@language": "en",
          "@value": "Actions outside the site that build authority and reputation: backlinks, brand mentions, reviews and presence on reference sources."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#on-page-seo",
      "termCode": "on-page-seo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "SEO on-page"
        },
        {
          "@language": "en",
          "@value": "On-page SEO"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Otimização feita dentro da página: título, headings, texto, imagens, links internos e dados estruturados."
        },
        {
          "@language": "en",
          "@value": "Optimization done within the page: title, headings, text, images, internal links and structured data."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#javascript-seo",
      "termCode": "javascript-seo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "SEO para JavaScript"
        },
        {
          "@language": "en",
          "@value": "JavaScript SEO"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Práticas para que sites que dependem de JavaScript sejam rastreados e indexados: links reais em <a href>, conteúdo essencial no HTML e renderização no servidor quando possível."
        },
        {
          "@language": "en",
          "@value": "Practices that let JavaScript-heavy sites be crawled and indexed: real <a href> links, essential content in the HTML and server-side rendering when possible."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/javascript/javascript-seo-basics"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#semantic-seo",
      "termCode": "semantic-seo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "SEO semântico"
        },
        {
          "@language": "en",
          "@value": "Semantic SEO"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Otimização por entidades, temas e relações entre conceitos, em vez de repetir palavras-chave exatas."
        },
        {
          "@language": "en",
          "@value": "Optimization around entities, topics and relationships between concepts instead of repeating exact keywords."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#technical-seo",
      "termCode": "technical-seo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "SEO técnico"
        },
        {
          "@language": "en",
          "@value": "Technical SEO"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Parte do SEO que cuida de rastreamento, indexação, renderização, velocidade, arquitetura, dados estruturados e segurança, para que o conteúdo possa ser encontrado e lido."
        },
        {
          "@language": "en",
          "@value": "Part of SEO that handles crawling, indexing, rendering, speed, architecture, structured data and security so content can be found and read."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#brand-serp",
      "termCode": "brand-serp",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "SERP da marca"
        },
        {
          "@language": "en",
          "@value": "Brand SERP"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página de resultados que aparece quando alguém busca o nome da marca: site oficial, painel de conhecimento, perfis, avaliações e notícias. É o primeiro retrato público da empresa e uma fonte que as IAs também leem."
        },
        {
          "@language": "en",
          "@value": "Results page shown when someone searches for the brand name: official site, knowledge panel, profiles, reviews and news. It is the company's first public portrait and a source AI also reads."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ymyl",
      "termCode": "ymyl",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Seu dinheiro ou sua vida"
        },
        {
          "@language": "en",
          "@value": "Your Money or Your Life (YMYL)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Temas que podem afetar saúde, finanças, segurança ou direitos das pessoas. Neles, o Google exige padrão mais alto de confiabilidade."
        },
        {
          "@language": "en",
          "@value": "Topics that can affect people's health, finances, safety or rights. For them, Google demands a higher trust standard."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cosine-similarity",
      "termCode": "cosine-similarity",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Similaridade de cosseno"
        },
        {
          "@language": "en",
          "@value": "Cosine Similarity"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Medida de proximidade entre dois embeddings pelo ângulo entre eles: perto de 1 significa sentidos muito parecidos."
        },
        {
          "@language": "en",
          "@value": "Measure of closeness between two embeddings by the angle between them: near 1 means very similar meanings."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#content-signals",
      "termCode": "content-signals",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Sinais de conteúdo"
        },
        {
          "@language": "en",
          "@value": "Content Signals"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Proposta publicada pela Cloudflare em 2025 para declarar no robots.txt como o conteúdo pode ser usado depois de coletado: busca (search), entrada de IA para respostas (ai-input) e treino (ai-train). É uma declaração de preferência, não um bloqueio técnico."
        },
        {
          "@language": "en",
          "@value": "Proposal published by Cloudflare in 2025 for declaring in robots.txt how content may be used after it is collected: search, AI input for answers (ai-input) and training (ai-train). It is a statement of preference, not a technical block."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://contentsignals.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#multi-agent-system",
      "termCode": "multi-agent-system",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Sistema multiagente"
        },
        {
          "@language": "en",
          "@value": "Multi-agent System"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Arranjo em que vários agentes, cada um com uma função, colaboram ou se revisam para cumprir uma tarefa maior."
        },
        {
          "@language": "en",
          "@value": "Setup in which several agents, each with a role, collaborate or review each other to complete a larger task."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#xml-sitemap",
      "termCode": "xml-sitemap",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Sitemap XML"
        },
        {
          "@language": "en",
          "@value": "XML Sitemap"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Arquivo que lista as URLs que o site quer ver rastreadas, com data de última modificação opcional, para ajudar os buscadores a descobrir páginas."
        },
        {
          "@language": "en",
          "@value": "File listing the URLs a site wants crawled, with an optional last-modified date, to help search engines discover pages."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.sitemaps.org/protocol.html"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#url-slug",
      "termCode": "url-slug",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Slug da URL"
        },
        {
          "@language": "en",
          "@value": "URL Slug"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Parte final e legível da URL que identifica a página, como /glossario-seo/. Deve ser curta, estável e descritiva."
        },
        {
          "@language": "en",
          "@value": "Final, readable part of the URL identifying the page, such as /seo-glossary/. It should be short, stable and descriptive."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#overfitting",
      "termCode": "overfitting",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Sobreajuste"
        },
        {
          "@language": "en",
          "@value": "Overfitting"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando o modelo decora os exemplos de treino e erra em dados novos."
        },
        {
          "@language": "en",
          "@value": "When a model memorizes training examples and fails on new data."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#soft-404",
      "termCode": "soft-404",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Soft 404"
        },
        {
          "@language": "en",
          "@value": "Soft 404"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página que responde 200 (sucesso), mas mostra conteúdo de \"não encontrado\" ou vazio. O buscador a trata como erro."
        },
        {
          "@language": "en",
          "@value": "Page that returns 200 (success) but shows \"not found\" or empty content. The search engine treats it as an error."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#geo-spam",
      "termCode": "geo-spam",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Spam de GEO"
        },
        {
          "@language": "en",
          "@value": "GEO Spam"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tentativas de manipular respostas de IA com texto escondido, instruções para o modelo, listas autopromocionais falsas ou páginas criadas só para serem citadas."
        },
        {
          "@language": "en",
          "@value": "Attempts to manipulate AI answers with hidden text, instructions to the model, fake self-promotional lists or pages made only to be cited."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#link-spam",
      "termCode": "link-spam",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Spam de links"
        },
        {
          "@language": "en",
          "@value": "Link Spam"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Links comprados, trocados em massa ou gerados automaticamente para manipular ranking. Vai contra as políticas do Google e pode levar a ação manual."
        },
        {
          "@language": "en",
          "@value": "Links bought, exchanged in bulk or auto-generated to manipulate rankings. It breaks Google's policies and may lead to a manual action."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/essentials/spam-policies"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#streaming",
      "termCode": "streaming",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Streaming"
        },
        {
          "@language": "en",
          "@value": "Streaming"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Envio da resposta em pedaços à medida que é gerada, em vez de esperar o texto inteiro."
        },
        {
          "@language": "en",
          "@value": "Sending the answer in pieces as it is generated instead of waiting for the full text."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#retrieval-surface",
      "termCode": "retrieval-surface",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Superfície de recuperação"
        },
        {
          "@language": "en",
          "@value": "Retrieval Surface"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Estrutura de Raphael Sousa Pereira para auditar, de fora, as condições que antecedem a recuperação e a geração: se os fatos críticos continuam acessíveis no HTML entregue, na renderização, na extração de texto e nas representações que alimentam a recuperação."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's framework for auditing, from the outside, the conditions that precede retrieval and generation: whether critical facts remain accessible in the delivered HTML, rendering, text extraction and the representations that feed retrieval."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/transformers-em-2026-como-llms-processam-contexto-e-onde-comeca-o-geo/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#title-tag",
      "termCode": "title-tag",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Tag de título"
        },
        {
          "@language": "en",
          "@value": "Title Tag"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Elemento <title> do HTML, usado como base do título azul nos resultados. Deve descrever a página com clareza e ser único no site."
        },
        {
          "@language": "en",
          "@value": "HTML <title> element, used as the basis for the blue headline in results. It should describe the page clearly and be unique on the site."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/title-link"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#citation-rate",
      "termCode": "citation-rate",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Taxa de citação"
        },
        {
          "@language": "en",
          "@value": "Citation Rate"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Porcentagem das respostas que citam o domínio da marca como fonte, num conjunto definido de perguntas e plataformas."
        },
        {
          "@language": "en",
          "@value": "Percentage of answers citing the brand's domain as a source, over a defined set of questions and platforms."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ctr",
      "termCode": "ctr",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Taxa de cliques"
        },
        {
          "@language": "en",
          "@value": "Click-through Rate (CTR)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Cliques divididos por impressões. Cai quando a resposta já aparece na página de resultados."
        },
        {
          "@language": "en",
          "@value": "Clicks divided by impressions. It drops when the answer already appears on the results page."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#conversion-rate",
      "termCode": "conversion-rate",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Taxa de conversão"
        },
        {
          "@language": "en",
          "@value": "Conversion Rate"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Porcentagem de visitas que realizam a ação desejada, como compra, contato ou cadastro."
        },
        {
          "@language": "en",
          "@value": "Percentage of visits that complete the desired action, such as a purchase, contact or sign-up."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#temporal-accuracy-rate",
      "termCode": "temporal-accuracy-rate",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Taxa de exatidão temporal (TAR)"
        },
        {
          "@language": "en",
          "@value": "Temporal Accuracy Rate (TAR)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Métrica proposta por Raphael Sousa Pereira: afirmações sensíveis ao tempo (cargo atual, endereço, certificação vigente) que estão atualizadas, divididas pelo total de afirmações com componente temporal."
        },
        {
          "@language": "en",
          "@value": "Metric proposed by Raphael Sousa Pereira: time-sensitive claims (current role, address, valid certification) that are up to date, divided by the total claims with a time component."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/como-reduzir-alucinacoes-de-ia-sobre-sua-empresa-em-2026/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-fidelity-rate",
      "termCode": "entity-fidelity-rate",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Taxa de fidelidade de entidade (EFR)"
        },
        {
          "@language": "en",
          "@value": "Entity Fidelity Rate (EFR)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Métrica proposta por Raphael Sousa Pereira: menções em que a IA identifica corretamente a entidade, sem confundir com homônimos ou concorrentes, divididas pelo total de menções testadas."
        },
        {
          "@language": "en",
          "@value": "Metric proposed by Raphael Sousa Pereira: mentions in which AI correctly identifies the entity, without confusing it with namesakes or competitors, divided by the total mentions tested."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/como-reduzir-alucinacoes-de-ia-sobre-sua-empresa-em-2026/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#citation-entailment-rate",
      "termCode": "citation-entailment-rate",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Taxa de implicação das citações (CER)"
        },
        {
          "@language": "en",
          "@value": "Citation Entailment Rate (CER)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Métrica proposta por Raphael Sousa Pereira: citações em que o texto citado implica logicamente a afirmação, e não apenas trata do mesmo tema, divididas pelo total de citações testadas."
        },
        {
          "@language": "en",
          "@value": "Metric proposed by Raphael Sousa Pereira: citations in which the cited text logically entails the claim, rather than merely covering the same topic, divided by the total citations tested."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/como-reduzir-alucinacoes-de-ia-sobre-sua-empresa-em-2026/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#mention-rate",
      "termCode": "mention-rate",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Taxa de menção"
        },
        {
          "@language": "en",
          "@value": "Mention Rate"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Porcentagem das respostas válidas, num conjunto de perguntas, em que a marca aparece no texto."
        },
        {
          "@language": "en",
          "@value": "Percentage of valid answers, over a set of questions, in which the brand appears in the text."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#recommendation-rate",
      "termCode": "recommendation-rate",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Taxa de recomendação"
        },
        {
          "@language": "en",
          "@value": "Recommendation Rate"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Porcentagem das respostas válidas em que a IA indica a marca como opção. É mais exigente que a taxa de menção e mais ligada a resultado comercial."
        },
        {
          "@language": "en",
          "@value": "Percentage of valid answers in which AI suggests the brand as an option. It is stricter than the mention rate and more tied to commercial results."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#claim-support-rate",
      "termCode": "claim-support-rate",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Taxa de suporte das afirmações (CSR)"
        },
        {
          "@language": "en",
          "@value": "Claim Support Rate (CSR)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Métrica proposta por Raphael Sousa Pereira: afirmações com sustentação direta e literal numa fonte real divididas pelo total de afirmações verificadas. É a mais próxima do conceito de fidelidade (faithfulness) da literatura."
        },
        {
          "@language": "en",
          "@value": "Metric proposed by Raphael Sousa Pereira: claims with direct, literal support in a real source divided by the total claims checked. It is the closest to the literature's concept of faithfulness."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/como-reduzir-alucinacoes-de-ia-sobre-sua-empresa-em-2026/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#geo-field-taxonomy",
      "termCode": "geo-field-taxonomy",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Taxonomia de campos do GEO"
        },
        {
          "@language": "en",
          "@value": "GEO Field Taxonomy"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Taxonomia de Raphael Sousa Pereira (preprint \"GEO como Campo\", Zenodo, agosto de 2026, DOI 10.5281/zenodo.21910615) que organiza o GEO em 15 campos, como pesquisa, engenharia, citabilidade, evidência e mensuração, em vez de tratá-lo como técnica única."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's taxonomy (preprint \"GEO as a Field\", Zenodo, August 2026, DOI 10.5281/zenodo.21910615) that organizes GEO into 15 fields, such as research, engineering, citability, evidence and measurement, instead of treating it as a single technique."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/raphael-sousa-pereira-na-evolucao-do-geo-3-dois-pesquisa-aplicada-e-geo-field-taxonomy/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#temperature",
      "termCode": "temperature",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Temperatura"
        },
        {
          "@language": "en",
          "@value": "Temperature"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Parâmetro que controla o grau de aleatoriedade da geração: baixo deixa a resposta mais previsível, alto deixa mais variada."
        },
        {
          "@language": "en",
          "@value": "Parameter controlling how random generation is: low makes the answer more predictable, high makes it more varied."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ttfb",
      "termCode": "ttfb",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Tempo até o primeiro byte"
        },
        {
          "@language": "en",
          "@value": "Time to First Byte (TTFB)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tempo entre a requisição e o primeiro byte da resposta do servidor. Servidor lento atrasa todas as outras métricas."
        },
        {
          "@language": "en",
          "@value": "Time between the request and the first byte of the server's response. A slow server delays every other metric."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://web.dev/articles/ttfb"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#rich-results-test",
      "termCode": "rich-results-test",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Teste de pesquisa aprimorada"
        },
        {
          "@language": "en",
          "@value": "Rich Results Test"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ferramenta gratuita do Google que lê uma URL ou um trecho de código e mostra quais dados estruturados encontrou, se são válidos e quais resultados aprimorados podem gerar."
        },
        {
          "@language": "en",
          "@value": "Free Google tool that reads a URL or a code snippet and shows which structured data it found, whether it is valid and which rich results it can produce."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://search.google.com/test/rich-results"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#alt-text",
      "termCode": "alt-text",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Texto alternativo"
        },
        {
          "@language": "en",
          "@value": "Alt Text"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Descrição textual de uma imagem no atributo alt. Serve à acessibilidade e ajuda buscadores a entender a imagem."
        },
        {
          "@language": "en",
          "@value": "Text description of an image in the alt attribute. It serves accessibility and helps search engines understand the image."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#anchor-text",
      "termCode": "anchor-text",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Texto âncora"
        },
        {
          "@language": "en",
          "@value": "Anchor Text"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Texto clicável de um link. Indica ao buscador o assunto da página de destino."
        },
        {
          "@language": "en",
          "@value": "Clickable text of a link. It tells the search engine what the target page is about."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#citation-source-type",
      "termCode": "citation-source-type",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Tipo de fonte citada"
        },
        {
          "@language": "en",
          "@value": "Citation Source Type"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Classificação das fontes que a IA cita: site da marca, imprensa, fórum, diretório, enciclopédia, avaliações, vídeo. Mostra onde a marca precisa estar presente."
        },
        {
          "@language": "en",
          "@value": "Classification of the sources AI cites: brand site, press, forum, directory, encyclopedia, reviews, video. It shows where the brand needs to be present."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#token",
      "termCode": "token",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Token"
        },
        {
          "@language": "en",
          "@value": "Token"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Pedaço de texto (palavra, parte de palavra ou sinal) que o modelo processa. Preço, limite de contexto e velocidade são medidos em tokens."
        },
        {
          "@language": "en",
          "@value": "Piece of text (word, word part or symbol) the model processes. Price, context limit and speed are measured in tokens."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#tokenization",
      "termCode": "tokenization",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Tokenização"
        },
        {
          "@language": "en",
          "@value": "Tokenization"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Divisão do texto em tokens antes de entrar no modelo. Português costuma gastar mais tokens por palavra do que inglês."
        },
        {
          "@language": "en",
          "@value": "Splitting text into tokens before it enters the model. Portuguese usually takes more tokens per word than English."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#top-p",
      "termCode": "top-p",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Top-p (amostragem por núcleo)"
        },
        {
          "@language": "en",
          "@value": "Top-p (Nucleus Sampling)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Parâmetro que limita a escolha do próximo token aos mais prováveis cuja probabilidade somada chega a p."
        },
        {
          "@language": "en",
          "@value": "Parameter limiting the next-token choice to the most likely tokens whose combined probability reaches p."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#transformer",
      "termCode": "transformer",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Transformer"
        },
        {
          "@language": "en",
          "@value": "Transformer"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Arquitetura de rede neural baseada em atenção, apresentada em 2017 no artigo \"Attention Is All You Need\". É a base de quase todos os LLMs."
        },
        {
          "@language": "en",
          "@value": "Attention-based neural network architecture introduced in 2017 in the paper \"Attention Is All You Need\". It underlies almost every LLM."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/1706.03762"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-transparency",
      "termCode": "ai-transparency",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Transparência em IA"
        },
        {
          "@language": "en",
          "@value": "AI Transparency"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Informar quando e como a IA foi usada, por exemplo rotulando conteúdo gerado por IA e explicando decisões automatizadas."
        },
        {
          "@language": "en",
          "@value": "Disclosing when and how AI was used, for example by labeling AI-generated content and explaining automated decisions."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#featured-snippet",
      "termCode": "featured-snippet",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Trecho em destaque"
        },
        {
          "@language": "en",
          "@value": "Featured Snippet"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Bloco no topo dos resultados com um trecho de uma página que responde diretamente à pergunta."
        },
        {
          "@language": "en",
          "@value": "Block at the top of results with an excerpt from a page that answers the question directly."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#breadcrumb",
      "termCode": "breadcrumb",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Trilha de navegação"
        },
        {
          "@language": "en",
          "@value": "Breadcrumb"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Linha de links que mostra onde a página está na hierarquia do site, como Início > Blog > SEO. Pode ser marcada com BreadcrumbList."
        },
        {
          "@language": "en",
          "@value": "Line of links showing where a page sits in the site hierarchy, such as Home > Blog > SEO. It can be marked up with BreadcrumbList."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#rdf-triple",
      "termCode": "rdf-triple",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Tripla"
        },
        {
          "@language": "en",
          "@value": "Triple (RDF)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Unidade mínima de um grafo de conhecimento: sujeito, predicado e objeto, como \"Negócio no Mapa – fundada em – 2016\". Dados estruturados em JSON-LD são, por baixo, conjuntos de triplas."
        },
        {
          "@language": "en",
          "@value": "Smallest unit of a knowledge graph: subject, predicate and object, such as \"Negócio no Mapa – founded in – 2016\". JSON-LD structured data is, underneath, a set of triples."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.w3.org/TR/rdf11-concepts/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#triangulo-de-citabilidade",
      "termCode": "triangulo-de-citabilidade",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Triângulo de Citabilidade"
        },
        {
          "@language": "en",
          "@value": "Citability Triangle"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Framework de Raphael Sousa Pereira com os três elementos que tornam um conteúdo citável por um LLM: ângulo editorial próprio, estrutura de citabilidade e dado exclusivo. Sem qualquer um deles, o conteúdo tende a ser ignorado, independentemente de backlinks ou posição no Google."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's framework with the three elements that make content citable by an LLM: an editorial angle of one's own, a citability structure and exclusive data. Without any of them, content tends to be ignored regardless of backlinks or Google position."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/o-colapso-do-conteudo-generico-raphael-sousa-pereira/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#dark-ai-traffic",
      "termCode": "dark-ai-traffic",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Tráfego de IA não identificado"
        },
        {
          "@language": "en",
          "@value": "Dark AI Traffic"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Visitas vindas de IAs que chegam sem referência e aparecem como tráfego direto, por exemplo quando o usuário copia o endereço da resposta ou o aplicativo não envia a origem. Faz o tráfego de IA parecer menor do que é."
        },
        {
          "@language": "en",
          "@value": "Visits from AI that arrive without a referrer and show up as direct traffic, for example when the user copies the address from the answer or the app does not send the source. It makes AI traffic look smaller than it is."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-referral-traffic",
      "termCode": "ai-referral-traffic",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Tráfego vindo de IAs"
        },
        {
          "@language": "en",
          "@value": "AI Referral Traffic"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Visitas ao site originadas de cliques em respostas de IA (chatgpt.com, perplexity.ai, gemini.google.com, copilot). Medido por referência e parâmetros como utm_source=chatgpt.com."
        },
        {
          "@language": "en",
          "@value": "Site visits from clicks in AI answers (chatgpt.com, perplexity.ai, gemini.google.com, copilot). Measured by referrer and parameters such as utm_source=chatgpt.com."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#skyscraper-technique",
      "termCode": "skyscraper-technique",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Técnica arranha-céu"
        },
        {
          "@language": "en",
          "@value": "Skyscraper Technique"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Método de link building popularizado por Brian Dean (Backlinko): achar o conteúdo que mais recebe links num tema, publicar uma versão claramente melhor e oferecê-la a quem linkou o original."
        },
        {
          "@language": "en",
          "@value": "Link-building method popularized by Brian Dean (Backlinko): find the content that earns the most links on a topic, publish a clearly better version and offer it to those who linked to the original."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#unit-of-analysis",
      "termCode": "unit-of-analysis",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Unidade de análise"
        },
        {
          "@language": "en",
          "@value": "Unit of Analysis"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "O que se conta em cada medição: a resposta, a pergunta, a citação ou a sessão. Trocar a unidade muda o resultado e precisa estar declarado."
        },
        {
          "@language": "en",
          "@value": "What is counted in each measurement: the answer, the question, the citation or the session. Changing the unit changes the result and must be stated."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#canonical-url",
      "termCode": "canonical-url",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "URL canônica"
        },
        {
          "@language": "en",
          "@value": "Canonical URL"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Versão preferida de uma página entre várias URLs com conteúdo igual ou muito parecido, indicada com rel=\"canonical\". É uma sugestão; o buscador pode escolher outra."
        },
        {
          "@language": "en",
          "@value": "Preferred version of a page among several URLs with the same or very similar content, indicated with rel=\"canonical\". It is a hint; the search engine may choose another."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/consolidate-duplicate-urls"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cited-url",
      "termCode": "cited-url",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "URL citada"
        },
        {
          "@language": "en",
          "@value": "Cited URL"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Endereço exato que a IA usou como fonte numa resposta. Mostra quais páginas do site, ou de terceiros, estão de fato sustentando o que a IA diz."
        },
        {
          "@language": "en",
          "@value": "Exact address the AI used as a source in an answer. It shows which pages, on the site or elsewhere, actually support what the AI says."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#computer-use",
      "termCode": "computer-use",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Uso do computador"
        },
        {
          "@language": "en",
          "@value": "Computer Use"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Capacidade de um modelo operar telas como uma pessoa: ver capturas, mover o mouse, clicar e digitar."
        },
        {
          "@language": "en",
          "@value": "A model's ability to operate screens like a person: viewing screenshots, moving the mouse, clicking and typing."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#usuario-nao-linear",
      "termCode": "usuario-nao-linear",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Usuário Não-Linear"
        },
        {
          "@language": "en",
          "@value": "Non-linear User"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Limite metodológico declarado por Raphael Sousa Pereira: auditorias de presença em IA testam perguntas isoladas, neutras e sem histórico, mas quase nenhum usuário real interage assim. É uma lacuna de toda avaliação padronizada, não resolvida."
        },
        {
          "@language": "en",
          "@value": "Methodological limit stated by Raphael Sousa Pereira: AI-presence audits test isolated, neutral questions with no history, but almost no real user interacts that way. It is an unresolved gap in every standardized evaluation."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/o-usuario-nao-linear-o-limite-declarado-de-query-sets-em-auditoria-de-geo/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#link-equity",
      "termCode": "link-equity",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Valor de link"
        },
        {
          "@language": "en",
          "@value": "Link Equity (Link Juice)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Valor de autoridade que um link passa para a página de destino, dependente da página de origem, do contexto e da posição do link."
        },
        {
          "@language": "en",
          "@value": "Authority value a link passes to the target page, depending on the source page, the context and the link's position."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ltv",
      "termCode": "ltv",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Valor do tempo de vida do cliente"
        },
        {
          "@language": "en",
          "@value": "Customer Lifetime Value (LTV)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Receita, ou margem, que um cliente gera ao longo de todo o relacionamento. Comparado ao CAC, mostra quanto vale a pena pagar para conquistar cada cliente."
        },
        {
          "@language": "en",
          "@value": "Revenue, or margin, a customer generates over the whole relationship. Compared with CAC, it shows how much it is worth paying to win each customer."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#response-variance",
      "termCode": "response-variance",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Variância das respostas"
        },
        {
          "@language": "en",
          "@value": "Response Variance"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "As respostas de IA mudam entre execuções da mesma pergunta. Medições sérias repetem cada pergunta várias vezes e informam a margem de variação."
        },
        {
          "@language": "en",
          "@value": "AI answers change between runs of the same question. Serious measurement repeats each question several times and reports the margin of variation."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#vibe-coding",
      "termCode": "vibe-coding",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Vibe coding"
        },
        {
          "@language": "en",
          "@value": "Vibe Coding"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Programar descrevendo o que se quer em linguagem natural e aceitando o código gerado pela IA, quase sem lê-lo. Termo criado por Andrej Karpathy em 2025. Funciona para protótipos e é arriscado em produção."
        },
        {
          "@language": "en",
          "@value": "Programming by describing what you want in natural language and accepting the AI-generated code, barely reading it. Term coined by Andrej Karpathy in 2025. It works for prototypes and is risky in production."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-visibility",
      "termCode": "ai-visibility",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Visibilidade em IA"
        },
        {
          "@language": "en",
          "@value": "AI Visibility"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quanto e como uma marca aparece nas respostas de IA para um conjunto de perguntas: presença, posição, citação, sentimento e exatidão."
        },
        {
          "@language": "en",
          "@value": "How much and how a brand appears in AI answers for a set of questions: presence, position, citation, sentiment and accuracy."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-overviews",
      "termCode": "ai-overviews",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Visão geral criada por IA"
        },
        {
          "@language": "en",
          "@value": "AI Overviews"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Resumo gerado pelo Gemini no topo de parte dos resultados do Google, com links para as fontes. Chegou ao Brasil em 2024."
        },
        {
          "@language": "en",
          "@value": "Gemini-generated summary at the top of some Google results, with links to its sources. It reached Brazil in 2024."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/ai-features"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ann-search",
      "termCode": "ann-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Vizinho mais próximo aproximado"
        },
        {
          "@language": "en",
          "@value": "Approximate Nearest Neighbor (ANN)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Algoritmos (como HNSW) que encontram rapidamente embeddings próximos aceitando pequena imprecisão, essenciais para buscar entre milhões de vetores."
        },
        {
          "@language": "en",
          "@value": "Algorithms (such as HNSW) that quickly find nearby embeddings at the cost of slight imprecision, essential for searching millions of vectors."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/1603.09320"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#bias",
      "termCode": "bias",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Viés"
        },
        {
          "@language": "en",
          "@value": "Bias"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Distorção sistemática nas respostas do modelo, herdada dos dados ou do treino, que favorece ou prejudica grupos, marcas ou pontos de vista."
        },
        {
          "@language": "en",
          "@value": "Systematic distortion in a model's answers, inherited from data or training, that favors or harms groups, brands or viewpoints."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#search-volume",
      "termCode": "search-volume",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Volume de busca"
        },
        {
          "@language": "en",
          "@value": "Search Volume"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Estimativa de quantas vezes uma consulta é feita em um período e região. É uma estimativa das ferramentas, não um dado exato do buscador."
        },
        {
          "@language": "en",
          "@value": "Estimate of how often a query is searched in a given period and region. Tools estimate it; it is not an exact figure from the search engine."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#prompt-volume",
      "termCode": "prompt-volume",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Volume de prompts"
        },
        {
          "@language": "en",
          "@value": "Prompt Volume"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Estimativa de quantas vezes um tema é perguntado em assistentes de IA. Diferente do volume de busca, não há dado oficial; ferramentas estimam por painéis e modelagem."
        },
        {
          "@language": "en",
          "@value": "Estimate of how often a topic is asked in AI assistants. Unlike search volume, there is no official data; tools estimate it from panels and modeling."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#wikidata",
      "termCode": "wikidata",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Wikidata"
        },
        {
          "@language": "en",
          "@value": "Wikidata"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Base aberta de dados estruturados da Wikimedia, com um identificador (Q-ID) por entidade. É fonte usada por buscadores e por modelos para reconhecer entidades."
        },
        {
          "@language": "en",
          "@value": "Wikimedia's open structured database, with one identifier (Q-ID) per entity. Search engines and models use it to recognize entities."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.wikidata.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cbci",
      "termCode": "cbci",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Índice de Citabilidade de Conteúdo da Marca (CBCI)"
        },
        {
          "@language": "en",
          "@value": "Content Brand Citability Index (CBCI)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Índice experimental de Raphael Sousa Pereira que avalia a relação entre arquitetura de conteúdo, clareza de entidade e potencial de citação por LLMs, considerando definição de entidade, consistência semântica, claims verificáveis, blocos autocontidos, dados estruturados, autoridade temática, fontes externas e alinhamento entre texto visível e schema."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's experimental index assessing the relationship between content architecture, entity clarity and citation potential in LLMs, considering entity definition, semantic consistency, verifiable claims, self-contained blocks, structured data, topical authority, external sources and alignment between visible text and schema."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/ferramentas/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#indice-de-coerencia-semantica",
      "termCode": "indice-de-coerencia-semantica",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Índice de Coerência Semântica (ICS)"
        },
        {
          "@language": "en",
          "@value": "Semantic Coherence Index (ICS)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Índice de Raphael Sousa Pereira: entidades confirmadas em três ou mais vetores independentes divididas pelo total de entidades centrais. De 0 a 30% é baixo; de 86 a 100%, excelente."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's index: entities confirmed in three or more independent vectors divided by the total of core entities. From 0 to 30% is low; from 86 to 100%, excellent."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/fisica-semantica-raphael-sousa-pereira/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#hallucination-integrity-index",
      "termCode": "hallucination-integrity-index",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Índice de Integridade contra Alucinação (HII)"
        },
        {
          "@language": "en",
          "@value": "Hallucination Integrity Index (HII)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Índice de 0 a 1000 proposto por Raphael Sousa Pereira, em estágio de proposta, que consolida quatro métricas ponderadas pela gravidade do erro: Entity Fidelity Rate, Claim Support Rate, Citation Entailment Rate e Temporal Accuracy Rate."
        },
        {
          "@language": "en",
          "@value": "Index from 0 to 1000 proposed by Raphael Sousa Pereira, at proposal stage, that consolidates four metrics weighted by error severity: Entity Fidelity Rate, Claim Support Rate, Citation Entailment Rate and Temporal Accuracy Rate."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/como-reduzir-alucinacoes-de-ia-sobre-sua-empresa-em-2026/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#sitemap-index",
      "termCode": "sitemap-index",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Índice de sitemaps"
        },
        {
          "@language": "en",
          "@value": "Sitemap Index"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Arquivo que lista vários sitemaps XML, usado quando o site passa do limite de 50 mil URLs ou 50 MB por sitemap ou quer separar sitemaps por tipo de conteúdo."
        },
        {
          "@language": "en",
          "@value": "File listing several XML sitemaps, used when a site exceeds the limit of 50,000 URLs or 50 MB per sitemap or wants separate sitemaps by content type."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.sitemaps.org/protocol.html"
    }
  ]
}
