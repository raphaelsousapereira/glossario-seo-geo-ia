  "author": {
    "@type": "Person",
    "@id": "https://raphaelsousapereira.com.br/#raphael",
    "name": "Raphael Sousa Pereira",
    "description": "Profissional, pesquisador e consultor em Generative Engine Optimization (GEO) e IA aplicada à busca, CEO e fundador da Negócio no Mapa.",
    "worksFor": {
      "@type": "Organization",
      "name": "Negócio no Mapa",
      "url": "https://seonegocionomapa.com.br"
    }
  },
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#citation-absorption",
      "termCode": "citation-absorption",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Absorção da citação"
        },
        {
          "@language": "en",
          "@value": "Citation Absorption"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Etapa, formalizada por Raphael Sousa Pereira, em que o conteúdo efetivo da fonte entra na resposta, distinta da simples citação do link e da fidelidade com que esse conteúdo é reproduzido."
        },
        {
          "@language": "en",
          "@value": "Stage, formalized by Raphael Sousa Pereira, in which the source's actual content enters the answer, distinct from merely citing the link and from how faithfully that content is reproduced."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/transformers-em-2026-como-llms-processam-contexto-e-onde-comeca-o-geo/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#scaled-content-abuse",
      "termCode": "scaled-content-abuse",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Abuso de conteúdo em escala"
        },
        {
          "@language": "en",
          "@value": "Scaled Content Abuse"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Política de spam do Google contra produzir muitas páginas sem valor para manipular ranking, seja com IA, com pessoas ou com automação."
        },
        {
          "@language": "en",
          "@value": "Google spam policy against producing many low-value pages to manipulate rankings, whether by AI, people or automation."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/essentials/spam-policies"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#site-reputation-abuse",
      "termCode": "site-reputation-abuse",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Abuso de reputação do site"
        },
        {
          "@language": "en",
          "@value": "Site Reputation Abuse"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Política do Google contra hospedar conteúdo de terceiros sem supervisão para aproveitar a autoridade de um domínio forte."
        },
        {
          "@language": "en",
          "@value": "Google policy against hosting third-party content without oversight to exploit a strong domain's authority."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/essentials/spam-policies"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#claim",
      "termCode": "claim",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Afirmação"
        },
        {
          "@language": "en",
          "@value": "Claim"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Proposição verificável sobre uma entidade, como \"atende em Porto Alegre\" ou \"fundada em 2016\". É a unidade usada para conferir se a IA repete os fatos certos."
        },
        {
          "@language": "en",
          "@value": "Verifiable proposition about an entity, such as \"serves Porto Alegre\" or \"founded in 2016\". It is the unit used to check whether AI repeats the right facts."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#dated-claim",
      "termCode": "dated-claim",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Afirmação datada"
        },
        {
          "@language": "en",
          "@value": "Dated Claim"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Fato que vale para um momento (\"em 2026\", \"o maior do Brasil\") e precisa de data e revisão. Sem data, a IA pode repetir um fato vencido."
        },
        {
          "@language": "en",
          "@value": "Fact valid for a point in time (\"in 2026\", \"the largest in Brazil\") that needs a date and review. Without one, AI may repeat an expired fact."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-agent",
      "termCode": "ai-agent",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Agente de IA"
        },
        {
          "@language": "en",
          "@value": "AI Agent"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Sistema em que um modelo planeja e executa várias etapas para cumprir um objetivo, usando ferramentas como busca, navegador, código e APIs."
        },
        {
          "@language": "en",
          "@value": "System in which a model plans and carries out several steps toward a goal, using tools such as search, a browser, code and APIs."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#user-agent",
      "termCode": "user-agent",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Agente de usuário"
        },
        {
          "@language": "en",
          "@value": "User-Agent"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Identificação que um navegador ou robô envia em cada requisição HTTP, usada pelo robots.txt e pelos servidores para tratar cada visitante."
        },
        {
          "@language": "en",
          "@value": "Identifier a browser or bot sends with each HTTP request, used by robots.txt and servers to handle each visitor."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#clustering",
      "termCode": "clustering",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Agrupamento"
        },
        {
          "@language": "en",
          "@value": "Clustering"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Técnica que reúne itens parecidos em grupos sem rótulos prévios. Em SEO, é usada para agrupar palavras-chave por tema."
        },
        {
          "@language": "en",
          "@value": "Technique that gathers similar items into groups without prior labels. In SEO it is used to group keywords by topic."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#fine-tuning",
      "termCode": "fine-tuning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Ajuste fino"
        },
        {
          "@language": "en",
          "@value": "Fine-tuning"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Continuar o treino de um modelo pronto com dados específicos para especializá-lo numa tarefa, estilo ou domínio."
        },
        {
          "@language": "en",
          "@value": "Continuing to train an existing model on specific data to specialize it in a task, style or domain."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#instruction-tuning",
      "termCode": "instruction-tuning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Ajuste por instruções"
        },
        {
          "@language": "en",
          "@value": "Instruction Tuning"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ajuste fino com exemplos de pedidos e boas respostas, que ensina o modelo a seguir instruções."
        },
        {
          "@language": "en",
          "@value": "Fine-tuning with examples of requests and good answers, teaching the model to follow instructions."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#algorithm",
      "termCode": "algorithm",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Algoritmo"
        },
        {
          "@language": "en",
          "@value": "Algorithm"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Sequência definida de passos para resolver um problema. No uso comum, \"o algoritmo\" do buscador é o conjunto de sistemas que ordena os resultados."
        },
        {
          "@language": "en",
          "@value": "Defined sequence of steps to solve a problem. In common usage, a search engine's \"algorithm\" is the set of systems that orders results."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#alignment",
      "termCode": "alignment",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Alinhamento"
        },
        {
          "@language": "en",
          "@value": "Alignment"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Trabalho de fazer o modelo agir conforme as intenções e os valores das pessoas: útil, honesto e sem causar dano."
        },
        {
          "@language": "en",
          "@value": "Work of making a model act according to people's intentions and values: helpful, honest and harmless."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#hallucination",
      "termCode": "hallucination",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Alucinação"
        },
        {
          "@language": "en",
          "@value": "Hallucination (Confabulation)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando o modelo afirma com confiança algo falso ou sem base, como fato, número, citação ou fonte inexistente."
        },
        {
          "@language": "en",
          "@value": "When the model confidently states something false or unsupported, such as a fact, figure, quote or nonexistent source."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#paired-sample",
      "termCode": "paired-sample",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Amostra emparelhada"
        },
        {
          "@language": "en",
          "@value": "Paired Sample"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Comparação em que as mesmas perguntas são feitas, nas mesmas plataformas, antes e depois de uma mudança. Reduz o ruído de comparar conjuntos diferentes."
        },
        {
          "@language": "en",
          "@value": "Comparison in which the same questions are asked, on the same platforms, before and after a change. It reduces the noise of comparing different sets."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#content-breadth",
      "termCode": "content-breadth",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Amplitude de conteúdo"
        },
        {
          "@language": "en",
          "@value": "Content Breadth"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quantos aspectos diferentes de um tema o site cobre. Junto com a profundidade, sustenta a autoridade temática."
        },
        {
          "@language": "en",
          "@value": "How many different aspects of a topic a site covers. Together with depth, it supports topical authority."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#grounding",
      "termCode": "grounding",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Ancoragem em fontes"
        },
        {
          "@language": "en",
          "@value": "Grounding"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ligar a resposta do modelo a documentos ou dados verificáveis, recuperados no momento da pergunta, para reduzir invenções e permitir citar a fonte."
        },
        {
          "@language": "en",
          "@value": "Tying the model's answer to verifiable documents or data retrieved at question time, to reduce fabrication and allow citing the source."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#content-gap-analysis",
      "termCode": "content-gap-analysis",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Análise de lacunas de conteúdo"
        },
        {
          "@language": "en",
          "@value": "Content Gap Analysis"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Comparação entre o que concorrentes e fontes já cobrem e o que ninguém responde bem num tema. As lacunas são as melhores oportunidades de ganho de informação."
        },
        {
          "@language": "en",
          "@value": "Comparison between what competitors and sources already cover and what no one answers well on a topic. The gaps are the best information-gain opportunities."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#log-file-analysis",
      "termCode": "log-file-analysis",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Análise de logs"
        },
        {
          "@language": "en",
          "@value": "Log File Analysis"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Leitura dos registros do servidor para ver quais robôs visitaram quais URLs, com que frequência e com que resposta. Mostra o rastreamento real, não o estimado."
        },
        {
          "@language": "en",
          "@value": "Reading server logs to see which bots visited which URLs, how often and with what response. It shows actual crawling, not an estimate."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#self-supervised-learning",
      "termCode": "self-supervised-learning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado autossupervisionado"
        },
        {
          "@language": "en",
          "@value": "Self-supervised Learning"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Treino em que o próprio dado gera o rótulo, como prever a próxima palavra de um texto. É como os LLMs são pré-treinados."
        },
        {
          "@language": "en",
          "@value": "Training in which the data itself provides the label, such as predicting a text's next word. It is how LLMs are pretrained."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#machine-learning",
      "termCode": "machine-learning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado de máquina"
        },
        {
          "@language": "en",
          "@value": "Machine Learning (ML)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ramo da IA em que o sistema aprende padrões a partir de dados, em vez de seguir regras escritas à mão."
        },
        {
          "@language": "en",
          "@value": "Branch of AI in which the system learns patterns from data instead of following hand-written rules."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#unsupervised-learning",
      "termCode": "unsupervised-learning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado não supervisionado"
        },
        {
          "@language": "en",
          "@value": "Unsupervised Learning"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Treino sem rótulos, em que o modelo encontra estruturas nos dados, como grupos de clientes parecidos."
        },
        {
          "@language": "en",
          "@value": "Training without labels, in which the model finds structure in the data, such as groups of similar customers."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#reinforcement-learning",
      "termCode": "reinforcement-learning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado por reforço"
        },
        {
          "@language": "en",
          "@value": "Reinforcement Learning (RL)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Treino por tentativa e erro, em que o modelo recebe recompensas pelas ações e aprende a maximizá-las."
        },
        {
          "@language": "en",
          "@value": "Trial-and-error training in which the model receives rewards for its actions and learns to maximize them."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#rlhf",
      "termCode": "rlhf",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado por reforço com feedback humano"
        },
        {
          "@language": "en",
          "@value": "Reinforcement Learning from Human Feedback (RLHF)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Técnica em que pessoas comparam respostas, um modelo de recompensa aprende essas preferências e o LLM é otimizado para elas."
        },
        {
          "@language": "en",
          "@value": "Technique in which people compare answers, a reward model learns those preferences and the LLM is optimized toward them."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2203.02155"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#deep-learning",
      "termCode": "deep-learning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado profundo"
        },
        {
          "@language": "en",
          "@value": "Deep Learning"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado de máquina com redes neurais de muitas camadas, base dos modelos atuais de linguagem, imagem e voz."
        },
        {
          "@language": "en",
          "@value": "Machine learning with many-layered neural networks, the basis of today's language, image and speech models."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#supervised-learning",
      "termCode": "supervised-learning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado supervisionado"
        },
        {
          "@language": "en",
          "@value": "Supervised Learning"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Treino com exemplos rotulados (entrada e resposta certa), como classificar e-mails em spam ou não spam."
        },
        {
          "@language": "en",
          "@value": "Training with labeled examples (input and correct answer), such as classifying e-mails as spam or not."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#armadilha-do-espelho",
      "termCode": "armadilha-do-espelho",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Armadilha do Espelho"
        },
        {
          "@language": "en",
          "@value": "The Mirror Trap (GEO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Estudo de Raphael Sousa Pereira (preprint no Zenodo, junho de 2026, DOI 10.5281/zenodo.21068730) sobre autopromoção e listas autocitadas como fonte de viés na citação por modelos de linguagem."
        },
        {
          "@language": "en",
          "@value": "Study by Raphael Sousa Pereira (Zenodo preprint, June 2026, DOI 10.5281/zenodo.21068730) on self-promotion and self-cited lists as a source of citation bias in language models."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://raphaelsousapereira.com.br/publicacoes-em-seo-geo/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#site-architecture",
      "termCode": "site-architecture",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Arquitetura do site"
        },
        {
          "@language": "en",
          "@value": "Site Architecture"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Organização das páginas em categorias, hierarquia e links, que define como robôs e pessoas chegam a cada conteúdo."
        },
        {
          "@language": "en",
          "@value": "Organization of pages into categories, hierarchy and links, defining how bots and people reach each piece of content."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#llms-full-txt",
      "termCode": "llms-full-txt",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Arquivo llms-full.txt"
        },
        {
          "@language": "en",
          "@value": "llms-full.txt"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Variante do llms.txt com o conteúdo completo das páginas em Markdown num único arquivo, para ser lido de uma vez por ferramentas de IA."
        },
        {
          "@language": "en",
          "@value": "Variant of llms.txt with the full content of the pages in Markdown in a single file, to be read at once by AI tools."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://llmstxt.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#llms-txt",
      "termCode": "llms-txt",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Arquivo llms.txt"
        },
        {
          "@language": "en",
          "@value": "llms.txt"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Proposta de arquivo em Markdown na raiz do site que resume a marca e lista as páginas mais úteis para modelos de linguagem. Não é padrão oficial e não há confirmação pública de uso pelos grandes buscadores."
        },
        {
          "@language": "en",
          "@value": "Proposed Markdown file at the site root summarizing the brand and listing the most useful pages for language models. It is not an official standard and major search engines have not publicly confirmed using it."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://llmstxt.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#robots-txt",
      "termCode": "robots-txt",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Arquivo robots.txt"
        },
        {
          "@language": "en",
          "@value": "robots.txt"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Arquivo na raiz do site que diz aos robôs quais caminhos podem ou não rastrear. Controla o rastreamento, não a indexação."
        },
        {
          "@language": "en",
          "@value": "File at the site root that tells bots which paths they may or may not crawl. It controls crawling, not indexing."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.rfc-editor.org/rfc/rfc9309"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#people-also-ask",
      "termCode": "people-also-ask",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "As pessoas também perguntam"
        },
        {
          "@language": "en",
          "@value": "People Also Ask (PAA)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Bloco de perguntas relacionadas que se expandem com respostas de diferentes páginas. Boa fonte de perguntas para conteúdo."
        },
        {
          "@language": "en",
          "@value": "Block of related questions that expand into answers from different pages. A good source of questions for content."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-assistant",
      "termCode": "ai-assistant",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Assistente de IA"
        },
        {
          "@language": "en",
          "@value": "AI Assistant"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Produto que usa um modelo de IA para ajudar a pessoa em tarefas, como ChatGPT, Claude, Gemini e Copilot."
        },
        {
          "@language": "en",
          "@value": "Product that uses an AI model to help a person with tasks, such as ChatGPT, Claude, Gemini and Copilot."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-association",
      "termCode": "entity-association",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Associação de entidade"
        },
        {
          "@language": "en",
          "@value": "Entity Association"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ligação que o modelo faz entre a marca e um conceito, como \"agência de GEO em Porto Alegre\". Construída por menções consistentes em várias fontes."
        },
        {
          "@language": "en",
          "@value": "Link a model makes between the brand and a concept, such as \"GEO agency in Porto Alegre\". Built through consistent mentions across many sources."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#source-attribution",
      "termCode": "source-attribution",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Atribuição de fonte"
        },
        {
          "@language": "en",
          "@value": "Source Attribution"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Como o sistema de IA indica de onde veio cada informação: link inline, nota numerada, lista de fontes ou nenhum. Varia por plataforma."
        },
        {
          "@language": "en",
          "@value": "How the AI system shows where each piece of information came from: inline link, numbered note, source list or none. It varies by platform."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#hreflang",
      "termCode": "hreflang",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Atributo hreflang"
        },
        {
          "@language": "en",
          "@value": "hreflang"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Anotação que liga versões da mesma página em idiomas ou países diferentes, para o buscador mostrar a versão certa a cada pessoa."
        },
        {
          "@language": "en",
          "@value": "Annotation linking versions of the same page in different languages or countries, so the search engine shows each person the right version."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/specialty/international/localized-versions"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#nofollow",
      "termCode": "nofollow",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Atributos nofollow, sponsored e ugc"
        },
        {
          "@language": "en",
          "@value": "nofollow / sponsored / ugc"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Atributos de link que dizem ao buscador que o link não deve ser tratado como endosso: nofollow (genérico), sponsored (pago) e ugc (conteúdo de usuário)."
        },
        {
          "@language": "en",
          "@value": "Link attributes telling the search engine not to treat the link as an endorsement: nofollow (generic), sponsored (paid) and ugc (user content)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/qualify-outbound-links"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#content-freshness",
      "termCode": "content-freshness",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Atualidade do conteúdo"
        },
        {
          "@language": "en",
          "@value": "Content Freshness"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quanto o conteúdo está em dia. Pesa mais em consultas sobre fatos que mudam, como preços, leis e notícias, e só conta quando a mudança é real."
        },
        {
          "@language": "en",
          "@value": "How up to date content is. It weighs more for queries about changing facts, such as prices, laws and news, and only counts when the change is real."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#core-update",
      "termCode": "core-update",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Atualização principal"
        },
        {
          "@language": "en",
          "@value": "Core Update"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Mudança ampla nos sistemas de ranqueamento do Google, anunciada algumas vezes por ano, que reavalia a qualidade geral dos sites."
        },
        {
          "@language": "en",
          "@value": "Broad change to Google's ranking systems, announced a few times a year, that reassesses the overall quality of sites."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/updates/core-updates"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#jva-8",
      "termCode": "jva-8",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Auditoria de validação de avaliadores (JVA-8)"
        },
        {
          "@language": "en",
          "@value": "Judge Validation Audit (JVA-8)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo de Raphael Sousa Pereira para validar um LLM usado como avaliador antes de aplicá-lo em auditorias de GEO e de fidelidade de marca. Testa exatidão, concordância, viés de posição, viés de estilo, autopreferência, calibração, discordância e robustez de domínio."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's protocol for validating an LLM used as a judge before applying it in GEO and brand-fidelity audits. It tests accuracy, agreement, position bias, style bias, self-preference, calibration, disagreement and domain robustness."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/llm-as-a-judge-em-2026-como-auditar-avaliadores-de-ia-antes-de-usa-los-para-medir-geo-e-fidelidade-de-marca/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-audit",
      "termCode": "ai-audit",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Auditoria de visibilidade em IA"
        },
        {
          "@language": "en",
          "@value": "AI Visibility Audit"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Diagnóstico de como a marca aparece em várias IAs, das fontes que elas usam e dos erros que repetem, com plano de correção."
        },
        {
          "@language": "en",
          "@value": "Diagnosis of how the brand appears across several AIs, the sources they use and the errors they repeat, with a correction plan."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#self-consistency",
      "termCode": "self-consistency",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Autoconsistência"
        },
        {
          "@language": "en",
          "@value": "Self-consistency"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Gerar várias respostas para a mesma pergunta e ficar com a mais frequente, reduzindo erros aleatórios."
        },
        {
          "@language": "en",
          "@value": "Generating several answers to the same question and keeping the most frequent one, reducing random errors."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2203.11171"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#author-entity",
      "termCode": "author-entity",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Autor como entidade"
        },
        {
          "@language": "en",
          "@value": "Author Entity"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Autor tratado como entidade identificável (Person em schema, página de autor, perfis sameAs, publicações), o que liga o conteúdo à experiência de alguém real."
        },
        {
          "@language": "en",
          "@value": "Author treated as an identifiable entity (Person in schema, author page, sameAs profiles, publications), tying content to a real person's expertise."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#autoridade-canonica-auditavel",
      "termCode": "autoridade-canonica-auditavel",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Autoridade Canônica Auditável"
        },
        {
          "@language": "en",
          "@value": "Auditable Canonical Authority"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Extensão, proposta por Raphael Sousa Pereira, do conceito de mercado de autoridade canônica (definir uma fonte de verdade inequívoca para a IA citar): acrescenta dossiê de integridade verificado por hash, taxonomia de conflito de fontes e protocolo de medição reproduzível. O autor não reivindica o conceito original."
        },
        {
          "@language": "en",
          "@value": "Extension, proposed by Raphael Sousa Pereira, of the market concept of canonical authority (defining an unambiguous source of truth for AI to cite): it adds a hash-verified integrity dossier, a source-conflict taxonomy and a reproducible measurement protocol. The author does not claim the original concept."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/autoridade-canonica-auditavel-para-llms/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#domain-authority",
      "termCode": "domain-authority",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Autoridade de domínio"
        },
        {
          "@language": "en",
          "@value": "Domain Authority (DA, DR, Authority Score)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Nota criada por ferramentas de SEO para estimar a força de um domínio: Domain Authority (Moz), Domain Rating (Ahrefs) e Authority Score (Semrush). Cada ferramenta calcula de um jeito, e nenhuma é métrica do Google."
        },
        {
          "@language": "en",
          "@value": "Score created by SEO tools (Moz, Ahrefs, Semrush) to estimate a domain's link strength. It is not a Google metric."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#autoridade-sintetica",
      "termCode": "autoridade-sintetica",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Autoridade Sintética"
        },
        {
          "@language": "en",
          "@value": "Synthetic Authority"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Termo cunhado por Raphael Sousa Pereira para a autoridade fabricada por páginas que se citam a si mesmas para influenciar respostas de IA: autoridade atribuída pela forma e pela posição de uma página no caminho da resposta, não pela evidência acumulada."
        },
        {
          "@language": "en",
          "@value": "Term coined by Raphael Sousa Pereira for authority manufactured by self-citing pages to influence AI answers: authority granted by a page's form and position on the path to the answer, not by accumulated evidence."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/melhores-agencias-geo-brasil-fontes-ia/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#topical-authority",
      "termCode": "topical-authority",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Autoridade temática"
        },
        {
          "@language": "en",
          "@value": "Topical Authority"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Percepção de que um site cobre um assunto com profundidade e consistência, por meio de muitas páginas relacionadas, bem ligadas e confiáveis."
        },
        {
          "@language": "en",
          "@value": "Perception that a site covers a subject in depth and consistently, through many related, well-linked, trustworthy pages."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#evals",
      "termCode": "evals",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Avaliações (evals)"
        },
        {
          "@language": "en",
          "@value": "Evals"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Testes sistemáticos de um modelo ou sistema de IA com casos definidos e critérios de acerto, usados antes e depois de cada mudança."
        },
        {
          "@language": "en",
          "@value": "Systematic tests of an AI model or system with defined cases and pass criteria, used before and after each change."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#online-reviews",
      "termCode": "online-reviews",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Avaliações online"
        },
        {
          "@language": "en",
          "@value": "Online Reviews"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Notas e comentários de clientes em plataformas como Google, Reclame Aqui e marketplaces. Influenciam o SEO local e o que as IAs dizem sobre a marca."
        },
        {
          "@language": "en",
          "@value": "Customer ratings and comments on platforms such as Google, Reclame Aqui and marketplaces. They influence local SEO and what AI says about the brand."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#manual-action",
      "termCode": "manual-action",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Ação manual"
        },
        {
          "@language": "en",
          "@value": "Manual Action"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Penalidade aplicada por um revisor do Google quando o site viola políticas de spam. Aparece no Search Console e exige correção e pedido de reconsideração."
        },
        {
          "@language": "en",
          "@value": "Penalty applied by a Google reviewer when a site breaks spam policies. It appears in Search Console and requires a fix and a reconsideration request."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://support.google.com/webmasters/answer/9044175"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#backlink",
      "termCode": "backlink",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Backlink (link de entrada)"
        },
        {
          "@language": "en",
          "@value": "Backlink"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Link de outro site apontando para o seu. Links de fontes relevantes e confiáveis contam como voto de confiança."
        },
        {
          "@language": "en",
          "@value": "Link from another site pointing to yours. Links from relevant, trustworthy sources count as a vote of confidence."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#sycophancy",
      "termCode": "sycophancy",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Bajulação"
        },
        {
          "@language": "en",
          "@value": "Sycophancy"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tendência do modelo de concordar com o usuário ou dizer o que ele quer ouvir, mesmo contra os fatos."
        },
        {
          "@language": "en",
          "@value": "A model's tendency to agree with the user or say what they want to hear, even against the facts."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#vector-database",
      "termCode": "vector-database",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Banco de dados vetorial"
        },
        {
          "@language": "en",
          "@value": "Vector Database"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Banco que guarda embeddings e encontra rapidamente os mais próximos de uma consulta. Usado em sistemas RAG."
        },
        {
          "@language": "en",
          "@value": "Database that stores embeddings and quickly finds those closest to a query. Used in RAG systems."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#knowledge-base",
      "termCode": "knowledge-base",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Base de conhecimento"
        },
        {
          "@language": "en",
          "@value": "Knowledge Base"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Coleção organizada de documentos e fatos que um sistema consulta, por exemplo num RAG interno de empresa."
        },
        {
          "@language": "en",
          "@value": "Organized collection of documents and facts a system consults, for example in a company's internal RAG."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#benchmark",
      "termCode": "benchmark",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Benchmark"
        },
        {
          "@language": "en",
          "@value": "Benchmark"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conjunto padronizado de tarefas para comparar modelos. Resultados podem ser inflados se os testes vazaram para os dados de treino."
        },
        {
          "@language": "en",
          "@value": "Standardized set of tasks for comparing models. Results can be inflated if the tests leaked into training data."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#bing-webmaster-tools",
      "termCode": "bing-webmaster-tools",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Bing Webmaster Tools"
        },
        {
          "@language": "en",
          "@value": "Bing Webmaster Tools"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ferramenta da Microsoft equivalente ao Search Console para o Bing, cujo índice também alimenta o Copilot e outros assistentes."
        },
        {
          "@language": "en",
          "@value": "Microsoft's Search Console equivalent for Bing, whose index also feeds Copilot and other assistants."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.bing.com/webmasters"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#brand-led-growth-architecture",
      "termCode": "brand-led-growth-architecture",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Brand-Led Growth Architecture"
        },
        {
          "@language": "en",
          "@value": "Brand-Led Growth Architecture"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Metodologia proprietária da Negócio no Mapa, desenvolvida por Raphael Sousa Pereira, que integra marca, SEO, GEO, conteúdo, reputação, mídia, CRM, automação, dados, conversão e governança numa operação de funil completo, com 6 fases e 16 etapas."
        },
        {
          "@language": "en",
          "@value": "Negócio no Mapa's proprietary methodology, developed by Raphael Sousa Pereira, that integrates brand, SEO, GEO, content, reputation, media, CRM, automation, data, conversion and governance in a full-funnel operation, with 6 phases and 16 steps."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/brand-led-growth-architecture/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-search",
      "termCode": "ai-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca com IA"
        },
        {
          "@language": "en",
          "@value": "AI Search"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Busca em que a resposta é redigida por um modelo de IA a partir de fontes recuperadas, em vez de uma lista de links. Exemplos: ChatGPT Search, Perplexity, Google AI Mode."
        },
        {
          "@language": "en",
          "@value": "Search in which the answer is written by an AI model from retrieved sources instead of a list of links. Examples: ChatGPT Search, Perplexity, Google AI Mode."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#branded-search",
      "termCode": "branded-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca de marca"
        },
        {
          "@language": "en",
          "@value": "Branded Search"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Consulta que contém o nome da marca, sozinho ou com a categoria (\"Negócio no Mapa GEO\"). O volume dessas buscas é um sinal de reconhecimento que nenhuma otimização de página produz sozinha."
        },
        {
          "@language": "en",
          "@value": "Query containing the brand name, alone or with the category (\"Negócio no Mapa GEO\"). Its volume is a recognition signal that no page optimization produces on its own."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#hybrid-search",
      "termCode": "hybrid-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca híbrida"
        },
        {
          "@language": "en",
          "@value": "Hybrid Search"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Combinação de busca lexical e semântica para recuperar documentos que batem tanto nas palavras quanto no sentido."
        },
        {
          "@language": "en",
          "@value": "Combining lexical and semantic search to retrieve documents that match both the words and the meaning."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#lexical-search",
      "termCode": "lexical-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca lexical"
        },
        {
          "@language": "en",
          "@value": "Lexical Search (BM25)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Busca pelas palavras presentes no texto, ponderadas por frequência e raridade, como no algoritmo BM25. Ainda é muito usada, inclusive em RAG."
        },
        {
          "@language": "en",
          "@value": "Search by the words present in the text, weighted by frequency and rarity, as in the BM25 algorithm. Still widely used, including in RAG."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#organic-search",
      "termCode": "organic-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca orgânica"
        },
        {
          "@language": "en",
          "@value": "Organic Search"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Resultados que o buscador ordena por relevância e qualidade, sem pagamento pela posição."
        },
        {
          "@language": "en",
          "@value": "Results a search engine orders by relevance and quality, with no payment for position."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#paid-search",
      "termCode": "paid-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca paga"
        },
        {
          "@language": "en",
          "@value": "Paid Search (SEM/PPC)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Anúncios exibidos na página de resultados em troca de pagamento, normalmente por clique ou impressão."
        },
        {
          "@language": "en",
          "@value": "Ads shown on the results page in exchange for payment, usually per click or impression."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#zero-click-search",
      "termCode": "zero-click-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca sem clique"
        },
        {
          "@language": "en",
          "@value": "Zero-click Search"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Consulta resolvida na própria página de resultados, sem clique para um site, por causa de trechos em destaque, painéis ou respostas geradas por IA."
        },
        {
          "@language": "en",
          "@value": "Query resolved on the results page itself, with no click to a site, because of featured snippets, panels or AI-generated answers."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#semantic-search",
      "termCode": "semantic-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca semântica"
        },
        {
          "@language": "en",
          "@value": "Semantic Search"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Busca pelo significado da consulta, e não só pelas palavras exatas, normalmente com embeddings."
        },
        {
          "@language": "en",
          "@value": "Search by the meaning of the query, not just its exact words, usually with embeddings."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#prompt-caching",
      "termCode": "prompt-caching",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cache de prompt"
        },
        {
          "@language": "en",
          "@value": "Prompt Caching"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Reaproveitar o processamento de um início de prompt repetido entre chamadas, reduzindo custo e latência."
        },
        {
          "@language": "en",
          "@value": "Reusing the processing of a repeated prompt prefix across calls, cutting cost and latency."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#chain-of-thought",
      "termCode": "chain-of-thought",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cadeia de raciocínio"
        },
        {
          "@language": "en",
          "@value": "Chain of Thought (CoT)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Fazer o modelo explicitar passos intermediários antes da resposta final, o que melhora o desempenho em problemas de várias etapas."
        },
        {
          "@language": "en",
          "@value": "Having the model spell out intermediate steps before the final answer, which improves performance on multi-step problems."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2201.11903"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#redirect-chain",
      "termCode": "redirect-chain",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cadeia de redirecionamentos"
        },
        {
          "@language": "en",
          "@value": "Redirect Chain"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Sequência de vários redirecionamentos até a URL final. Desperdiça rastreamento, deixa a página mais lenta e pode fazer o robô desistir."
        },
        {
          "@language": "en",
          "@value": "Sequence of several redirects before the final URL. It wastes crawling, slows the page and may make the bot give up."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#calibration",
      "termCode": "calibration",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Calibração"
        },
        {
          "@language": "en",
          "@value": "Calibration"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quanto a confiança declarada de um modelo bate com a taxa real de acerto. Um modelo bem calibrado que diz 80% acerta cerca de 80% das vezes."
        },
        {
          "@language": "en",
          "@value": "How well a model's stated confidence matches its actual accuracy. A well-calibrated model that says 80% is right about 80% of the time."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#retrieval-layer",
      "termCode": "retrieval-layer",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Camada de recuperação"
        },
        {
          "@language": "en",
          "@value": "Retrieval Layer"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Parte do sistema de IA que busca documentos (na web, num índice próprio ou num banco vetorial) antes da geração. Quem não é recuperado não pode ser citado."
        },
        {
          "@language": "en",
          "@value": "Part of the AI system that fetches documents (from the web, its own index or a vector database) before generation. What is not retrieved cannot be cited."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#semantic-layer",
      "termCode": "semantic-layer",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Camada semântica"
        },
        {
          "@language": "en",
          "@value": "Semantic Layer"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Camada que dá significado comum aos dados de uma organização (o que é um cliente, uma venda, um serviço), para que pessoas, sistemas e IAs usem as mesmas definições."
        },
        {
          "@language": "en",
          "@value": "Layer that gives an organization's data a shared meaning (what a customer, a sale or a service is), so people, systems and AI use the same definitions."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#campo-semantico-digital",
      "termCode": "campo-semantico-digital",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Campo semântico digital"
        },
        {
          "@language": "en",
          "@value": "Digital Semantic Field"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Na Física Semântica, região do espaço de informações em que cada entidade (negócio, pessoa, ideia, produto) tem um peso semântico mensurável, que determina a probabilidade de ser reconhecida, confiada e recomendada por sistemas de IA."
        },
        {
          "@language": "en",
          "@value": "In Semantic Physics, the region of information space in which each entity (business, person, idea, product) has a measurable semantic weight that determines its probability of being recognized, trusted and recommended by AI systems."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/fisica-semantica-raphael-sousa-pereira/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#keyword-cannibalization",
      "termCode": "keyword-cannibalization",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Canibalização de palavras-chave"
        },
        {
          "@language": "en",
          "@value": "Keyword Cannibalization"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando várias páginas do mesmo site disputam a mesma consulta e dividem sinais, e nenhuma se posiciona bem."
        },
        {
          "@language": "en",
          "@value": "When several pages on the same site compete for the same query and split signals, so none ranks well."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#primary-category",
      "termCode": "primary-category",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Categoria principal"
        },
        {
          "@language": "en",
          "@value": "Primary Category"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Categoria escolhida como a principal no Perfil da Empresa. É um dos fatores mais fortes para aparecer em buscas locais."
        },
        {
          "@language": "en",
          "@value": "Category chosen as the main one in the Business Profile. It is among the strongest factors for appearing in local searches."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#function-calling",
      "termCode": "function-calling",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Chamada de funções"
        },
        {
          "@language": "en",
          "@value": "Function Calling (Tool Use)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Capacidade do modelo de pedir a execução de uma função descrita (buscar, consultar API, calcular) e usar o resultado na resposta."
        },
        {
          "@language": "en",
          "@value": "Model's ability to request running a described function (search, query an API, calculate) and use the result in its answer."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#chatbot",
      "termCode": "chatbot",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Chatbot"
        },
        {
          "@language": "en",
          "@value": "Chatbot"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Programa que conversa em linguagem natural. Os atuais usam LLMs e podem buscar na web, ler arquivos e usar ferramentas."
        },
        {
          "@language": "en",
          "@value": "Program that converses in natural language. Current ones use LLMs and can search the web, read files and use tools."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#citability",
      "termCode": "citability",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Citabilidade"
        },
        {
          "@language": "en",
          "@value": "Citability"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quanto um conteúdo está pronto para ser usado e citado por uma IA: acessível aos robôs, com respostas autossuficientes, fatos específicos com fonte e autoria e entidade claras. Prontidão não garante citação."
        },
        {
          "@language": "en",
          "@value": "How ready content is to be used and cited by AI: accessible to bots, with self-contained answers, specific sourced facts and clear authorship and entity. Readiness does not guarantee citation."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#linked-citation",
      "termCode": "linked-citation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Citação com link"
        },
        {
          "@language": "en",
          "@value": "Linked Citation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Citação em que a resposta de IA traz um link clicável para a página de origem. Só ela gera tráfego; uma menção sem link gera reconhecimento, não visita."
        },
        {
          "@language": "en",
          "@value": "Citation in which the AI answer includes a clickable link to the source page. Only this kind generates traffic; a mention without a link builds recognition, not visits."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#local-citation",
      "termCode": "local-citation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Citação local"
        },
        {
          "@language": "en",
          "@value": "Local Citation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Menção ao NAP da empresa em diretórios, guias e sites locais. Reforça a existência e a localização da empresa."
        },
        {
          "@language": "en",
          "@value": "Mention of a business's NAP on directories, guides and local sites. It reinforces the business's existence and location."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-citation",
      "termCode": "ai-citation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Citação por IA"
        },
        {
          "@language": "en",
          "@value": "AI Citation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando uma resposta de IA liga uma afirmação a uma fonte, com link ou nome. É o principal resultado visível de GEO."
        },
        {
          "@language": "en",
          "@value": "When an AI answer ties a claim to a source, by link or by name. It is GEO's main visible outcome."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#claim-saturado",
      "termCode": "claim-saturado",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Claim Saturado"
        },
        {
          "@language": "en",
          "@value": "Saturated Claim"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conceito de Raphael Sousa Pereira para uma afirmação relevante numa categoria que perdeu a capacidade de distinguir uma entidade, porque vários concorrentes podem fazer afirmação equivalente a baixo custo (\"somos especialistas em GEO\"). A saída é o claim estrutural, que aponta para objetos, sistemas e provas que precisam existir."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's concept for a claim relevant to a category that no longer distinguishes an entity, because several competitors can make an equivalent claim cheaply (\"we are GEO experts\"). The way out is the structural claim, which points to objects, systems and proof that must exist."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/claim-saturado-guia-2026-como-criar-citabilidade-em-mercados-competitivos/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cloaking",
      "termCode": "cloaking",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cloaking"
        },
        {
          "@language": "en",
          "@value": "Cloaking"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Mostrar a robôs conteúdo diferente do que as pessoas veem. É spam para buscadores e também engana robôs de IA."
        },
        {
          "@language": "en",
          "@value": "Showing bots different content from what people see. It is spam for search engines and also deceives AI bots."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/essentials/spam-policies"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#topic-cluster",
      "termCode": "topic-cluster",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cluster de tópicos"
        },
        {
          "@language": "en",
          "@value": "Topic Cluster (Hub-and-Spoke)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Organização de conteúdo em uma página pilar sobre um tema amplo, ligada a páginas que aprofundam cada subtema e que devolvem links a ela. Também chamado de modelo hub-and-spoke (eixo e raios)."
        },
        {
          "@language": "en",
          "@value": "Content structure with a pillar page on a broad topic, linked to pages that go deeper into each subtopic."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#headless-cms",
      "termCode": "headless-cms",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "CMS headless"
        },
        {
          "@language": "en",
          "@value": "Headless CMS"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Arquitetura em que o gerenciador de conteúdo só entrega dados e a página é montada por um front-end separado, muitas vezes em JavaScript. Sem renderização no servidor, robôs que não executam JavaScript podem receber uma página vazia."
        },
        {
          "@language": "en",
          "@value": "Architecture in which the content manager only delivers data and the page is built by a separate front end, often in JavaScript. Without server-side rendering, bots that do not run JavaScript may receive an empty page."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#measurement-coverage",
      "termCode": "measurement-coverage",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cobertura da medição"
        },
        {
          "@language": "en",
          "@value": "Measurement Coverage"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quanto do que se queria medir foi de fato medido: plataformas, perguntas, regiões e repetições coletadas com sucesso. Uma nota sem cobertura declarada não pode ser comparada."
        },
        {
          "@language": "en",
          "@value": "How much of what was meant to be measured was actually measured: platforms, questions, regions and repetitions collected successfully. A score without stated coverage cannot be compared."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#co-citation",
      "termCode": "co-citation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cocitação"
        },
        {
          "@language": "en",
          "@value": "Co-citation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando duas entidades aparecem juntas nas mesmas fontes ou respostas. Faz a IA associar a marca a um tema, a uma categoria ou a concorrentes."
        },
        {
          "@language": "en",
          "@value": "When two entities appear together in the same sources or answers. It makes AI associate the brand with a topic, a category or competitors."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#coerencia-de-entidade-distribuida",
      "termCode": "coerencia-de-entidade-distribuida",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Coerência de Entidade Distribuída"
        },
        {
          "@language": "en",
          "@value": "Distributed Entity Coherence"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conceito de Raphael Sousa Pereira para o estado em que as mesmas entidades centrais aparecem, com os mesmos atributos, em vários vetores independentes (site, perfis, diretórios, avaliações, imprensa)."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's concept for the state in which the same core entities appear, with the same attributes, across several independent vectors (site, profiles, directories, reviews, press)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/fisica-semantica-raphael-sousa-pereira/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#things-not-strings",
      "termCode": "things-not-strings",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Coisas, não palavras"
        },
        {
          "@language": "en",
          "@value": "Things, not Strings"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Frase com que o Google lançou o Knowledge Graph em 2012: a busca passa a entender entidades do mundo real (coisas) em vez de apenas casar sequências de caracteres (palavras)."
        },
        {
          "@language": "en",
          "@value": "Phrase with which Google launched the Knowledge Graph in 2012: search starts understanding real-world entities (things) instead of just matching character sequences (strings)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://blog.google/products/search/introducing-knowledge-graph-things-not/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#model-collapse",
      "termCode": "model-collapse",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Colapso de modelo"
        },
        {
          "@language": "en",
          "@value": "Model Collapse"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Perda de qualidade e diversidade quando modelos são treinados repetidamente com conteúdo gerado por outros modelos."
        },
        {
          "@language": "en",
          "@value": "Loss of quality and diversity when models are trained repeatedly on content generated by other models."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#common-crawl",
      "termCode": "common-crawl",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Common Crawl"
        },
        {
          "@language": "en",
          "@value": "Common Crawl"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Organização sem fins lucrativos que publica coletas abertas e periódicas da web, uma das fontes mais usadas no treino de LLMs."
        },
        {
          "@language": "en",
          "@value": "Nonprofit that publishes open, periodic crawls of the web, one of the most used sources for training LLMs."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://commoncrawl.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#test-time-compute",
      "termCode": "test-time-compute",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Computação no momento da resposta"
        },
        {
          "@language": "en",
          "@value": "Test-time Compute"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Gastar mais processamento durante a resposta, por exemplo raciocinando por mais etapas, para obter resultados melhores."
        },
        {
          "@language": "en",
          "@value": "Spending more processing while answering, for example reasoning over more steps, to get better results."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#agentic-commerce",
      "termCode": "agentic-commerce",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Comércio agêntico"
        },
        {
          "@language": "en",
          "@value": "Agentic Commerce"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Compras feitas ou preparadas por agentes de IA em nome da pessoa, que comparam produtos, preenchem formulários e pagam. Exige dados de produto estruturados e processos legíveis por máquina."
        },
        {
          "@language": "en",
          "@value": "Purchases made or prepared by AI agents on a person's behalf, which compare products, fill in forms and pay. It requires structured product data and machine-readable processes."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#source-authority-concentration",
      "termCode": "source-authority-concentration",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Concentração de autoridade de fontes"
        },
        {
          "@language": "en",
          "@value": "Source Authority Concentration"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conceito proposto por Raphael Sousa Pereira: a pergunta relevante deixa de ser \"quantos backlinks eu tenho\" e passa a ser \"em quais ecossistemas de fontes a minha entidade aparece\", porque a citação de reputação de marca vem sobretudo de terceiros."
        },
        {
          "@language": "en",
          "@value": "Concept proposed by Raphael Sousa Pereira: the relevant question shifts from \"how many backlinks do I have\" to \"in which source ecosystems does my entity appear\", because brand-reputation citations come mostly from third parties."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/estado-da-arte-generative-engine-optimization-geo-em-2026-citacao-por-ia/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#parametric-knowledge",
      "termCode": "parametric-knowledge",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conhecimento paramétrico"
        },
        {
          "@language": "en",
          "@value": "Parametric Knowledge"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "O que o modelo \"sabe\" porque aprendeu no treinamento e ficou guardado nos pesos, sem consultar fontes. Fica desatualizado após a data de corte."
        },
        {
          "@language": "en",
          "@value": "What the model \"knows\" from training, stored in its weights, without consulting sources. It goes stale after the cutoff date."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#prompt-set",
      "termCode": "prompt-set",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conjunto de prompts"
        },
        {
          "@language": "en",
          "@value": "Prompt Set (Query Set)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Lista fixa de perguntas usada para medir a visibilidade em IA ao longo do tempo. Precisa representar perguntas reais e ser estável para a comparação valer."
        },
        {
          "@language": "en",
          "@value": "Fixed list of questions used to measure AI visibility over time. It must represent real questions and stay stable for comparisons to hold."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-consistency",
      "termCode": "entity-consistency",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Consistência da entidade"
        },
        {
          "@language": "en",
          "@value": "Entity Consistency"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Mesmo nome, descrição, contato e fatos em todas as fontes (site, schema, perfis, diretórios). Inconsistência faz a IA hesitar ou misturar entidades."
        },
        {
          "@language": "en",
          "@value": "Same name, description, contact details and facts on every source (site, schema, profiles, directories). Inconsistency makes AI hesitate or mix up entities."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#link-building",
      "termCode": "link-building",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Construção de links"
        },
        {
          "@language": "en",
          "@value": "Link Building"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Trabalho de conseguir backlinks relevantes, por exemplo com conteúdo de referência, pesquisa própria, relações públicas e parcerias."
        },
        {
          "@language": "en",
          "@value": "Work of earning relevant backlinks, for example through reference content, original research, public relations and partnerships."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#conversational-query",
      "termCode": "conversational-query",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Consulta conversacional"
        },
        {
          "@language": "en",
          "@value": "Conversational Query"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Pergunta longa em linguagem natural, com contexto e restrições, típica de chatbots (\"qual o melhor dentista infantil na zona sul de Porto Alegre que atenda convênio?\")."
        },
        {
          "@language": "en",
          "@value": "Long natural-language question with context and constraints, typical of chatbots (\"which is the best pediatric dentist in southern Porto Alegre that takes insurance?\")."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#grounding-query",
      "termCode": "grounding-query",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Consulta de fundamentação"
        },
        {
          "@language": "en",
          "@value": "Grounding Query"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Busca que o próprio sistema de IA faz na web ou num índice para ancorar a resposta. Pode ser bem diferente da pergunta do usuário, e é ela que decide quais páginas são lidas."
        },
        {
          "@language": "en",
          "@value": "Search the AI system itself runs on the web or an index to ground its answer. It can differ greatly from the user's question, and it decides which pages get read."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#data-contamination",
      "termCode": "data-contamination",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Contaminação de dados"
        },
        {
          "@language": "en",
          "@value": "Data Contamination"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando questões de um teste estavam nos dados de treino, fazendo o modelo parecer melhor do que é."
        },
        {
          "@language": "en",
          "@value": "When test questions were in the training data, making the model look better than it is."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#qualified-lead",
      "termCode": "qualified-lead",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Contato qualificado"
        },
        {
          "@language": "en",
          "@value": "Qualified Lead"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Contato que atende aos critérios definidos de potencial cliente (perfil, necessidade, orçamento, região). Medir só contatos qualificados evita confundir volume com resultado."
        },
        {
          "@language": "en",
          "@value": "Contact that meets the defined criteria for a potential customer (profile, need, budget, region). Measuring only qualified leads avoids confusing volume with results."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ten-x-content",
      "termCode": "ten-x-content",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo 10x"
        },
        {
          "@language": "en",
          "@value": "10x Content"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Expressão popularizada por Rand Fishkin para conteúdo dez vezes melhor que o melhor resultado atual. Para IAs, o que conta é trazer informação nova, não só ser mais longo."
        },
        {
          "@language": "en",
          "@value": "Phrase popularized by Rand Fishkin for content ten times better than the best current result. For AI, what counts is bringing new information, not just being longer."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#comparison-content",
      "termCode": "comparison-content",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo comparativo"
        },
        {
          "@language": "en",
          "@value": "Comparison Content"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Páginas que comparam opções com critérios claros (X vs. Y, alternativas a Z). Atendem a perguntas de decisão, muito comuns em assistentes de IA."
        },
        {
          "@language": "en",
          "@value": "Pages comparing options with clear criteria (X vs. Y, alternatives to Z). They serve decision questions, very common in AI assistants."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#duplicate-content",
      "termCode": "duplicate-content",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo duplicado"
        },
        {
          "@language": "en",
          "@value": "Duplicate Content"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo igual ou quase igual acessível em mais de uma URL. Em geral não gera punição, mas divide sinais e faz o buscador escolher qual versão mostrar."
        },
        {
          "@language": "en",
          "@value": "Identical or near-identical content reachable at more than one URL. It usually brings no penalty, but it splits signals and makes the search engine choose which version to show."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#user-generated-content",
      "termCode": "user-generated-content",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo gerado pelo usuário"
        },
        {
          "@language": "en",
          "@value": "User-generated Content (UGC)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo publicado por usuários, como avaliações, comentários e fóruns. Links nele devem levar rel=\"ugc\". Fóruns como o Reddit são muito citados por IAs."
        },
        {
          "@language": "en",
          "@value": "Content published by users, such as reviews, comments and forums. Links in it should carry rel=\"ugc\". Forums such as Reddit are heavily cited by AI."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#thin-content",
      "termCode": "thin-content",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo raso"
        },
        {
          "@language": "en",
          "@value": "Thin Content"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página com pouco valor próprio: texto curto e genérico, conteúdo copiado ou gerado em massa sem informação nova."
        },
        {
          "@language": "en",
          "@value": "Page with little value of its own: short, generic text, copied content or mass-generated content with no new information."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#helpful-content",
      "termCode": "helpful-content",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo útil"
        },
        {
          "@language": "en",
          "@value": "Helpful Content"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Orientação do Google para conteúdo feito para pessoas, com experiência e informação original, e não para manipular ranking. Desde 2024 faz parte do sistema principal de ranqueamento."
        },
        {
          "@language": "en",
          "@value": "Google guidance for content made for people, with first-hand experience and original information, not to manipulate rankings. Since 2024 it is part of the core ranking system."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/fundamentals/creating-helpful-content"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#assisted-conversion",
      "termCode": "assisted-conversion",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conversão assistida"
        },
        {
          "@language": "en",
          "@value": "Assisted Conversion"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conversão em que um canal participou da jornada sem ser o último clique. A busca orgânica e as IAs costumam aparecer mais como assistentes do que como fechamento."
        },
        {
          "@language": "en",
          "@value": "Conversion in which a channel took part in the journey without being the last click. Organic search and AI tend to appear more as assists than as closers."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#core-web-vitals",
      "termCode": "core-web-vitals",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Core Web Vitals"
        },
        {
          "@language": "en",
          "@value": "Core Web Vitals"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Três métricas do Google para a experiência real na página: LCP (carregamento), INP (resposta à interação) e CLS (estabilidade visual)."
        },
        {
          "@language": "en",
          "@value": "Google's three metrics for real page experience: LCP (loading), INP (interaction response) and CLS (visual stability)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://web.dev/articles/vitals"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#external-corroboration",
      "termCode": "external-corroboration",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Corroboração externa"
        },
        {
          "@language": "en",
          "@value": "External Corroboration"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Confirmação de um fato sobre a entidade por fontes independentes dela, como imprensa, registros públicos e bases de terceiros. Fato só confirmado pela própria marca vale pouco para buscadores e IAs."
        },
        {
          "@language": "en",
          "@value": "Confirmation of a fact about the entity by sources independent of it, such as press, public records and third-party databases. A fact confirmed only by the brand itself counts for little with search engines and AI."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cac",
      "termCode": "cac",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Custo de aquisição de cliente"
        },
        {
          "@language": "en",
          "@value": "Customer Acquisition Cost (CAC)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Total gasto em marketing e vendas num período dividido pelo número de clientes novos no mesmo período."
        },
        {
          "@language": "en",
          "@value": "Total marketing and sales spend in a period divided by the number of new customers in that period."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cost-per-task",
      "termCode": "cost-per-task",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Custo por tarefa"
        },
        {
          "@language": "en",
          "@value": "Cost per Task"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Custo total para um agente de IA concluir uma tarefa (tokens, chamadas de ferramenta, tentativas e revisão humana). É a métrica certa para comparar automações, mais que o preço por token."
        },
        {
          "@language": "en",
          "@value": "Total cost for an AI agent to complete a task (tokens, tool calls, retries and human review). It is the right metric for comparing automations, more than the price per token."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#answer-capsule",
      "termCode": "answer-capsule",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cápsula de resposta"
        },
        {
          "@language": "en",
          "@value": "Answer Capsule"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Parágrafo curto e autossuficiente logo depois de um heading, que responde a pergunta do título sem depender do resto da página. É a unidade que a IA mais facilmente extrai e cita."
        },
        {
          "@language": "en",
          "@value": "Short, self-contained paragraph right after a heading that answers the heading's question without depending on the rest of the page. It is the unit AI most easily extracts and cites."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#http-status-code",
      "termCode": "http-status-code",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Código de status HTTP"
        },
        {
          "@language": "en",
          "@value": "HTTP Status Code"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Número de três dígitos que o servidor devolve em cada requisição: 200 (sucesso), 301/302 (redirecionamento), 404/410 (não encontrado) e 5xx (erro do servidor)."
        },
        {
          "@language": "en",
          "@value": "Three-digit number the server returns for each request: 200 (success), 301/302 (redirect), 404/410 (not found) and 5xx (server error)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.rfc-editor.org/rfc/rfc9110"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#codigo-de-etica-geo",
      "termCode": "codigo-de-etica-geo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Código de Ética para GEO"
        },
        {
          "@language": "en",
          "@value": "Code of Ethics for GEO"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Documento de Raphael Sousa Pereira (Brasil, 2026), em oito artigos, sobre o que um profissional de GEO pode e não pode prometer, incluindo o artigo sobre churnalism aplicado a GEO."
        },
        {
          "@language": "en",
          "@value": "Document by Raphael Sousa Pereira (Brazil, 2026), in eight articles, on what a GEO professional may and may not promise, including an article on churnalism applied to GEO."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/codigo-de-etica-para-geo-brasil-2026/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#page-source",
      "termCode": "page-source",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Código-fonte da página"
        },
        {
          "@language": "en",
          "@value": "Page Source (Raw HTML)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "HTML que o servidor entrega antes de qualquer JavaScript rodar, visto em \"Exibir código-fonte\". É o que a maioria dos robôs de IA lê; o que só aparece depois do JavaScript pode não existir para eles."
        },
        {
          "@language": "en",
          "@value": "HTML the server delivers before any JavaScript runs, seen with \"View source\". It is what most AI bots read; what only appears after JavaScript may not exist for them."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#training-data",
      "termCode": "training-data",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Dados de treino"
        },
        {
          "@language": "en",
          "@value": "Training Data"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conjunto de dados usado para treinar o modelo. Para LLMs, inclui grandes coletas da web, livros, código e dados licenciados."
        },
        {
          "@language": "en",
          "@value": "Dataset used to train the model. For LLMs it includes large web crawls, books, code and licensed data."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#structured-data",
      "termCode": "structured-data",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Dados estruturados"
        },
        {
          "@language": "en",
          "@value": "Structured Data"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Informações marcadas em formato padronizado (em geral Schema.org em JSON-LD) que dizem explicitamente a máquinas o que a página descreve."
        },
        {
          "@language": "en",
          "@value": "Information marked up in a standard format (usually Schema.org in JSON-LD) that tells machines explicitly what a page describes."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/structured-data/intro-structured-data"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#synthetic-data",
      "termCode": "synthetic-data",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Dados sintéticos"
        },
        {
          "@language": "en",
          "@value": "Synthetic Data"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Dados gerados por modelos ou simulações, usados para treinar ou testar quando dados reais são escassos ou sensíveis."
        },
        {
          "@language": "en",
          "@value": "Data generated by models or simulations, used for training or testing when real data is scarce or sensitive."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#dark-geo",
      "termCode": "dark-geo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Dark GEO"
        },
        {
          "@language": "en",
          "@value": "Dark GEO"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Padrão de mercado batizado por Raphael Sousa Pereira: o tráfego vindo de IA que não deixa rastro de referência e só pode ser estimado por triangulação de fontes, nunca apresentado como medição direta."
        },
        {
          "@language": "en",
          "@value": "Market pattern named by Raphael Sousa Pereira: traffic from AI that leaves no referrer trace and can only be estimated by triangulating sources, never presented as direct measurement."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/como-conduzir-uma-auditoria-tecnica-de-seo-o-metodo-completo-etapa-por-etapa-guia-2026/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#knowledge-cutoff",
      "termCode": "knowledge-cutoff",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Data de corte do conhecimento"
        },
        {
          "@language": "en",
          "@value": "Knowledge Cutoff"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Data até a qual vão os dados de treino do modelo. Fatos posteriores só entram se o sistema buscar fontes atuais."
        },
        {
          "@language": "en",
          "@value": "Date up to which the model's training data goes. Later facts only come in if the system retrieves current sources."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#lastmod",
      "termCode": "lastmod",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Data de última modificação"
        },
        {
          "@language": "en",
          "@value": "lastmod"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Campo do sitemap XML que informa quando a página mudou de forma relevante. Só ajuda se for verdadeiro e consistente."
        },
        {
          "@language": "en",
          "@value": "XML sitemap field stating when a page last changed meaningfully. It only helps if it is accurate and consistent."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.sitemaps.org/protocol.html"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#deepfake",
      "termCode": "deepfake",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Deepfake"
        },
        {
          "@language": "en",
          "@value": "Deepfake"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Vídeo, áudio ou imagem sintético que imita uma pessoa real de forma convincente."
        },
        {
          "@language": "en",
          "@value": "Synthetic video, audio or image that convincingly imitates a real person."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#defined-term-schema",
      "termCode": "defined-term-schema",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "DefinedTerm e DefinedTermSet"
        },
        {
          "@language": "en",
          "@value": "DefinedTerm / DefinedTermSet"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tipos Schema.org para termos de glossário e o conjunto ao qual pertencem, usados para marcar definições como dados."
        },
        {
          "@language": "en",
          "@value": "Schema.org types for glossary terms and the set they belong to, used to mark up definitions as data."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://schema.org/DefinedTerm"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#measurement-denominator",
      "termCode": "measurement-denominator",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Denominador"
        },
        {
          "@language": "en",
          "@value": "Denominator"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Base sobre a qual uma taxa é calculada, como \"respostas válidas\" ou \"perguntas do conjunto\". Duas taxas com denominadores diferentes não são comparáveis."
        },
        {
          "@language": "en",
          "@value": "Base on which a rate is calculated, such as \"valid answers\" or \"questions in the set\". Two rates with different denominators are not comparable."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-drift",
      "termCode": "entity-drift",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Deriva da entidade"
        },
        {
          "@language": "en",
          "@value": "Entity Drift"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando a descrição que as IAs fazem da marca se afasta dos fatos oficiais com o tempo, por fontes desatualizadas ou contraditórias."
        },
        {
          "@language": "en",
          "@value": "When AI's description of the brand moves away from the official facts over time, through outdated or contradictory sources."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-disambiguation",
      "termCode": "entity-disambiguation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Desambiguação de entidade"
        },
        {
          "@language": "en",
          "@value": "Entity Disambiguation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Deixar claro qual entidade é a sua quando há nomes parecidos, com identificadores, sameAs, descrição distintiva e fatos únicos."
        },
        {
          "@language": "en",
          "@value": "Making clear which entity is yours when names are similar, using identifiers, sameAs, a distinctive description and unique facts."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#query-fan-out",
      "termCode": "query-fan-out",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Desdobramento da consulta"
        },
        {
          "@language": "en",
          "@value": "Query Fan-out"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Técnica em que o sistema de IA divide a pergunta do usuário em várias subconsultas, busca cada uma e junta os resultados na resposta. Uma página pode ser citada por responder uma subconsulta que o usuário nem digitou."
        },
        {
          "@language": "en",
          "@value": "Technique in which the AI system splits the user's question into several subqueries, searches each one and merges the results into the answer. A page can be cited for answering a subquery the user never typed."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#distillation",
      "termCode": "distillation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Destilação de conhecimento"
        },
        {
          "@language": "en",
          "@value": "Knowledge Distillation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Treinar um modelo menor para imitar as respostas de um maior, obtendo desempenho próximo com custo menor."
        },
        {
          "@language": "en",
          "@value": "Training a smaller model to imitate a larger one's outputs, achieving close performance at lower cost."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/1503.02531"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#keyword-difficulty",
      "termCode": "keyword-difficulty",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Dificuldade da palavra-chave"
        },
        {
          "@language": "en",
          "@value": "Keyword Difficulty"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Nota estimada por ferramentas de SEO sobre o esforço necessário para alcançar a primeira página em uma consulta, baseada sobretudo na autoridade dos resultados atuais."
        },
        {
          "@language": "en",
          "@value": "Score estimated by SEO tools for the effort needed to reach page one for a query, based mainly on the authority of the current results."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#noindex",
      "termCode": "noindex",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Diretiva noindex"
        },
        {
          "@language": "en",
          "@value": "noindex"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Instrução em meta tag ou cabeçalho HTTP que pede ao buscador para não incluir a página no índice. Só funciona se o robô puder rastrear a página."
        },
        {
          "@language": "en",
          "@value": "Instruction in a meta tag or HTTP header asking the search engine not to include the page in its index. It only works if the bot can crawl the page."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/block-indexing"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#nosnippet",
      "termCode": "nosnippet",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Diretiva nosnippet"
        },
        {
          "@language": "en",
          "@value": "nosnippet"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Diretiva que impede o buscador de mostrar trecho de texto da página nos resultados, incluindo nos recursos de IA do Google."
        },
        {
          "@language": "en",
          "@value": "Directive that stops the search engine from showing a text snippet of the page in results, including in Google's AI features."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/robots-meta-tag"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cited-domain",
      "termCode": "cited-domain",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Domínio citado"
        },
        {
          "@language": "en",
          "@value": "Cited Domain"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Domínio (site) das fontes citadas nas respostas. Agrupar por domínio mostra quais sites dominam um tema nas IAs e onde a marca precisa estar presente."
        },
        {
          "@language": "en",
          "@value": "Domain (site) of the sources cited in answers. Grouping by domain shows which sites dominate a topic in AI and where the brand needs to be present."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cctld",
      "termCode": "cctld",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Domínio de país"
        },
        {
          "@language": "en",
          "@value": "Country-code Top-level Domain (ccTLD)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Terminação de domínio associada a um país, como .br. Sinaliza ao buscador o país-alvo do site."
        },
        {
          "@language": "en",
          "@value": "Domain ending tied to a country, such as .br. It signals the site's target country to the search engine."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#embedding",
      "termCode": "embedding",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Embedding (vetor semântico)"
        },
        {
          "@language": "en",
          "@value": "Embedding"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Representação de um texto, imagem ou item como lista de números, em que significados parecidos ficam próximos. Base da busca semântica."
        },
        {
          "@language": "en",
          "@value": "Representation of a text, image or item as a list of numbers in which similar meanings lie close together. The basis of semantic search."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/1301.3781"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#service-area-business",
      "termCode": "service-area-business",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Empresa com área de atendimento"
        },
        {
          "@language": "en",
          "@value": "Service-area Business (SAB)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Empresa que atende no endereço do cliente, como encanadores, e pode ocultar o endereço no Perfil da Empresa e declarar as regiões atendidas."
        },
        {
          "@language": "en",
          "@value": "Business that serves customers at their location, such as plumbers, and may hide its address in the Business Profile and list the areas served."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#engenharia-da-presenca-generativa",
      "termCode": "engenharia-da-presenca-generativa",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Engenharia da Presença Generativa"
        },
        {
          "@language": "en",
          "@value": "Generative Presence Engineering"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Disciplina aplicada proposta por Raphael Sousa Pereira para estudar e governar como fontes, entidades, evidências e marcas atravessam recuperação, seleção, uso, atribuição, fidelidade e completude até chegar às respostas de sistemas generativos."
        },
        {
          "@language": "en",
          "@value": "Applied discipline proposed by Raphael Sousa Pereira to study and govern how sources, entities, evidence and brands pass through retrieval, selection, use, attribution, fidelity and completeness on their way to generative systems' answers."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/geo-ficou-pequeno-lancamento-do-livro-engenharia-da-presenca-generativa/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#context-engineering",
      "termCode": "context-engineering",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Engenharia de contexto"
        },
        {
          "@language": "en",
          "@value": "Context Engineering"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Decidir quais informações, ferramentas, histórico e documentos entram na janela de contexto do modelo em cada passo, e em que ordem."
        },
        {
          "@language": "en",
          "@value": "Deciding which information, tools, history and documents enter the model's context window at each step, and in what order."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#gbfa",
      "termCode": "gbfa",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Engenharia de Fidelidade de Marca Generativa (GBFA)"
        },
        {
          "@language": "en",
          "@value": "Generative Brand Fidelity Engineering (GBFA)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Framework de Raphael Sousa Pereira para medir e corrigir a fidelidade com que as IAs descrevem uma marca, com taxonomia de evidência, três tipos de deriva e avaliadores validados antes do uso."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's framework for measuring and correcting how faithfully AI describes a brand, with an evidence taxonomy, three types of drift and judges validated before use."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://raphaelsousapereira.com.br/raphael-sousa-pereira/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#prompt-engineering",
      "termCode": "prompt-engineering",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Engenharia de prompt"
        },
        {
          "@language": "en",
          "@value": "Prompt Engineering"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Prática de escrever e testar prompts para obter respostas melhores e mais estáveis."
        },
        {
          "@language": "en",
          "@value": "Practice of writing and testing prompts to get better, more consistent answers."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity",
      "termCode": "entity",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Entidade"
        },
        {
          "@language": "en",
          "@value": "Entity"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Coisa única e identificável, como pessoa, empresa, lugar, produto ou conceito, com atributos e relações. Buscadores e IAs organizam o conhecimento em entidades, não em palavras."
        },
        {
          "@language": "en",
          "@value": "Unique, identifiable thing, such as a person, company, place, product or concept, with attributes and relationships. Search engines and AI organize knowledge in entities, not words."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-health-score",
      "termCode": "entity-health-score",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Entity Health Score (EHS)"
        },
        {
          "@language": "en",
          "@value": "Entity Health Score (EHS)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Índice de Raphael Sousa Pereira: campos de identidade (como NAP) consistentes divididos pelo total de campos verificados entre as fontes. Mede a coerência na dimensão de identidade estrutural."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's index: consistent identity fields (such as NAP) divided by the total fields checked across sources. It measures coherence in the structural-identity dimension."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/fisica-semantica-raphael-sousa-pereira/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#llm-poisoning",
      "termCode": "llm-poisoning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Envenenamento de dados"
        },
        {
          "@language": "en",
          "@value": "LLM Poisoning (Data Poisoning)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Inserir conteúdo falso ou malicioso em fontes que alimentam treino ou recuperação, para distorcer o que o modelo diz."
        },
        {
          "@language": "en",
          "@value": "Inserting false or malicious content into sources that feed training or retrieval, to distort what the model says."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#equacao-da-entidade-citavel",
      "termCode": "equacao-da-entidade-citavel",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Equação da Entidade Citável (EEC)"
        },
        {
          "@language": "en",
          "@value": "Citable Entity Equation (EEC)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Formalização de Raphael Sousa Pereira, apresentada por ele como hipótese de trabalho, de que a citabilidade de uma entidade é multiplicativa: força da entidade, verificabilidade, relevância contextual e atualidade (EEC = B × V × R × F). A verificabilidade multiplica a confiança de todo o resto; sem prova externa, afirmações autodeclaradas pesam quase nada."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's formalization, presented by him as a working hypothesis, that an entity's citability is multiplicative: entity strength, verifiability, contextual relevance and freshness (EEC = B × V × R × F). Verifiability multiplies the trust in everything else; without external proof, self-declared claims weigh almost nothing."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/a-equacao-da-entidade-citavel/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#answer-first-writing",
      "termCode": "answer-first-writing",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Escrita com a resposta primeiro"
        },
        {
          "@language": "en",
          "@value": "Answer-first Writing"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Estilo em que a resposta direta vem na primeira frase ou parágrafo, antes de contexto, história ou ressalvas, como na pirâmide invertida do jornalismo. Facilita a extração do trecho por buscadores e IAs."
        },
        {
          "@language": "en",
          "@value": "Writing style in which the direct answer comes in the first sentence or paragraph, before context, background or caveats, as in journalism's inverted pyramid. It makes the passage easier for search engines and AI to extract."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#estrategista-de-citacao-de-entidade",
      "termCode": "estrategista-de-citacao-de-entidade",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Estrategista de Citação de Entidade"
        },
        {
          "@language": "en",
          "@value": "Entity Citation Strategist"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Função profissional nomeada por Raphael Sousa Pereira: estruturar entidades (marcas, lugares, métodos, patentes, certificações) para que sejam reconhecidas, desambiguadas e citadas corretamente por sistemas de IA generativa."
        },
        {
          "@language": "en",
          "@value": "Professional role named by Raphael Sousa Pereira: structuring entities (brands, places, methods, patents, certifications) so they are recognized, disambiguated and correctly cited by generative AI systems."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/quem-e-raphael-sousa-pereira-estrategista-de-citacao-de-entidade/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#nist-ai-rmf",
      "termCode": "nist-ai-rmf",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Estrutura de gestão de riscos de IA do NIST"
        },
        {
          "@language": "en",
          "@value": "NIST AI Risk Management Framework"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Guia voluntário do instituto de padrões dos EUA para identificar, medir e gerir riscos de IA, organizado em Governar, Mapear, Medir e Gerir."
        },
        {
          "@language": "en",
          "@value": "Voluntary guide from the US standards institute for identifying, measuring and managing AI risk, organized into Govern, Map, Measure and Manage."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.nist.gov/itl/ai-risk-management-framework"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#heading-structure",
      "termCode": "heading-structure",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Estrutura de headings"
        },
        {
          "@language": "en",
          "@value": "Heading Structure (H1–H6)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Hierarquia de títulos e subtítulos da página. Ajuda pessoas, buscadores e IAs a entender o assunto de cada trecho e a extraí-lo."
        },
        {
          "@language": "en",
          "@value": "Hierarchy of a page's titles and subtitles. It helps people, search engines and AI understand each section's subject and extract it."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#key-event",
      "termCode": "key-event",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Evento principal"
        },
        {
          "@language": "en",
          "@value": "Key Event"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "No GA4, evento marcado como importante para o negócio, como envio de formulário, clique no WhatsApp ou compra. Substituiu o nome \"conversão\" no GA4 em 2024."
        },
        {
          "@language": "en",
          "@value": "In GA4, an event marked as important to the business, such as a form submission, a WhatsApp click or a purchase. It replaced the name \"conversion\" in GA4 in 2024."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://support.google.com/analytics/answer/13128484"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#causal-evidence",
      "termCode": "causal-evidence",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Evidência causal"
        },
        {
          "@language": "en",
          "@value": "Causal Evidence"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Prova de que uma mudança causou um efeito, obtida com experimento controlado ou desenho comparável. Antes e depois, sozinho, mostra só que as duas coisas aconteceram juntas."
        },
        {
          "@language": "en",
          "@value": "Proof that a change caused an effect, obtained through a controlled experiment or comparable design. A before-and-after alone only shows that both things happened together."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#answer-accuracy",
      "termCode": "answer-accuracy",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Exatidão das respostas sobre a marca"
        },
        {
          "@language": "en",
          "@value": "Answer Accuracy (Brand)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Proporção das afirmações de IA sobre a marca que conferem com os fatos oficiais. Mede se a IA fala certo, não só se fala."
        },
        {
          "@language": "en",
          "@value": "Share of AI claims about the brand that match the official facts. It measures whether AI is right, not only whether it speaks."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#page-experience",
      "termCode": "page-experience",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Experiência na página"
        },
        {
          "@language": "en",
          "@value": "Page Experience"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conjunto de sinais sobre como é usar a página: Core Web Vitals, HTTPS, ausência de intersticiais invasivos e boa exibição no celular."
        },
        {
          "@language": "en",
          "@value": "Set of signals about using a page: Core Web Vitals, HTTPS, no intrusive interstitials and good mobile display."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/page-experience"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#e-e-a-t",
      "termCode": "e-e-a-t",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Experiência, especialidade, autoridade e confiabilidade"
        },
        {
          "@language": "en",
          "@value": "E-E-A-T"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Critério das diretrizes dos avaliadores de qualidade do Google: Experience, Expertise, Authoritativeness e Trustworthiness. Não é um sinal único, e sim o que vários sinais tentam refletir."
        },
        {
          "@language": "en",
          "@value": "Criterion in Google's quality rater guidelines: Experience, Expertise, Authoritativeness and Trustworthiness. It is not a single signal but what many signals try to reflect."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/fundamentals/creating-helpful-content"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#explainability",
      "termCode": "explainability",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Explicabilidade"
        },
        {
          "@language": "en",
          "@value": "Explainability (XAI)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Capacidade de entender e mostrar por que um sistema de IA chegou a um resultado."
        },
        {
          "@language": "en",
          "@value": "Ability to understand and show why an AI system reached a result."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#citable-fact",
      "termCode": "citable-fact",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Fato citável"
        },
        {
          "@language": "en",
          "@value": "Citable Fact"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Afirmação específica, verificável e com fonte, como número, data ou definição, que uma IA pode reproduzir com segurança."
        },
        {
          "@language": "en",
          "@value": "Specific, verifiable, sourced claim, such as a figure, date or definition, that AI can reproduce safely."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ranking-factor",
      "termCode": "ranking-factor",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Fator de ranqueamento"
        },
        {
          "@language": "en",
          "@value": "Ranking Factor"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Sinal que o buscador usa para ordenar resultados, como relevância do conteúdo, links, experiência na página e qualidade. O peso exato de cada um não é público."
        },
        {
          "@language": "en",
          "@value": "Signal a search engine uses to order results, such as content relevance, links, page experience and quality. The exact weight of each is not public."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-visibility-tool",
      "termCode": "ai-visibility-tool",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Ferramenta de visibilidade em IA"
        },
        {
          "@language": "en",
          "@value": "AI Visibility Tool"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Software que roda conjuntos de prompts em várias IAs e mede menções, citações, posição e sentimento da marca e dos concorrentes."
        },
        {
          "@language": "en",
          "@value": "Software that runs prompt sets across several AIs and measures mentions, citations, position and sentiment for the brand and competitors."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#faithfulness",
      "termCode": "faithfulness",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Fidelidade"
        },
        {
          "@language": "en",
          "@value": "Faithfulness"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quanto a resposta reproduz o que as fontes dizem, sem distorcer, omitir ou acrescentar. Uma resposta pode ser correta e não ser fiel à fonte citada."
        },
        {
          "@language": "en",
          "@value": "How closely the answer reproduces what the sources say, without distorting, omitting or adding. An answer can be correct without being faithful to the cited source."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#compression-fidelity",
      "termCode": "compression-fidelity",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Fidelidade de compressão"
        },
        {
          "@language": "en",
          "@value": "Compression Fidelity"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Estrutura proposta por Raphael Sousa Pereira para medir quanto do conteúdo essencial continua correto quando uma fonte é resumida por um sistema de IA: fatos que não deveriam sumir nem mudar (Gold Facts) preservados corretamente divididos pelos esperados."
        },
        {
          "@language": "en",
          "@value": "Framework proposed by Raphael Sousa Pereira to measure how much essential content stays correct when an AI system summarizes a source: facts that should neither disappear nor change (Gold Facts) correctly preserved, divided by those expected."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/transformers-em-2026-como-llms-processam-contexto-e-onde-comeca-o-geo/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#third-party-source",
      "termCode": "third-party-source",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Fonte de terceiros"
        },
        {
          "@language": "en",
          "@value": "Third-party Source"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página fora do controle da marca que fala dela, como notícia, avaliação, verbete ou fórum. IAs tendem a confiar mais nessas fontes do que no site da própria marca."
        },
        {
          "@language": "en",
          "@value": "Page outside the brand's control that talks about it, such as news, a review, an encyclopedia entry or a forum. AI tends to trust these more than the brand's own site."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#chunking",
      "termCode": "chunking",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Fragmentação em trechos"
        },
        {
          "@language": "en",
          "@value": "Chunking"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Divisão de documentos em pedaços menores antes de gerar embeddings, para que a recuperação traga só a parte relevante. Trechos que dependem de outros perdem sentido."
        },
        {
          "@language": "en",
          "@value": "Splitting documents into smaller pieces before creating embeddings, so retrieval returns only the relevant part. Chunks that depend on others lose meaning."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#fisica-semantica",
      "termCode": "fisica-semantica",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Física Semântica"
        },
        {
          "@language": "en",
          "@value": "Semantic Physics"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Teoria proposta por Raphael Sousa Pereira para explicar por que entidades são reconhecidas e citadas por IAs: a confiança que uma IA deposita numa entidade é proporcional à coerência semântica distribuída dessa entidade em fontes independentes. Organizada em axiomas (coerência distribuída, limiar de confiança, entropia semântica)."
        },
        {
          "@language": "en",
          "@value": "Theory proposed by Raphael Sousa Pereira to explain why entities are recognized and cited by AI: the trust an AI places in an entity is proportional to that entity's distributed semantic coherence across independent sources. Organized into axioms (distributed coherence, trust threshold, semantic entropy)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://seonegocionomapa.com.br/fisica-semantica-raphael-sousa-pereira/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#information-gain",
      "termCode": "information-gain",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Ganho de informação"
        },
        {
          "@language": "en",
          "@value": "Information Gain"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "O quanto a página traz de novo em relação ao que já existe sobre o tema: dados próprios, experiência, exemplos e conclusões originais."
        },
        {
          "@language": "en",
          "@value": "How much new the page brings compared with what already exists on the topic: own data, experience, examples and original conclusions."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://patents.google.com/patent/US9990421B2"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#geo-causal",
      "termCode": "geo-causal",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "GEO CAUSAL"
        },
        {
          "@language": "en",
          "@value": "GEO CAUSAL (7 Measurement Levels)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Arquitetura de mensuração de GEO de Raphael Sousa Pereira em sete níveis: visibilidade, recuperação, citação, atribuição, fidelidade, recomendação e resultado de negócio. Tratar qualquer nível isolado, sobretudo o primeiro, como prova de sucesso é o erro mais comum."
        },
        {
          "@language": "en",
          "@value": "Raphael Sousa Pereira's GEO measurement architecture in seven levels: visibility, retrieval, citation, attribution, fidelity, recommendation and business outcome. Treating any single level, especially the first, as proof of success is the most common mistake."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://raphaelsousapereira.com.br/metricas-de-geo/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#geo-score",
      "termCode": "geo-score",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "GEO Score"
        },
        {
          "@language": "en",
          "@value": "GEO Score"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Nota de prontidão de um site para ser lido e citado por IAs, calculada a partir do que ele publica (acesso de robôs, identidade, schema, respostas citáveis, E-E-A-T). Mede prontidão, não garante citação."
        },
        {
          "@language": "en",
          "@value": "Score of a site's readiness to be read and cited by AI, calculated from what it publishes (bot access, identity, schema, citable answers, E-E-A-T). It measures readiness and does not guarantee citation."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#rag",
      "termCode": "rag",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Geração aumentada por recuperação"
        },
        {
          "@language": "en",
          "@value": "Retrieval-Augmented Generation (RAG)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Arquitetura em que o sistema busca documentos relevantes e os entrega ao modelo junto com a pergunta, para que a resposta se baseie neles e possa citá-los. É o mecanismo por trás da maioria das buscas com IA."
        },
        {
          "@language": "en",
          "@value": "Architecture in which the system retrieves relevant documents and hands them to the model with the question, so the answer is based on them and can cite them. It is the mechanism behind most AI search."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2005.11401"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ga4",
      "termCode": "ga4",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Google Analytics 4"
        },
        {
          "@language": "en",
          "@value": "Google Analytics 4 (GA4)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ferramenta de análise do Google baseada em eventos, usada para medir visitas, origem do tráfego e conversões, inclusive o tráfego vindo de IAs."
        },
        {
          "@language": "en",
          "@value": "Google's event-based analytics tool, used to measure visits, traffic sources and conversions, including traffic from AI."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#google-merchant-center",
      "termCode": "google-merchant-center",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Google Merchant Center"
        },
        {
          "@language": "en",
          "@value": "Google Merchant Center"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Plataforma do Google onde lojas enviam o feed de produtos (preço, estoque, frete, avaliações). Alimenta o Google Shopping e as respostas de compra nos recursos de IA do Google."
        },
        {
          "@language": "en",
          "@value": "Google platform where stores submit their product feed (price, stock, shipping, reviews). It feeds Google Shopping and shopping answers in Google's AI features."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
