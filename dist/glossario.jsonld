  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#scaled-content-abuse",
      "termCode": "scaled-content-abuse",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Abuso de conteúdo em escala"
        },
        {
          "@language": "en",
          "@value": "Scaled Content Abuse"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Política de spam do Google contra produzir muitas páginas sem valor para manipular ranking, seja com IA, com pessoas ou com automação."
        },
        {
          "@language": "en",
          "@value": "Google spam policy against producing many low-value pages to manipulate rankings, whether by AI, people or automation."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/essentials/spam-policies"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#site-reputation-abuse",
      "termCode": "site-reputation-abuse",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Abuso de reputação do site"
        },
        {
          "@language": "en",
          "@value": "Site Reputation Abuse"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Política do Google contra hospedar conteúdo de terceiros sem supervisão para aproveitar a autoridade de um domínio forte."
        },
        {
          "@language": "en",
          "@value": "Google policy against hosting third-party content without oversight to exploit a strong domain's authority."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/essentials/spam-policies"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#dated-claim",
      "termCode": "dated-claim",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Afirmação datada"
        },
        {
          "@language": "en",
          "@value": "Dated Claim"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Fato que vale para um momento (\"em 2026\", \"o maior do Brasil\") e precisa de data e revisão. Sem data, a IA pode repetir um fato vencido."
        },
        {
          "@language": "en",
          "@value": "Fact valid for a point in time (\"in 2026\", \"the largest in Brazil\") that needs a date and review. Without one, AI may repeat an expired fact."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-agent",
      "termCode": "ai-agent",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Agente de IA"
        },
        {
          "@language": "en",
          "@value": "AI Agent"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Sistema em que um modelo planeja e executa várias etapas para cumprir um objetivo, usando ferramentas como busca, navegador, código e APIs."
        },
        {
          "@language": "en",
          "@value": "System in which a model plans and carries out several steps toward a goal, using tools such as search, a browser, code and APIs."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#user-agent",
      "termCode": "user-agent",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Agente de usuário"
        },
        {
          "@language": "en",
          "@value": "User-Agent"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Identificação que um navegador ou robô envia em cada requisição HTTP, usada pelo robots.txt e pelos servidores para tratar cada visitante."
        },
        {
          "@language": "en",
          "@value": "Identifier a browser or bot sends with each HTTP request, used by robots.txt and servers to handle each visitor."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#clustering",
      "termCode": "clustering",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Agrupamento"
        },
        {
          "@language": "en",
          "@value": "Clustering"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Técnica que reúne itens parecidos em grupos sem rótulos prévios. Em SEO, é usada para agrupar palavras-chave por tema."
        },
        {
          "@language": "en",
          "@value": "Technique that gathers similar items into groups without prior labels. In SEO it is used to group keywords by topic."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#fine-tuning",
      "termCode": "fine-tuning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Ajuste fino"
        },
        {
          "@language": "en",
          "@value": "Fine-tuning"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Continuar o treino de um modelo pronto com dados específicos para especializá-lo numa tarefa, estilo ou domínio."
        },
        {
          "@language": "en",
          "@value": "Continuing to train an existing model on specific data to specialize it in a task, style or domain."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#instruction-tuning",
      "termCode": "instruction-tuning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Ajuste por instruções"
        },
        {
          "@language": "en",
          "@value": "Instruction Tuning"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ajuste fino com exemplos de pedidos e boas respostas, que ensina o modelo a seguir instruções."
        },
        {
          "@language": "en",
          "@value": "Fine-tuning with examples of requests and good answers, teaching the model to follow instructions."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#algorithm",
      "termCode": "algorithm",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Algoritmo"
        },
        {
          "@language": "en",
          "@value": "Algorithm"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Sequência definida de passos para resolver um problema. No uso comum, \"o algoritmo\" do buscador é o conjunto de sistemas que ordena os resultados."
        },
        {
          "@language": "en",
          "@value": "Defined sequence of steps to solve a problem. In common usage, a search engine's \"algorithm\" is the set of systems that orders results."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#alignment",
      "termCode": "alignment",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Alinhamento"
        },
        {
          "@language": "en",
          "@value": "Alignment"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Trabalho de fazer o modelo agir conforme as intenções e os valores das pessoas: útil, honesto e sem causar dano."
        },
        {
          "@language": "en",
          "@value": "Work of making a model act according to people's intentions and values: helpful, honest and harmless."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#hallucination",
      "termCode": "hallucination",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Alucinação"
        },
        {
          "@language": "en",
          "@value": "Hallucination (Confabulation)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando o modelo afirma com confiança algo falso ou sem base, como fato, número, citação ou fonte inexistente."
        },
        {
          "@language": "en",
          "@value": "When the model confidently states something false or unsupported, such as a fact, figure, quote or nonexistent source."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#grounding",
      "termCode": "grounding",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Ancoragem em fontes"
        },
        {
          "@language": "en",
          "@value": "Grounding"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ligar a resposta do modelo a documentos ou dados verificáveis, recuperados no momento da pergunta, para reduzir invenções e permitir citar a fonte."
        },
        {
          "@language": "en",
          "@value": "Tying the model's answer to verifiable documents or data retrieved at question time, to reduce fabrication and allow citing the source."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#log-file-analysis",
      "termCode": "log-file-analysis",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Análise de logs"
        },
        {
          "@language": "en",
          "@value": "Log File Analysis"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Leitura dos registros do servidor para ver quais robôs visitaram quais URLs, com que frequência e com que resposta. Mostra o rastreamento real, não o estimado."
        },
        {
          "@language": "en",
          "@value": "Reading server logs to see which bots visited which URLs, how often and with what response. It shows actual crawling, not an estimate."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#self-supervised-learning",
      "termCode": "self-supervised-learning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado autossupervisionado"
        },
        {
          "@language": "en",
          "@value": "Self-supervised Learning"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Treino em que o próprio dado gera o rótulo, como prever a próxima palavra de um texto. É como os LLMs são pré-treinados."
        },
        {
          "@language": "en",
          "@value": "Training in which the data itself provides the label, such as predicting a text's next word. It is how LLMs are pretrained."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#machine-learning",
      "termCode": "machine-learning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado de máquina"
        },
        {
          "@language": "en",
          "@value": "Machine Learning (ML)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ramo da IA em que o sistema aprende padrões a partir de dados, em vez de seguir regras escritas à mão."
        },
        {
          "@language": "en",
          "@value": "Branch of AI in which the system learns patterns from data instead of following hand-written rules."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#unsupervised-learning",
      "termCode": "unsupervised-learning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado não supervisionado"
        },
        {
          "@language": "en",
          "@value": "Unsupervised Learning"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Treino sem rótulos, em que o modelo encontra estruturas nos dados, como grupos de clientes parecidos."
        },
        {
          "@language": "en",
          "@value": "Training without labels, in which the model finds structure in the data, such as groups of similar customers."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#reinforcement-learning",
      "termCode": "reinforcement-learning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado por reforço"
        },
        {
          "@language": "en",
          "@value": "Reinforcement Learning (RL)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Treino por tentativa e erro, em que o modelo recebe recompensas pelas ações e aprende a maximizá-las."
        },
        {
          "@language": "en",
          "@value": "Trial-and-error training in which the model receives rewards for its actions and learns to maximize them."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#rlhf",
      "termCode": "rlhf",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado por reforço com feedback humano"
        },
        {
          "@language": "en",
          "@value": "Reinforcement Learning from Human Feedback (RLHF)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Técnica em que pessoas comparam respostas, um modelo de recompensa aprende essas preferências e o LLM é otimizado para elas."
        },
        {
          "@language": "en",
          "@value": "Technique in which people compare answers, a reward model learns those preferences and the LLM is optimized toward them."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2203.02155"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#deep-learning",
      "termCode": "deep-learning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado profundo"
        },
        {
          "@language": "en",
          "@value": "Deep Learning"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado de máquina com redes neurais de muitas camadas, base dos modelos atuais de linguagem, imagem e voz."
        },
        {
          "@language": "en",
          "@value": "Machine learning with many-layered neural networks, the basis of today's language, image and speech models."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#supervised-learning",
      "termCode": "supervised-learning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Aprendizado supervisionado"
        },
        {
          "@language": "en",
          "@value": "Supervised Learning"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Treino com exemplos rotulados (entrada e resposta certa), como classificar e-mails em spam ou não spam."
        },
        {
          "@language": "en",
          "@value": "Training with labeled examples (input and correct answer), such as classifying e-mails as spam or not."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#site-architecture",
      "termCode": "site-architecture",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Arquitetura do site"
        },
        {
          "@language": "en",
          "@value": "Site Architecture"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Organização das páginas em categorias, hierarquia e links, que define como robôs e pessoas chegam a cada conteúdo."
        },
        {
          "@language": "en",
          "@value": "Organization of pages into categories, hierarchy and links, defining how bots and people reach each piece of content."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#llms-full-txt",
      "termCode": "llms-full-txt",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Arquivo llms-full.txt"
        },
        {
          "@language": "en",
          "@value": "llms-full.txt"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Variante do llms.txt com o conteúdo completo das páginas em Markdown num único arquivo, para ser lido de uma vez por ferramentas de IA."
        },
        {
          "@language": "en",
          "@value": "Variant of llms.txt with the full content of the pages in Markdown in a single file, to be read at once by AI tools."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://llmstxt.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#llms-txt",
      "termCode": "llms-txt",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Arquivo llms.txt"
        },
        {
          "@language": "en",
          "@value": "llms.txt"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Proposta de arquivo em Markdown na raiz do site que resume a marca e lista as páginas mais úteis para modelos de linguagem. Não é padrão oficial e não há confirmação pública de uso pelos grandes buscadores."
        },
        {
          "@language": "en",
          "@value": "Proposed Markdown file at the site root summarizing the brand and listing the most useful pages for language models. It is not an official standard and major search engines have not publicly confirmed using it."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://llmstxt.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#robots-txt",
      "termCode": "robots-txt",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Arquivo robots.txt"
        },
        {
          "@language": "en",
          "@value": "robots.txt"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Arquivo na raiz do site que diz aos robôs quais caminhos podem ou não rastrear. Controla o rastreamento, não a indexação."
        },
        {
          "@language": "en",
          "@value": "File at the site root that tells bots which paths they may or may not crawl. It controls crawling, not indexing."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.rfc-editor.org/rfc/rfc9309"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#people-also-ask",
      "termCode": "people-also-ask",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "As pessoas também perguntam"
        },
        {
          "@language": "en",
          "@value": "People Also Ask (PAA)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Bloco de perguntas relacionadas que se expandem com respostas de diferentes páginas. Boa fonte de perguntas para conteúdo."
        },
        {
          "@language": "en",
          "@value": "Block of related questions that expand into answers from different pages. A good source of questions for content."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-assistant",
      "termCode": "ai-assistant",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Assistente de IA"
        },
        {
          "@language": "en",
          "@value": "AI Assistant"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Produto que usa um modelo de IA para ajudar a pessoa em tarefas, como ChatGPT, Claude, Gemini e Copilot."
        },
        {
          "@language": "en",
          "@value": "Product that uses an AI model to help a person with tasks, such as ChatGPT, Claude, Gemini and Copilot."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-association",
      "termCode": "entity-association",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Associação de entidade"
        },
        {
          "@language": "en",
          "@value": "Entity Association"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ligação que o modelo faz entre a marca e um conceito, como \"agência de GEO em Porto Alegre\". Construída por menções consistentes em várias fontes."
        },
        {
          "@language": "en",
          "@value": "Link a model makes between the brand and a concept, such as \"GEO agency in Porto Alegre\". Built through consistent mentions across many sources."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#source-attribution",
      "termCode": "source-attribution",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Atribuição de fonte"
        },
        {
          "@language": "en",
          "@value": "Source Attribution"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Como o sistema de IA indica de onde veio cada informação: link inline, nota numerada, lista de fontes ou nenhum. Varia por plataforma."
        },
        {
          "@language": "en",
          "@value": "How the AI system shows where each piece of information came from: inline link, numbered note, source list or none. It varies by platform."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#hreflang",
      "termCode": "hreflang",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Atributo hreflang"
        },
        {
          "@language": "en",
          "@value": "hreflang"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Anotação que liga versões da mesma página em idiomas ou países diferentes, para o buscador mostrar a versão certa a cada pessoa."
        },
        {
          "@language": "en",
          "@value": "Annotation linking versions of the same page in different languages or countries, so the search engine shows each person the right version."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/specialty/international/localized-versions"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#nofollow",
      "termCode": "nofollow",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Atributos nofollow, sponsored e ugc"
        },
        {
          "@language": "en",
          "@value": "nofollow / sponsored / ugc"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Atributos de link que dizem ao buscador que o link não deve ser tratado como endosso: nofollow (genérico), sponsored (pago) e ugc (conteúdo de usuário)."
        },
        {
          "@language": "en",
          "@value": "Link attributes telling the search engine not to treat the link as an endorsement: nofollow (generic), sponsored (paid) and ugc (user content)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/qualify-outbound-links"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#content-freshness",
      "termCode": "content-freshness",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Atualidade do conteúdo"
        },
        {
          "@language": "en",
          "@value": "Content Freshness"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quanto o conteúdo está em dia. Pesa mais em consultas sobre fatos que mudam, como preços, leis e notícias, e só conta quando a mudança é real."
        },
        {
          "@language": "en",
          "@value": "How up to date content is. It weighs more for queries about changing facts, such as prices, laws and news, and only counts when the change is real."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#core-update",
      "termCode": "core-update",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Atualização principal"
        },
        {
          "@language": "en",
          "@value": "Core Update"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Mudança ampla nos sistemas de ranqueamento do Google, anunciada algumas vezes por ano, que reavalia a qualidade geral dos sites."
        },
        {
          "@language": "en",
          "@value": "Broad change to Google's ranking systems, announced a few times a year, that reassesses the overall quality of sites."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/updates/core-updates"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-audit",
      "termCode": "ai-audit",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Auditoria de visibilidade em IA"
        },
        {
          "@language": "en",
          "@value": "AI Visibility Audit"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Diagnóstico de como a marca aparece em várias IAs, das fontes que elas usam e dos erros que repetem, com plano de correção."
        },
        {
          "@language": "en",
          "@value": "Diagnosis of how the brand appears across several AIs, the sources they use and the errors they repeat, with a correction plan."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#self-consistency",
      "termCode": "self-consistency",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Autoconsistência"
        },
        {
          "@language": "en",
          "@value": "Self-consistency"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Gerar várias respostas para a mesma pergunta e ficar com a mais frequente, reduzindo erros aleatórios."
        },
        {
          "@language": "en",
          "@value": "Generating several answers to the same question and keeping the most frequent one, reducing random errors."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2203.11171"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#author-entity",
      "termCode": "author-entity",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Autor como entidade"
        },
        {
          "@language": "en",
          "@value": "Author Entity"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Autor tratado como entidade identificável (Person em schema, página de autor, perfis sameAs, publicações), o que liga o conteúdo à experiência de alguém real."
        },
        {
          "@language": "en",
          "@value": "Author treated as an identifiable entity (Person in schema, author page, sameAs profiles, publications), tying content to a real person's expertise."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#domain-authority",
      "termCode": "domain-authority",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Autoridade de domínio"
        },
        {
          "@language": "en",
          "@value": "Domain Authority (DA/DR)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Nota criada por ferramentas de SEO (Moz, Ahrefs, Semrush) para estimar a força de links de um domínio. Não é métrica do Google."
        },
        {
          "@language": "en",
          "@value": "Score created by SEO tools (Moz, Ahrefs, Semrush) to estimate a domain's link strength. It is not a Google metric."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#topical-authority",
      "termCode": "topical-authority",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Autoridade temática"
        },
        {
          "@language": "en",
          "@value": "Topical Authority"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Percepção de que um site cobre um assunto com profundidade e consistência, por meio de muitas páginas relacionadas, bem ligadas e confiáveis."
        },
        {
          "@language": "en",
          "@value": "Perception that a site covers a subject in depth and consistently, through many related, well-linked, trustworthy pages."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#evals",
      "termCode": "evals",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Avaliações (evals)"
        },
        {
          "@language": "en",
          "@value": "Evals"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Testes sistemáticos de um modelo ou sistema de IA com casos definidos e critérios de acerto, usados antes e depois de cada mudança."
        },
        {
          "@language": "en",
          "@value": "Systematic tests of an AI model or system with defined cases and pass criteria, used before and after each change."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#online-reviews",
      "termCode": "online-reviews",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Avaliações online"
        },
        {
          "@language": "en",
          "@value": "Online Reviews"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Notas e comentários de clientes em plataformas como Google, Reclame Aqui e marketplaces. Influenciam o SEO local e o que as IAs dizem sobre a marca."
        },
        {
          "@language": "en",
          "@value": "Customer ratings and comments on platforms such as Google, Reclame Aqui and marketplaces. They influence local SEO and what AI says about the brand."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#manual-action",
      "termCode": "manual-action",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Ação manual"
        },
        {
          "@language": "en",
          "@value": "Manual Action"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Penalidade aplicada por um revisor do Google quando o site viola políticas de spam. Aparece no Search Console e exige correção e pedido de reconsideração."
        },
        {
          "@language": "en",
          "@value": "Penalty applied by a Google reviewer when a site breaks spam policies. It appears in Search Console and requires a fix and a reconsideration request."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://support.google.com/webmasters/answer/9044175"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#backlink",
      "termCode": "backlink",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Backlink (link de entrada)"
        },
        {
          "@language": "en",
          "@value": "Backlink"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Link de outro site apontando para o seu. Links de fontes relevantes e confiáveis contam como voto de confiança."
        },
        {
          "@language": "en",
          "@value": "Link from another site pointing to yours. Links from relevant, trustworthy sources count as a vote of confidence."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#sycophancy",
      "termCode": "sycophancy",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Bajulação"
        },
        {
          "@language": "en",
          "@value": "Sycophancy"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tendência do modelo de concordar com o usuário ou dizer o que ele quer ouvir, mesmo contra os fatos."
        },
        {
          "@language": "en",
          "@value": "A model's tendency to agree with the user or say what they want to hear, even against the facts."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#vector-database",
      "termCode": "vector-database",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Banco de dados vetorial"
        },
        {
          "@language": "en",
          "@value": "Vector Database"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Banco que guarda embeddings e encontra rapidamente os mais próximos de uma consulta. Usado em sistemas RAG."
        },
        {
          "@language": "en",
          "@value": "Database that stores embeddings and quickly finds those closest to a query. Used in RAG systems."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#knowledge-base",
      "termCode": "knowledge-base",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Base de conhecimento"
        },
        {
          "@language": "en",
          "@value": "Knowledge Base"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Coleção organizada de documentos e fatos que um sistema consulta, por exemplo num RAG interno de empresa."
        },
        {
          "@language": "en",
          "@value": "Organized collection of documents and facts a system consults, for example in a company's internal RAG."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#benchmark",
      "termCode": "benchmark",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Benchmark"
        },
        {
          "@language": "en",
          "@value": "Benchmark"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conjunto padronizado de tarefas para comparar modelos. Resultados podem ser inflados se os testes vazaram para os dados de treino."
        },
        {
          "@language": "en",
          "@value": "Standardized set of tasks for comparing models. Results can be inflated if the tests leaked into training data."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#bing-webmaster-tools",
      "termCode": "bing-webmaster-tools",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Bing Webmaster Tools"
        },
        {
          "@language": "en",
          "@value": "Bing Webmaster Tools"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ferramenta da Microsoft equivalente ao Search Console para o Bing, cujo índice também alimenta o Copilot e outros assistentes."
        },
        {
          "@language": "en",
          "@value": "Microsoft's Search Console equivalent for Bing, whose index also feeds Copilot and other assistants."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.bing.com/webmasters"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-search",
      "termCode": "ai-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca com IA"
        },
        {
          "@language": "en",
          "@value": "AI Search"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Busca em que a resposta é redigida por um modelo de IA a partir de fontes recuperadas, em vez de uma lista de links. Exemplos: ChatGPT Search, Perplexity, Google AI Mode."
        },
        {
          "@language": "en",
          "@value": "Search in which the answer is written by an AI model from retrieved sources instead of a list of links. Examples: ChatGPT Search, Perplexity, Google AI Mode."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#hybrid-search",
      "termCode": "hybrid-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca híbrida"
        },
        {
          "@language": "en",
          "@value": "Hybrid Search"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Combinação de busca lexical e semântica para recuperar documentos que batem tanto nas palavras quanto no sentido."
        },
        {
          "@language": "en",
          "@value": "Combining lexical and semantic search to retrieve documents that match both the words and the meaning."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#lexical-search",
      "termCode": "lexical-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca lexical"
        },
        {
          "@language": "en",
          "@value": "Lexical Search (BM25)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Busca pelas palavras presentes no texto, ponderadas por frequência e raridade, como no algoritmo BM25. Ainda é muito usada, inclusive em RAG."
        },
        {
          "@language": "en",
          "@value": "Search by the words present in the text, weighted by frequency and rarity, as in the BM25 algorithm. Still widely used, including in RAG."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#organic-search",
      "termCode": "organic-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca orgânica"
        },
        {
          "@language": "en",
          "@value": "Organic Search"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Resultados que o buscador ordena por relevância e qualidade, sem pagamento pela posição."
        },
        {
          "@language": "en",
          "@value": "Results a search engine orders by relevance and quality, with no payment for position."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#paid-search",
      "termCode": "paid-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca paga"
        },
        {
          "@language": "en",
          "@value": "Paid Search (SEM/PPC)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Anúncios exibidos na página de resultados em troca de pagamento, normalmente por clique ou impressão."
        },
        {
          "@language": "en",
          "@value": "Ads shown on the results page in exchange for payment, usually per click or impression."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#zero-click-search",
      "termCode": "zero-click-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca sem clique"
        },
        {
          "@language": "en",
          "@value": "Zero-click Search"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Consulta resolvida na própria página de resultados, sem clique para um site, por causa de trechos em destaque, painéis ou respostas geradas por IA."
        },
        {
          "@language": "en",
          "@value": "Query resolved on the results page itself, with no click to a site, because of featured snippets, panels or AI-generated answers."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#semantic-search",
      "termCode": "semantic-search",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Busca semântica"
        },
        {
          "@language": "en",
          "@value": "Semantic Search"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Busca pelo significado da consulta, e não só pelas palavras exatas, normalmente com embeddings."
        },
        {
          "@language": "en",
          "@value": "Search by the meaning of the query, not just its exact words, usually with embeddings."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#prompt-caching",
      "termCode": "prompt-caching",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cache de prompt"
        },
        {
          "@language": "en",
          "@value": "Prompt Caching"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Reaproveitar o processamento de um início de prompt repetido entre chamadas, reduzindo custo e latência."
        },
        {
          "@language": "en",
          "@value": "Reusing the processing of a repeated prompt prefix across calls, cutting cost and latency."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#chain-of-thought",
      "termCode": "chain-of-thought",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cadeia de raciocínio"
        },
        {
          "@language": "en",
          "@value": "Chain of Thought (CoT)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Fazer o modelo explicitar passos intermediários antes da resposta final, o que melhora o desempenho em problemas de várias etapas."
        },
        {
          "@language": "en",
          "@value": "Having the model spell out intermediate steps before the final answer, which improves performance on multi-step problems."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2201.11903"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#redirect-chain",
      "termCode": "redirect-chain",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cadeia de redirecionamentos"
        },
        {
          "@language": "en",
          "@value": "Redirect Chain"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Sequência de vários redirecionamentos até a URL final. Desperdiça rastreamento, deixa a página mais lenta e pode fazer o robô desistir."
        },
        {
          "@language": "en",
          "@value": "Sequence of several redirects before the final URL. It wastes crawling, slows the page and may make the bot give up."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#calibration",
      "termCode": "calibration",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Calibração"
        },
        {
          "@language": "en",
          "@value": "Calibration"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quanto a confiança declarada de um modelo bate com a taxa real de acerto. Um modelo bem calibrado que diz 80% acerta cerca de 80% das vezes."
        },
        {
          "@language": "en",
          "@value": "How well a model's stated confidence matches its actual accuracy. A well-calibrated model that says 80% is right about 80% of the time."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#retrieval-layer",
      "termCode": "retrieval-layer",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Camada de recuperação"
        },
        {
          "@language": "en",
          "@value": "Retrieval Layer"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Parte do sistema de IA que busca documentos (na web, num índice próprio ou num banco vetorial) antes da geração. Quem não é recuperado não pode ser citado."
        },
        {
          "@language": "en",
          "@value": "Part of the AI system that fetches documents (from the web, its own index or a vector database) before generation. What is not retrieved cannot be cited."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#keyword-cannibalization",
      "termCode": "keyword-cannibalization",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Canibalização de palavras-chave"
        },
        {
          "@language": "en",
          "@value": "Keyword Cannibalization"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando várias páginas do mesmo site disputam a mesma consulta e dividem sinais, e nenhuma se posiciona bem."
        },
        {
          "@language": "en",
          "@value": "When several pages on the same site compete for the same query and split signals, so none ranks well."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#primary-category",
      "termCode": "primary-category",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Categoria principal"
        },
        {
          "@language": "en",
          "@value": "Primary Category"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Categoria escolhida como a principal no Perfil da Empresa. É um dos fatores mais fortes para aparecer em buscas locais."
        },
        {
          "@language": "en",
          "@value": "Category chosen as the main one in the Business Profile. It is among the strongest factors for appearing in local searches."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#function-calling",
      "termCode": "function-calling",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Chamada de funções"
        },
        {
          "@language": "en",
          "@value": "Function Calling (Tool Use)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Capacidade do modelo de pedir a execução de uma função descrita (buscar, consultar API, calcular) e usar o resultado na resposta."
        },
        {
          "@language": "en",
          "@value": "Model's ability to request running a described function (search, query an API, calculate) and use the result in its answer."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#chatbot",
      "termCode": "chatbot",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Chatbot"
        },
        {
          "@language": "en",
          "@value": "Chatbot"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Programa que conversa em linguagem natural. Os atuais usam LLMs e podem buscar na web, ler arquivos e usar ferramentas."
        },
        {
          "@language": "en",
          "@value": "Program that converses in natural language. Current ones use LLMs and can search the web, read files and use tools."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#local-citation",
      "termCode": "local-citation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Citação local"
        },
        {
          "@language": "en",
          "@value": "Local Citation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Menção ao NAP da empresa em diretórios, guias e sites locais. Reforça a existência e a localização da empresa."
        },
        {
          "@language": "en",
          "@value": "Mention of a business's NAP on directories, guides and local sites. It reinforces the business's existence and location."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-citation",
      "termCode": "ai-citation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Citação por IA"
        },
        {
          "@language": "en",
          "@value": "AI Citation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando uma resposta de IA liga uma afirmação a uma fonte, com link ou nome. É o principal resultado visível de GEO."
        },
        {
          "@language": "en",
          "@value": "When an AI answer ties a claim to a source, by link or by name. It is GEO's main visible outcome."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cloaking",
      "termCode": "cloaking",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cloaking"
        },
        {
          "@language": "en",
          "@value": "Cloaking"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Mostrar a robôs conteúdo diferente do que as pessoas veem. É spam para buscadores e também engana robôs de IA."
        },
        {
          "@language": "en",
          "@value": "Showing bots different content from what people see. It is spam for search engines and also deceives AI bots."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/essentials/spam-policies"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#topic-cluster",
      "termCode": "topic-cluster",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cluster de tópicos"
        },
        {
          "@language": "en",
          "@value": "Topic Cluster"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Organização de conteúdo em uma página pilar sobre um tema amplo, ligada a páginas que aprofundam cada subtema."
        },
        {
          "@language": "en",
          "@value": "Content structure with a pillar page on a broad topic, linked to pages that go deeper into each subtopic."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#co-citation",
      "termCode": "co-citation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cocitação"
        },
        {
          "@language": "en",
          "@value": "Co-citation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando duas entidades aparecem juntas nas mesmas fontes ou respostas. Faz a IA associar a marca a um tema, a uma categoria ou a concorrentes."
        },
        {
          "@language": "en",
          "@value": "When two entities appear together in the same sources or answers. It makes AI associate the brand with a topic, a category or competitors."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#model-collapse",
      "termCode": "model-collapse",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Colapso de modelo"
        },
        {
          "@language": "en",
          "@value": "Model Collapse"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Perda de qualidade e diversidade quando modelos são treinados repetidamente com conteúdo gerado por outros modelos."
        },
        {
          "@language": "en",
          "@value": "Loss of quality and diversity when models are trained repeatedly on content generated by other models."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#common-crawl",
      "termCode": "common-crawl",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Common Crawl"
        },
        {
          "@language": "en",
          "@value": "Common Crawl"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Organização sem fins lucrativos que publica coletas abertas e periódicas da web, uma das fontes mais usadas no treino de LLMs."
        },
        {
          "@language": "en",
          "@value": "Nonprofit that publishes open, periodic crawls of the web, one of the most used sources for training LLMs."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://commoncrawl.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#test-time-compute",
      "termCode": "test-time-compute",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Computação no momento da resposta"
        },
        {
          "@language": "en",
          "@value": "Test-time Compute"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Gastar mais processamento durante a resposta, por exemplo raciocinando por mais etapas, para obter resultados melhores."
        },
        {
          "@language": "en",
          "@value": "Spending more processing while answering, for example reasoning over more steps, to get better results."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#agentic-commerce",
      "termCode": "agentic-commerce",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Comércio agêntico"
        },
        {
          "@language": "en",
          "@value": "Agentic Commerce"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Compras feitas ou preparadas por agentes de IA em nome da pessoa, que comparam produtos, preenchem formulários e pagam. Exige dados de produto estruturados e processos legíveis por máquina."
        },
        {
          "@language": "en",
          "@value": "Purchases made or prepared by AI agents on a person's behalf, which compare products, fill in forms and pay. It requires structured product data and machine-readable processes."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#parametric-knowledge",
      "termCode": "parametric-knowledge",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conhecimento paramétrico"
        },
        {
          "@language": "en",
          "@value": "Parametric Knowledge"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "O que o modelo \"sabe\" porque aprendeu no treinamento e ficou guardado nos pesos, sem consultar fontes. Fica desatualizado após a data de corte."
        },
        {
          "@language": "en",
          "@value": "What the model \"knows\" from training, stored in its weights, without consulting sources. It goes stale after the cutoff date."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#prompt-set",
      "termCode": "prompt-set",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conjunto de prompts"
        },
        {
          "@language": "en",
          "@value": "Prompt Set (Query Set)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Lista fixa de perguntas usada para medir a visibilidade em IA ao longo do tempo. Precisa representar perguntas reais e ser estável para a comparação valer."
        },
        {
          "@language": "en",
          "@value": "Fixed list of questions used to measure AI visibility over time. It must represent real questions and stay stable for comparisons to hold."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-consistency",
      "termCode": "entity-consistency",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Consistência da entidade"
        },
        {
          "@language": "en",
          "@value": "Entity Consistency"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Mesmo nome, descrição, contato e fatos em todas as fontes (site, schema, perfis, diretórios). Inconsistência faz a IA hesitar ou misturar entidades."
        },
        {
          "@language": "en",
          "@value": "Same name, description, contact details and facts on every source (site, schema, profiles, directories). Inconsistency makes AI hesitate or mix up entities."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#link-building",
      "termCode": "link-building",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Construção de links"
        },
        {
          "@language": "en",
          "@value": "Link Building"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Trabalho de conseguir backlinks relevantes, por exemplo com conteúdo de referência, pesquisa própria, relações públicas e parcerias."
        },
        {
          "@language": "en",
          "@value": "Work of earning relevant backlinks, for example through reference content, original research, public relations and partnerships."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#conversational-query",
      "termCode": "conversational-query",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Consulta conversacional"
        },
        {
          "@language": "en",
          "@value": "Conversational Query"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Pergunta longa em linguagem natural, com contexto e restrições, típica de chatbots (\"qual o melhor dentista infantil na zona sul de Porto Alegre que atenda convênio?\")."
        },
        {
          "@language": "en",
          "@value": "Long natural-language question with context and constraints, typical of chatbots (\"which is the best pediatric dentist in southern Porto Alegre that takes insurance?\")."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#data-contamination",
      "termCode": "data-contamination",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Contaminação de dados"
        },
        {
          "@language": "en",
          "@value": "Data Contamination"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando questões de um teste estavam nos dados de treino, fazendo o modelo parecer melhor do que é."
        },
        {
          "@language": "en",
          "@value": "When test questions were in the training data, making the model look better than it is."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#comparison-content",
      "termCode": "comparison-content",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo comparativo"
        },
        {
          "@language": "en",
          "@value": "Comparison Content"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Páginas que comparam opções com critérios claros (X vs. Y, alternativas a Z). Atendem a perguntas de decisão, muito comuns em assistentes de IA."
        },
        {
          "@language": "en",
          "@value": "Pages comparing options with clear criteria (X vs. Y, alternatives to Z). They serve decision questions, very common in AI assistants."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#duplicate-content",
      "termCode": "duplicate-content",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo duplicado"
        },
        {
          "@language": "en",
          "@value": "Duplicate Content"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo igual ou quase igual acessível em mais de uma URL. Em geral não gera punição, mas divide sinais e faz o buscador escolher qual versão mostrar."
        },
        {
          "@language": "en",
          "@value": "Identical or near-identical content reachable at more than one URL. It usually brings no penalty, but it splits signals and makes the search engine choose which version to show."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#user-generated-content",
      "termCode": "user-generated-content",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo gerado pelo usuário"
        },
        {
          "@language": "en",
          "@value": "User-generated Content (UGC)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo publicado por usuários, como avaliações, comentários e fóruns. Links nele devem levar rel=\"ugc\". Fóruns como o Reddit são muito citados por IAs."
        },
        {
          "@language": "en",
          "@value": "Content published by users, such as reviews, comments and forums. Links in it should carry rel=\"ugc\". Forums such as Reddit are heavily cited by AI."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#thin-content",
      "termCode": "thin-content",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo raso"
        },
        {
          "@language": "en",
          "@value": "Thin Content"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página com pouco valor próprio: texto curto e genérico, conteúdo copiado ou gerado em massa sem informação nova."
        },
        {
          "@language": "en",
          "@value": "Page with little value of its own: short, generic text, copied content or mass-generated content with no new information."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#helpful-content",
      "termCode": "helpful-content",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo útil"
        },
        {
          "@language": "en",
          "@value": "Helpful Content"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Orientação do Google para conteúdo feito para pessoas, com experiência e informação original, e não para manipular ranking. Desde 2024 faz parte do sistema principal de ranqueamento."
        },
        {
          "@language": "en",
          "@value": "Google guidance for content made for people, with first-hand experience and original information, not to manipulate rankings. Since 2024 it is part of the core ranking system."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/fundamentals/creating-helpful-content"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#core-web-vitals",
      "termCode": "core-web-vitals",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Core Web Vitals"
        },
        {
          "@language": "en",
          "@value": "Core Web Vitals"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Três métricas do Google para a experiência real na página: LCP (carregamento), INP (resposta à interação) e CLS (estabilidade visual)."
        },
        {
          "@language": "en",
          "@value": "Google's three metrics for real page experience: LCP (loading), INP (interaction response) and CLS (visual stability)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://web.dev/articles/vitals"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#answer-capsule",
      "termCode": "answer-capsule",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Cápsula de resposta"
        },
        {
          "@language": "en",
          "@value": "Answer Capsule"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Parágrafo curto e autossuficiente logo depois de um heading, que responde a pergunta do título sem depender do resto da página. É a unidade que a IA mais facilmente extrai e cita."
        },
        {
          "@language": "en",
          "@value": "Short, self-contained paragraph right after a heading that answers the heading's question without depending on the rest of the page. It is the unit AI most easily extracts and cites."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#http-status-code",
      "termCode": "http-status-code",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Código de status HTTP"
        },
        {
          "@language": "en",
          "@value": "HTTP Status Code"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Número de três dígitos que o servidor devolve em cada requisição: 200 (sucesso), 301/302 (redirecionamento), 404/410 (não encontrado) e 5xx (erro do servidor)."
        },
        {
          "@language": "en",
          "@value": "Three-digit number the server returns for each request: 200 (success), 301/302 (redirect), 404/410 (not found) and 5xx (server error)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.rfc-editor.org/rfc/rfc9110"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#training-data",
      "termCode": "training-data",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Dados de treino"
        },
        {
          "@language": "en",
          "@value": "Training Data"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conjunto de dados usado para treinar o modelo. Para LLMs, inclui grandes coletas da web, livros, código e dados licenciados."
        },
        {
          "@language": "en",
          "@value": "Dataset used to train the model. For LLMs it includes large web crawls, books, code and licensed data."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#structured-data",
      "termCode": "structured-data",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Dados estruturados"
        },
        {
          "@language": "en",
          "@value": "Structured Data"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Informações marcadas em formato padronizado (em geral Schema.org em JSON-LD) que dizem explicitamente a máquinas o que a página descreve."
        },
        {
          "@language": "en",
          "@value": "Information marked up in a standard format (usually Schema.org in JSON-LD) that tells machines explicitly what a page describes."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/structured-data/intro-structured-data"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#synthetic-data",
      "termCode": "synthetic-data",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Dados sintéticos"
        },
        {
          "@language": "en",
          "@value": "Synthetic Data"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Dados gerados por modelos ou simulações, usados para treinar ou testar quando dados reais são escassos ou sensíveis."
        },
        {
          "@language": "en",
          "@value": "Data generated by models or simulations, used for training or testing when real data is scarce or sensitive."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#knowledge-cutoff",
      "termCode": "knowledge-cutoff",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Data de corte do conhecimento"
        },
        {
          "@language": "en",
          "@value": "Knowledge Cutoff"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Data até a qual vão os dados de treino do modelo. Fatos posteriores só entram se o sistema buscar fontes atuais."
        },
        {
          "@language": "en",
          "@value": "Date up to which the model's training data goes. Later facts only come in if the system retrieves current sources."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#lastmod",
      "termCode": "lastmod",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Data de última modificação"
        },
        {
          "@language": "en",
          "@value": "lastmod"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Campo do sitemap XML que informa quando a página mudou de forma relevante. Só ajuda se for verdadeiro e consistente."
        },
        {
          "@language": "en",
          "@value": "XML sitemap field stating when a page last changed meaningfully. It only helps if it is accurate and consistent."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.sitemaps.org/protocol.html"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#deepfake",
      "termCode": "deepfake",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Deepfake"
        },
        {
          "@language": "en",
          "@value": "Deepfake"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Vídeo, áudio ou imagem sintético que imita uma pessoa real de forma convincente."
        },
        {
          "@language": "en",
          "@value": "Synthetic video, audio or image that convincingly imitates a real person."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#defined-term-schema",
      "termCode": "defined-term-schema",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "DefinedTerm e DefinedTermSet"
        },
        {
          "@language": "en",
          "@value": "DefinedTerm / DefinedTermSet"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tipos Schema.org para termos de glossário e o conjunto ao qual pertencem, usados para marcar definições como dados."
        },
        {
          "@language": "en",
          "@value": "Schema.org types for glossary terms and the set they belong to, used to mark up definitions as data."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://schema.org/DefinedTerm"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-drift",
      "termCode": "entity-drift",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Deriva da entidade"
        },
        {
          "@language": "en",
          "@value": "Entity Drift"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando a descrição que as IAs fazem da marca se afasta dos fatos oficiais com o tempo, por fontes desatualizadas ou contraditórias."
        },
        {
          "@language": "en",
          "@value": "When AI's description of the brand moves away from the official facts over time, through outdated or contradictory sources."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-disambiguation",
      "termCode": "entity-disambiguation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Desambiguação de entidade"
        },
        {
          "@language": "en",
          "@value": "Entity Disambiguation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Deixar claro qual entidade é a sua quando há nomes parecidos, com identificadores, sameAs, descrição distintiva e fatos únicos."
        },
        {
          "@language": "en",
          "@value": "Making clear which entity is yours when names are similar, using identifiers, sameAs, a distinctive description and unique facts."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#query-fan-out",
      "termCode": "query-fan-out",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Desdobramento da consulta"
        },
        {
          "@language": "en",
          "@value": "Query Fan-out"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Técnica em que o sistema de IA divide a pergunta do usuário em várias subconsultas, busca cada uma e junta os resultados na resposta. Uma página pode ser citada por responder uma subconsulta que o usuário nem digitou."
        },
        {
          "@language": "en",
          "@value": "Technique in which the AI system splits the user's question into several subqueries, searches each one and merges the results into the answer. A page can be cited for answering a subquery the user never typed."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#distillation",
      "termCode": "distillation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Destilação de conhecimento"
        },
        {
          "@language": "en",
          "@value": "Knowledge Distillation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Treinar um modelo menor para imitar as respostas de um maior, obtendo desempenho próximo com custo menor."
        },
        {
          "@language": "en",
          "@value": "Training a smaller model to imitate a larger one's outputs, achieving close performance at lower cost."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/1503.02531"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#keyword-difficulty",
      "termCode": "keyword-difficulty",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Dificuldade da palavra-chave"
        },
        {
          "@language": "en",
          "@value": "Keyword Difficulty"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Nota estimada por ferramentas de SEO sobre o esforço necessário para alcançar a primeira página em uma consulta, baseada sobretudo na autoridade dos resultados atuais."
        },
        {
          "@language": "en",
          "@value": "Score estimated by SEO tools for the effort needed to reach page one for a query, based mainly on the authority of the current results."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#noindex",
      "termCode": "noindex",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Diretiva noindex"
        },
        {
          "@language": "en",
          "@value": "noindex"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Instrução em meta tag ou cabeçalho HTTP que pede ao buscador para não incluir a página no índice. Só funciona se o robô puder rastrear a página."
        },
        {
          "@language": "en",
          "@value": "Instruction in a meta tag or HTTP header asking the search engine not to include the page in its index. It only works if the bot can crawl the page."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/block-indexing"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#nosnippet",
      "termCode": "nosnippet",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Diretiva nosnippet"
        },
        {
          "@language": "en",
          "@value": "nosnippet"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Diretiva que impede o buscador de mostrar trecho de texto da página nos resultados, incluindo nos recursos de IA do Google."
        },
        {
          "@language": "en",
          "@value": "Directive that stops the search engine from showing a text snippet of the page in results, including in Google's AI features."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/robots-meta-tag"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cctld",
      "termCode": "cctld",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Domínio de país"
        },
        {
          "@language": "en",
          "@value": "Country-code Top-level Domain (ccTLD)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Terminação de domínio associada a um país, como .br. Sinaliza ao buscador o país-alvo do site."
        },
        {
          "@language": "en",
          "@value": "Domain ending tied to a country, such as .br. It signals the site's target country to the search engine."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#embedding",
      "termCode": "embedding",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Embedding (vetor semântico)"
        },
        {
          "@language": "en",
          "@value": "Embedding"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Representação de um texto, imagem ou item como lista de números, em que significados parecidos ficam próximos. Base da busca semântica."
        },
        {
          "@language": "en",
          "@value": "Representation of a text, image or item as a list of numbers in which similar meanings lie close together. The basis of semantic search."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/1301.3781"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#service-area-business",
      "termCode": "service-area-business",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Empresa com área de atendimento"
        },
        {
          "@language": "en",
          "@value": "Service-area Business (SAB)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Empresa que atende no endereço do cliente, como encanadores, e pode ocultar o endereço no Perfil da Empresa e declarar as regiões atendidas."
        },
        {
          "@language": "en",
          "@value": "Business that serves customers at their location, such as plumbers, and may hide its address in the Business Profile and list the areas served."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#context-engineering",
      "termCode": "context-engineering",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Engenharia de contexto"
        },
        {
          "@language": "en",
          "@value": "Context Engineering"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Decidir quais informações, ferramentas, histórico e documentos entram na janela de contexto do modelo em cada passo, e em que ordem."
        },
        {
          "@language": "en",
          "@value": "Deciding which information, tools, history and documents enter the model's context window at each step, and in what order."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#prompt-engineering",
      "termCode": "prompt-engineering",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Engenharia de prompt"
        },
        {
          "@language": "en",
          "@value": "Prompt Engineering"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Prática de escrever e testar prompts para obter respostas melhores e mais estáveis."
        },
        {
          "@language": "en",
          "@value": "Practice of writing and testing prompts to get better, more consistent answers."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity",
      "termCode": "entity",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Entidade"
        },
        {
          "@language": "en",
          "@value": "Entity"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Coisa única e identificável, como pessoa, empresa, lugar, produto ou conceito, com atributos e relações. Buscadores e IAs organizam o conhecimento em entidades, não em palavras."
        },
        {
          "@language": "en",
          "@value": "Unique, identifiable thing, such as a person, company, place, product or concept, with attributes and relationships. Search engines and AI organize knowledge in entities, not words."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#llm-poisoning",
      "termCode": "llm-poisoning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Envenenamento de dados"
        },
        {
          "@language": "en",
          "@value": "LLM Poisoning (Data Poisoning)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Inserir conteúdo falso ou malicioso em fontes que alimentam treino ou recuperação, para distorcer o que o modelo diz."
        },
        {
          "@language": "en",
          "@value": "Inserting false or malicious content into sources that feed training or retrieval, to distort what the model says."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#nist-ai-rmf",
      "termCode": "nist-ai-rmf",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Estrutura de gestão de riscos de IA do NIST"
        },
        {
          "@language": "en",
          "@value": "NIST AI Risk Management Framework"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Guia voluntário do instituto de padrões dos EUA para identificar, medir e gerir riscos de IA, organizado em Governar, Mapear, Medir e Gerir."
        },
        {
          "@language": "en",
          "@value": "Voluntary guide from the US standards institute for identifying, measuring and managing AI risk, organized into Govern, Map, Measure and Manage."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.nist.gov/itl/ai-risk-management-framework"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#heading-structure",
      "termCode": "heading-structure",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Estrutura de headings"
        },
        {
          "@language": "en",
          "@value": "Heading Structure (H1–H6)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Hierarquia de títulos e subtítulos da página. Ajuda pessoas, buscadores e IAs a entender o assunto de cada trecho e a extraí-lo."
        },
        {
          "@language": "en",
          "@value": "Hierarchy of a page's titles and subtitles. It helps people, search engines and AI understand each section's subject and extract it."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#answer-accuracy",
      "termCode": "answer-accuracy",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Exatidão das respostas sobre a marca"
        },
        {
          "@language": "en",
          "@value": "Answer Accuracy (Brand)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Proporção das afirmações de IA sobre a marca que conferem com os fatos oficiais. Mede se a IA fala certo, não só se fala."
        },
        {
          "@language": "en",
          "@value": "Share of AI claims about the brand that match the official facts. It measures whether AI is right, not only whether it speaks."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#page-experience",
      "termCode": "page-experience",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Experiência na página"
        },
        {
          "@language": "en",
          "@value": "Page Experience"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conjunto de sinais sobre como é usar a página: Core Web Vitals, HTTPS, ausência de intersticiais invasivos e boa exibição no celular."
        },
        {
          "@language": "en",
          "@value": "Set of signals about using a page: Core Web Vitals, HTTPS, no intrusive interstitials and good mobile display."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/page-experience"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#e-e-a-t",
      "termCode": "e-e-a-t",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Experiência, especialidade, autoridade e confiabilidade"
        },
        {
          "@language": "en",
          "@value": "E-E-A-T"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Critério das diretrizes dos avaliadores de qualidade do Google: Experience, Expertise, Authoritativeness e Trustworthiness. Não é um sinal único, e sim o que vários sinais tentam refletir."
        },
        {
          "@language": "en",
          "@value": "Criterion in Google's quality rater guidelines: Experience, Expertise, Authoritativeness and Trustworthiness. It is not a single signal but what many signals try to reflect."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/fundamentals/creating-helpful-content"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#explainability",
      "termCode": "explainability",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Explicabilidade"
        },
        {
          "@language": "en",
          "@value": "Explainability (XAI)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Capacidade de entender e mostrar por que um sistema de IA chegou a um resultado."
        },
        {
          "@language": "en",
          "@value": "Ability to understand and show why an AI system reached a result."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#citable-fact",
      "termCode": "citable-fact",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Fato citável"
        },
        {
          "@language": "en",
          "@value": "Citable Fact"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Afirmação específica, verificável e com fonte, como número, data ou definição, que uma IA pode reproduzir com segurança."
        },
        {
          "@language": "en",
          "@value": "Specific, verifiable, sourced claim, such as a figure, date or definition, that AI can reproduce safely."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ranking-factor",
      "termCode": "ranking-factor",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Fator de ranqueamento"
        },
        {
          "@language": "en",
          "@value": "Ranking Factor"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Sinal que o buscador usa para ordenar resultados, como relevância do conteúdo, links, experiência na página e qualidade. O peso exato de cada um não é público."
        },
        {
          "@language": "en",
          "@value": "Signal a search engine uses to order results, such as content relevance, links, page experience and quality. The exact weight of each is not public."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-visibility-tool",
      "termCode": "ai-visibility-tool",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Ferramenta de visibilidade em IA"
        },
        {
          "@language": "en",
          "@value": "AI Visibility Tool"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Software que roda conjuntos de prompts em várias IAs e mede menções, citações, posição e sentimento da marca e dos concorrentes."
        },
        {
          "@language": "en",
          "@value": "Software that runs prompt sets across several AIs and measures mentions, citations, position and sentiment for the brand and competitors."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#faithfulness",
      "termCode": "faithfulness",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Fidelidade"
        },
        {
          "@language": "en",
          "@value": "Faithfulness"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quanto a resposta reproduz o que as fontes dizem, sem distorcer, omitir ou acrescentar. Uma resposta pode ser correta e não ser fiel à fonte citada."
        },
        {
          "@language": "en",
          "@value": "How closely the answer reproduces what the sources say, without distorting, omitting or adding. An answer can be correct without being faithful to the cited source."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#third-party-source",
      "termCode": "third-party-source",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Fonte de terceiros"
        },
        {
          "@language": "en",
          "@value": "Third-party Source"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página fora do controle da marca que fala dela, como notícia, avaliação, verbete ou fórum. IAs tendem a confiar mais nessas fontes do que no site da própria marca."
        },
        {
          "@language": "en",
          "@value": "Page outside the brand's control that talks about it, such as news, a review, an encyclopedia entry or a forum. AI tends to trust these more than the brand's own site."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#chunking",
      "termCode": "chunking",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Fragmentação em trechos"
        },
        {
          "@language": "en",
          "@value": "Chunking"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Divisão de documentos em pedaços menores antes de gerar embeddings, para que a recuperação traga só a parte relevante. Trechos que dependem de outros perdem sentido."
        },
        {
          "@language": "en",
          "@value": "Splitting documents into smaller pieces before creating embeddings, so retrieval returns only the relevant part. Chunks that depend on others lose meaning."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#information-gain",
      "termCode": "information-gain",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Ganho de informação"
        },
        {
          "@language": "en",
          "@value": "Information Gain"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "O quanto a página traz de novo em relação ao que já existe sobre o tema: dados próprios, experiência, exemplos e conclusões originais."
        },
        {
          "@language": "en",
          "@value": "How much new the page brings compared with what already exists on the topic: own data, experience, examples and original conclusions."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#geo-score",
      "termCode": "geo-score",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "GEO Score"
        },
        {
          "@language": "en",
          "@value": "GEO Score"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Nota de prontidão de um site para ser lido e citado por IAs, calculada a partir do que ele publica (acesso de robôs, identidade, schema, respostas citáveis, E-E-A-T). Mede prontidão, não garante citação."
        },
        {
          "@language": "en",
          "@value": "Score of a site's readiness to be read and cited by AI, calculated from what it publishes (bot access, identity, schema, citable answers, E-E-A-T). It measures readiness and does not guarantee citation."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#rag",
      "termCode": "rag",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Geração aumentada por recuperação"
        },
        {
          "@language": "en",
          "@value": "Retrieval-Augmented Generation (RAG)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Arquitetura em que o sistema busca documentos relevantes e os entrega ao modelo junto com a pergunta, para que a resposta se baseie neles e possa citá-los. É o mecanismo por trás da maioria das buscas com IA."
        },
        {
          "@language": "en",
          "@value": "Architecture in which the system retrieves relevant documents and hands them to the model with the question, so the answer is based on them and can cite them. It is the mechanism behind most AI search."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2005.11401"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ga4",
      "termCode": "ga4",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Google Analytics 4"
        },
        {
          "@language": "en",
          "@value": "Google Analytics 4 (GA4)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ferramenta de análise do Google baseada em eventos, usada para medir visitas, origem do tráfego e conversões, inclusive o tráfego vindo de IAs."
        },
        {
          "@language": "en",
          "@value": "Google's event-based analytics tool, used to measure visits, traffic sources and conversions, including traffic from AI."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#google-search-console",
      "termCode": "google-search-console",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Google Search Console"
        },
        {
          "@language": "en",
          "@value": "Google Search Console"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ferramenta gratuita do Google com dados de impressões, cliques, posições, indexação, Core Web Vitals e problemas do site na busca."
        },
        {
          "@language": "en",
          "@value": "Free Google tool with data on impressions, clicks, positions, indexing, Core Web Vitals and site issues in search."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://search.google.com/search-console/about"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#google-extended",
      "termCode": "google-extended",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Google-Extended"
        },
        {
          "@language": "en",
          "@value": "Google-Extended"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Token do robots.txt que controla se o conteúdo rastreado pelo Google pode ser usado para treinar e ancorar os modelos Gemini. Não afeta a busca nem os AI Overviews."
        },
        {
          "@language": "en",
          "@value": "robots.txt token controlling whether content crawled by Google may be used to train and ground Gemini models. It does not affect Search or AI Overviews."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/google-common-crawlers"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-governance",
      "termCode": "ai-governance",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Governança de IA"
        },
        {
          "@language": "en",
          "@value": "AI Governance"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Políticas, papéis, controles e registros que uma organização usa para decidir como desenvolve, compra e usa IA com responsabilidade."
        },
        {
          "@language": "en",
          "@value": "Policies, roles, controls and records an organization uses to decide how it builds, buys and uses AI responsibly."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#knowledge-graph",
      "termCode": "knowledge-graph",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Grafo de conhecimento"
        },
        {
          "@language": "en",
          "@value": "Knowledge Graph"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Base de entidades e das relações entre elas. O do Google alimenta painéis e respostas; cada site também pode publicar o seu com JSON-LD."
        },
        {
          "@language": "en",
          "@value": "Database of entities and the relationships between them. Google's feeds panels and answers; each site can also publish its own with JSON-LD."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-graph",
      "termCode": "entity-graph",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Grafo de entidades do site"
        },
        {
          "@language": "en",
          "@value": "Entity Graph (Site)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Rede de entidades que o site declara em JSON-LD (Organization, Person, WebSite, Service), ligadas por @id, que dá às máquinas um retrato coerente da marca."
        },
        {
          "@language": "en",
          "@value": "Network of entities a site declares in JSON-LD (Organization, Person, WebSite, Service), linked by @id, giving machines a coherent picture of the brand."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#llm",
      "termCode": "llm",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Grande modelo de linguagem"
        },
        {
          "@language": "en",
          "@value": "Large Language Model (LLM)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de rede neural treinado em grandes volumes de texto para prever e gerar linguagem. Exemplos: GPT, Claude, Gemini, Llama."
        },
        {
          "@language": "en",
          "@value": "Neural network model trained on large volumes of text to predict and generate language. Examples: GPT, Claude, Gemini, Llama."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#graphrag",
      "termCode": "graphrag",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "GraphRAG"
        },
        {
          "@language": "en",
          "@value": "GraphRAG"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Variante de RAG que usa um grafo de entidades e relações, além de trechos de texto, para responder perguntas que exigem ligar informações."
        },
        {
          "@language": "en",
          "@value": "RAG variant that uses a graph of entities and relationships, in addition to text chunks, to answer questions that require connecting information."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#https",
      "termCode": "https",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "HTTPS"
        },
        {
          "@language": "en",
          "@value": "HTTPS"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Versão criptografada do HTTP, com certificado TLS. É requisito básico de confiança e sinal leve de ranqueamento."
        },
        {
          "@language": "en",
          "@value": "Encrypted version of HTTP, using a TLS certificate. It is a basic trust requirement and a light ranking signal."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#human-in-the-loop",
      "termCode": "human-in-the-loop",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Humano no circuito"
        },
        {
          "@language": "en",
          "@value": "Human in the Loop"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Desenho em que uma pessoa revisa ou aprova etapas críticas do sistema de IA antes que tenham efeito."
        },
        {
          "@language": "en",
          "@value": "Design in which a person reviews or approves critical steps of an AI system before they take effect."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#generative-ai",
      "termCode": "generative-ai",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "IA generativa"
        },
        {
          "@language": "en",
          "@value": "Generative AI"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelos que criam conteúdo novo, como texto, imagem, áudio, vídeo ou código, a partir de um pedido."
        },
        {
          "@language": "en",
          "@value": "Models that create new content, such as text, images, audio, video or code, from a request."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#schema-id",
      "termCode": "schema-id",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Identificador @id"
        },
        {
          "@language": "en",
          "@value": "@id (Node Identifier)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Propriedade do JSON-LD que dá a cada entidade um identificador único, para ligar nós (Organization, Person, WebSite) entre páginas e formar um grafo."
        },
        {
          "@language": "en",
          "@value": "JSON-LD property giving each entity a unique identifier, linking nodes (Organization, Person, WebSite) across pages into a graph."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#impressions",
      "termCode": "impressions",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Impressões"
        },
        {
          "@language": "en",
          "@value": "Impressions"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quantas vezes uma página apareceu nos resultados para alguém, mesmo sem clique."
        },
        {
          "@language": "en",
          "@value": "How many times a page appeared in someone's results, even without a click."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#quotation-addition",
      "termCode": "quotation-addition",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Inclusão de citações"
        },
        {
          "@language": "en",
          "@value": "Quotation Addition"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Acrescentar citações atribuídas a especialistas ou fontes. Também apareceu entre os métodos eficazes no estudo original de GEO."
        },
        {
          "@language": "en",
          "@value": "Adding quotes attributed to experts or sources. It also appeared among the effective methods in the original GEO study."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2311.09735"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#statistics-addition",
      "termCode": "statistics-addition",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Inclusão de estatísticas"
        },
        {
          "@language": "en",
          "@value": "Statistics Addition"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Acrescentar dados quantitativos com fonte ao texto. No estudo original de GEO, estava entre os métodos que mais aumentaram a visibilidade nas respostas."
        },
        {
          "@language": "en",
          "@value": "Adding sourced quantitative data to text. In the original GEO study it was among the methods that most increased visibility in answers."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2311.09735"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#answer-inclusion",
      "termCode": "answer-inclusion",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Inclusão na resposta"
        },
        {
          "@language": "en",
          "@value": "Answer Inclusion"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando o conteúdo da página é usado para compor a resposta, mesmo que a página não seja citada explicitamente."
        },
        {
          "@language": "en",
          "@value": "When a page's content is used to build the answer, even if the page is not explicitly cited."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#indexing",
      "termCode": "indexing",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Indexação"
        },
        {
          "@language": "en",
          "@value": "Indexing"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Etapa em que o buscador processa a página rastreada, entende o conteúdo e a guarda no índice, de onde ela pode ser recuperada para uma consulta."
        },
        {
          "@language": "en",
          "@value": "Step in which the search engine processes a crawled page, understands its content and stores it in the index, from which it can be retrieved for a query."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/fundamentals/how-search-works"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#mobile-first-indexing",
      "termCode": "mobile-first-indexing",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Indexação mobile-first"
        },
        {
          "@language": "en",
          "@value": "Mobile-first Indexing"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "O Google usa a versão para celular da página para indexar e classificar. Conteúdo que falta no celular conta como ausente."
        },
        {
          "@language": "en",
          "@value": "Google uses the mobile version of a page for indexing and ranking. Content missing on mobile counts as absent."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/mobile/mobile-sites-mobile-first-indexing"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#indexnow",
      "termCode": "indexnow",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "IndexNow"
        },
        {
          "@language": "en",
          "@value": "IndexNow"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo aberto para o site avisar buscadores participantes, como Bing e Yandex, que uma URL foi criada, alterada ou removida. O Google não participa."
        },
        {
          "@language": "en",
          "@value": "Open protocol for a site to notify participating search engines, such as Bing and Yandex, that a URL was created, changed or removed. Google does not participate."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.indexnow.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#inference",
      "termCode": "inference",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Inferência"
        },
        {
          "@language": "en",
          "@value": "Inference"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Uso do modelo já treinado para gerar uma resposta. É o custo pago a cada pergunta."
        },
        {
          "@language": "en",
          "@value": "Using an already trained model to generate an answer. It is the cost paid for every question."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#prompt-injection",
      "termCode": "prompt-injection",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Injeção de prompt"
        },
        {
          "@language": "en",
          "@value": "Prompt Injection"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ataque em que um texto, inclusive escondido numa página ou documento, traz instruções que fazem o modelo desobedecer às regras originais. É o principal risco da lista OWASP para aplicações com LLM."
        },
        {
          "@language": "en",
          "@value": "Attack in which text, including text hidden in a page or document, carries instructions that make the model disobey its original rules. It tops the OWASP list of risks for LLM applications."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://genai.owasp.org/llm-top-10/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#artificial-intelligence",
      "termCode": "artificial-intelligence",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Inteligência artificial (IA)"
        },
        {
          "@language": "en",
          "@value": "Artificial Intelligence (AI)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Área da computação que cria sistemas capazes de realizar tarefas associadas à inteligência humana, como entender linguagem, reconhecer imagens, prever e decidir."
        },
        {
          "@language": "en",
          "@value": "Field of computing that builds systems able to perform tasks associated with human intelligence, such as understanding language, recognizing images, predicting and deciding."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#search-intent",
      "termCode": "search-intent",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Intenção de busca"
        },
        {
          "@language": "en",
          "@value": "Search Intent"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "O objetivo por trás de uma consulta: informar-se, navegar até um site, comparar opções ou comprar. Páginas que atendem a intenção dominante tendem a se posicionar melhor."
        },
        {
          "@language": "en",
          "@value": "The goal behind a query: to learn, to reach a site, to compare options or to buy. Pages that match the dominant intent tend to rank better."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#inp",
      "termCode": "inp",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Interação até a próxima renderização"
        },
        {
          "@language": "en",
          "@value": "Interaction to Next Paint (INP)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tempo que a página leva para responder visualmente às interações do usuário ao longo da visita. Substituiu o FID em março de 2024. Bom: até 200 ms."
        },
        {
          "@language": "en",
          "@value": "Time the page takes to respond visually to user interactions throughout the visit. It replaced FID in March 2024. Good: 200 ms or less."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://web.dev/articles/inp"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#late-interaction",
      "termCode": "late-interaction",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Interação tardia"
        },
        {
          "@language": "en",
          "@value": "Late Interaction (ColBERT)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Método de recuperação que compara a pergunta e o documento token a token, mais preciso que um único vetor por documento."
        },
        {
          "@language": "en",
          "@value": "Retrieval method that compares the question and the document token by token, more accurate than a single vector per document."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2004.12832"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#api",
      "termCode": "api",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Interface de programação de aplicações"
        },
        {
          "@language": "en",
          "@value": "Application Programming Interface (API)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Forma padronizada de um programa usar outro. As empresas de IA vendem acesso a modelos por API, cobrando por token."
        },
        {
          "@language": "en",
          "@value": "Standard way for one program to use another. AI companies sell model access through APIs, charging per token."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#jailbreak",
      "termCode": "jailbreak",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Jailbreak"
        },
        {
          "@language": "en",
          "@value": "Jailbreak"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Técnica de prompt para fazer o modelo ignorar suas regras de segurança."
        },
        {
          "@language": "en",
          "@value": "Prompting technique to make a model ignore its safety rules."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#context-window",
      "termCode": "context-window",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Janela de contexto"
        },
        {
          "@language": "en",
          "@value": "Context Window"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quantidade máxima de tokens que o modelo considera de uma vez, somando instruções, documentos, conversa e resposta."
        },
        {
          "@language": "en",
          "@value": "Maximum number of tokens the model considers at once, counting instructions, documents, conversation and answer."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#json-ld",
      "termCode": "json-ld",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "JSON-LD"
        },
        {
          "@language": "en",
          "@value": "JSON-LD"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Formato de dados ligados em JSON, recomendado pelo Google para dados estruturados. Fica num bloco <script> separado do HTML visível."
        },
        {
          "@language": "en",
          "@value": "JSON-based linked-data format recommended by Google for structured data. It lives in a <script> block separate from the visible HTML."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://www.w3.org/TR/json-ld11/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#latency",
      "termCode": "latency",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Latência"
        },
        {
          "@language": "en",
          "@value": "Latency"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tempo até o modelo começar ou terminar de responder. Afeta a experiência e o custo de agentes que fazem muitas chamadas."
        },
        {
          "@language": "en",
          "@value": "Time until the model starts or finishes answering. It affects the experience and the cost of agents making many calls."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#machine-readability",
      "termCode": "machine-readability",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Legibilidade por máquina"
        },
        {
          "@language": "en",
          "@value": "Machine Readability"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "O quanto o conteúdo pode ser lido sem esforço por robôs: HTML no servidor, estrutura semântica, dados estruturados e ausência de bloqueios por JavaScript, login ou CAPTCHA."
        },
        {
          "@language": "en",
          "@value": "How easily bots can read content: server-rendered HTML, semantic structure, structured data and no blocking by JavaScript, login or CAPTCHA."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#eu-ai-act",
      "termCode": "eu-ai-act",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Lei de IA da União Europeia"
        },
        {
          "@language": "en",
          "@value": "EU AI Act"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Regulamento europeu de 2024 que classifica sistemas de IA por nível de risco e impõe obrigações, como transparência para conteúdo gerado por IA."
        },
        {
          "@language": "en",
          "@value": "2024 European regulation that classifies AI systems by risk level and imposes obligations, such as transparency for AI-generated content."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#scaling-laws",
      "termCode": "scaling-laws",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Leis de escala"
        },
        {
          "@language": "en",
          "@value": "Scaling Laws"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Relações empíricas mostrando que o desempenho dos modelos melhora de forma previsível com mais parâmetros, dados e computação."
        },
        {
          "@language": "en",
          "@value": "Empirical relationships showing model performance improves predictably with more parameters, data and compute."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2001.08361"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#lgpd-ai",
      "termCode": "lgpd-ai",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "LGPD e IA"
        },
        {
          "@language": "en",
          "@value": "LGPD and AI"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Aplicação da Lei Geral de Proteção de Dados (Lei 13.709/2018) ao uso de IA no Brasil: base legal para tratar dados pessoais, transparência e direito de revisão de decisões automatizadas."
        },
        {
          "@language": "en",
          "@value": "Application of Brazil's General Data Protection Law (Law 13,709/2018) to AI: a legal basis for processing personal data, transparency and the right to review automated decisions."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#internal-linking",
      "termCode": "internal-linking",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Linkagem interna"
        },
        {
          "@language": "en",
          "@value": "Internal Linking"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Links entre páginas do mesmo site. Distribuem autoridade, mostram a hierarquia e ajudam robôs a descobrir conteúdo."
        },
        {
          "@language": "en",
          "@value": "Links between pages on the same site. They spread authority, show hierarchy and help bots discover content."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-ranking-list",
      "termCode": "ai-ranking-list",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Lista de \"melhores\""
        },
        {
          "@language": "en",
          "@value": "Listicle (Best-of List)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página do tipo \"as 10 melhores empresas de X\". Está entre os formatos mais citados por IAs em perguntas de recomendação, o que atrai abuso por listas autopromocionais."
        },
        {
          "@language": "en",
          "@value": "Page of the \"top 10 companies for X\" kind. It is among the formats AI cites most for recommendation questions, which invites abuse through self-promotional lists."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-slop",
      "termCode": "ai-slop",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Lixo gerado por IA"
        },
        {
          "@language": "en",
          "@value": "AI Slop"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conteúdo produzido por IA em massa, genérico e sem verificação. Polui a web, perde confiança e pode ser enquadrado como abuso de conteúdo em escala."
        },
        {
          "@language": "en",
          "@value": "Mass-produced, generic, unverified AI content. It pollutes the web, loses trust and may count as scaled content abuse."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#llm-as-judge",
      "termCode": "llm-as-judge",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "LLM como avaliador"
        },
        {
          "@language": "en",
          "@value": "LLM-as-a-judge"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Usar um modelo para avaliar respostas de outro segundo critérios definidos. É barato, mas tem vieses e precisa ser calibrado com avaliação humana."
        },
        {
          "@language": "en",
          "@value": "Using one model to grade another's answers against defined criteria. It is cheap but biased and needs calibration against human review."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2306.05685"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#lora",
      "termCode": "lora",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "LoRA (adaptação de baixo posto)"
        },
        {
          "@language": "en",
          "@value": "LoRA (Low-Rank Adaptation)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Método de ajuste fino que treina poucas matrizes adicionais em vez de todos os pesos, reduzindo muito o custo."
        },
        {
          "@language": "en",
          "@value": "Fine-tuning method that trains a few additional matrices instead of all weights, greatly cutting cost."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2106.09685"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#lcp",
      "termCode": "lcp",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Maior renderização de conteúdo"
        },
        {
          "@language": "en",
          "@value": "Largest Contentful Paint (LCP)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tempo até o maior elemento visível da tela (imagem ou bloco de texto) aparecer. Bom: até 2,5 segundos."
        },
        {
          "@language": "en",
          "@value": "Time until the largest visible element (image or text block) renders. Good: 2.5 seconds or less."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://web.dev/articles/lcp"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#watermarking",
      "termCode": "watermarking",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Marca d'água de IA"
        },
        {
          "@language": "en",
          "@value": "AI Watermarking"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Sinal embutido em conteúdo gerado por IA, visível ou não, que permite identificá-lo depois, como o SynthID do Google."
        },
        {
          "@language": "en",
          "@value": "Signal embedded in AI-generated content, visible or not, that lets it be identified later, such as Google's SynthID."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#markdown-for-agents",
      "termCode": "markdown-for-agents",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Markdown para agentes"
        },
        {
          "@language": "en",
          "@value": "Markdown for Agents"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Prática de oferecer versões em Markdown das páginas (por exemplo, a mesma URL com .md) para que agentes e LLMs leiam o conteúdo sem ruído de layout."
        },
        {
          "@language": "en",
          "@value": "Practice of offering Markdown versions of pages (for example, the same URL with .md) so agents and LLMs read the content without layout noise."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#attention-mechanism",
      "termCode": "attention-mechanism",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Mecanismo de atenção"
        },
        {
          "@language": "en",
          "@value": "Attention Mechanism"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Parte do modelo que pesa quanto cada palavra do contexto importa para interpretar ou gerar cada outra palavra."
        },
        {
          "@language": "en",
          "@value": "Part of the model that weighs how much each word in the context matters for interpreting or generating every other word."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/1706.03762"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#agent-memory",
      "termCode": "agent-memory",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Memória do agente"
        },
        {
          "@language": "en",
          "@value": "Agent Memory"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Informações que um agente guarda entre etapas ou conversas, como preferências do usuário e resultados anteriores."
        },
        {
          "@language": "en",
          "@value": "Information an agent keeps across steps or conversations, such as user preferences and earlier results."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-mention",
      "termCode": "ai-mention",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Menção por IA"
        },
        {
          "@language": "en",
          "@value": "AI Mention"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quando a marca aparece no texto da resposta de IA, com ou sem link para o site."
        },
        {
          "@language": "en",
          "@value": "When the brand appears in the AI answer text, with or without a link to the site."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#brand-mention",
      "termCode": "brand-mention",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Menção à marca"
        },
        {
          "@language": "en",
          "@value": "Brand Mention"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Citação do nome da marca em outro site, com ou sem link. Para IAs, menções em fontes confiáveis pesam tanto quanto links."
        },
        {
          "@language": "en",
          "@value": "Mention of the brand name on another site, with or without a link. For AI, mentions on trusted sources weigh as much as links."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#meta-description",
      "termCode": "meta-description",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Meta descrição"
        },
        {
          "@language": "en",
          "@value": "Meta Description"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Resumo da página em uma meta tag, que o buscador pode usar como trecho nos resultados. Não é fator de ranqueamento direto, mas afeta o clique."
        },
        {
          "@language": "en",
          "@value": "Page summary in a meta tag that the search engine may use as the result snippet. It is not a direct ranking factor, but it affects clicks."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/snippet"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#meta-robots",
      "termCode": "meta-robots",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Meta tag robots"
        },
        {
          "@language": "en",
          "@value": "Meta Robots Tag"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Meta tag no HTML que dá instruções de indexação e exibição por página, como noindex, nofollow, nosnippet e max-snippet."
        },
        {
          "@language": "en",
          "@value": "HTML meta tag giving per-page indexing and display instructions, such as noindex, nofollow, nosnippet and max-snippet."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/robots-meta-tag"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#mixture-of-experts",
      "termCode": "mixture-of-experts",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Mistura de especialistas"
        },
        {
          "@language": "en",
          "@value": "Mixture of Experts (MoE)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Arquitetura em que só parte dos parâmetros (os \"especialistas\" escolhidos) é usada para cada token, o que permite modelos grandes com custo de execução menor."
        },
        {
          "@language": "en",
          "@value": "Architecture in which only part of the parameters (the chosen \"experts\") is used for each token, allowing large models with lower running cost."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/1701.06538"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#diffusion-model",
      "termCode": "diffusion-model",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de difusão"
        },
        {
          "@language": "en",
          "@value": "Diffusion Model"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tipo de modelo generativo que cria imagens ou vídeos removendo ruído passo a passo, usado em ferramentas de geração de imagem."
        },
        {
          "@language": "en",
          "@value": "Type of generative model that creates images or video by removing noise step by step, used in image generation tools."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#foundation-model",
      "termCode": "foundation-model",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de fundação"
        },
        {
          "@language": "en",
          "@value": "Foundation Model"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo grande treinado em dados amplos que serve de base para muitas tarefas, adaptado por instruções, ajuste fino ou ferramentas."
        },
        {
          "@language": "en",
          "@value": "Large model trained on broad data that serves as the basis for many tasks, adapted through instructions, fine-tuning or tools."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#slm",
      "termCode": "slm",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de linguagem pequeno"
        },
        {
          "@language": "en",
          "@value": "Small Language Model (SLM)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo com menos parâmetros, mais barato e rápido, capaz de rodar no celular ou no computador, útil para tarefas específicas."
        },
        {
          "@language": "en",
          "@value": "Model with fewer parameters, cheaper and faster, able to run on a phone or laptop, useful for specific tasks."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#open-weight-model",
      "termCode": "open-weight-model",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de pesos abertos"
        },
        {
          "@language": "en",
          "@value": "Open-weight Model"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo cujos pesos podem ser baixados e rodados por qualquer um, como Llama, Mistral e Qwen. Não significa que os dados de treino sejam abertos."
        },
        {
          "@language": "en",
          "@value": "Model whose weights anyone can download and run, such as Llama, Mistral and Qwen. It does not mean the training data is open."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#prompt-template",
      "termCode": "prompt-template",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de prompt"
        },
        {
          "@language": "en",
          "@value": "Prompt Template"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Prompt com partes fixas e campos variáveis, reutilizado em escala com dados diferentes."
        },
        {
          "@language": "en",
          "@value": "Prompt with fixed parts and variable fields, reused at scale with different data."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#reasoning-model",
      "termCode": "reasoning-model",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de raciocínio"
        },
        {
          "@language": "en",
          "@value": "Reasoning Model"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "LLM treinado para \"pensar\" em etapas antes de responder, gastando mais tokens e tempo em troca de melhor desempenho em problemas difíceis."
        },
        {
          "@language": "en",
          "@value": "LLM trained to \"think\" in steps before answering, spending more tokens and time in exchange for better performance on hard problems."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#vision-language-model",
      "termCode": "vision-language-model",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo de visão e linguagem"
        },
        {
          "@language": "en",
          "@value": "Vision-language Model (VLM)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo que lê imagens e texto juntos, capaz de descrever fotos, ler capturas de tela e interpretar gráficos."
        },
        {
          "@language": "en",
          "@value": "Model that reads images and text together, able to describe photos, read screenshots and interpret charts."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#multimodal-model",
      "termCode": "multimodal-model",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modelo multimodal"
        },
        {
          "@language": "en",
          "@value": "Multimodal Model"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo que entende ou gera mais de um tipo de dado, como texto, imagem, áudio e vídeo."
        },
        {
          "@language": "en",
          "@value": "Model that understands or generates more than one data type, such as text, images, audio and video."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#ai-mode",
      "termCode": "ai-mode",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Modo IA"
        },
        {
          "@language": "en",
          "@value": "AI Mode"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modo de busca conversacional do Google, em aba própria, que decompõe a pergunta em várias buscas (query fan-out) e responde com fontes."
        },
        {
          "@language": "en",
          "@value": "Google's conversational search mode, in its own tab, that breaks the question into several searches (query fan-out) and answers with sources."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/appearance/ai-features"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#rank-tracking",
      "termCode": "rank-tracking",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Monitoramento de posições"
        },
        {
          "@language": "en",
          "@value": "Rank Tracking"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Acompanhamento periódico das posições do site para um conjunto de consultas, por local e dispositivo."
        },
        {
          "@language": "en",
          "@value": "Periodic tracking of a site's positions for a set of queries, by location and device."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#answer-engine",
      "termCode": "answer-engine",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Motor de resposta"
        },
        {
          "@language": "en",
          "@value": "Answer Engine"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Sistema que devolve a resposta em vez de uma lista de documentos, como Perplexity, assistentes de voz e chatbots com busca."
        },
        {
          "@language": "en",
          "@value": "System that returns the answer instead of a list of documents, such as Perplexity, voice assistants and chatbots with search."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#generative-engine",
      "termCode": "generative-engine",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Motor generativo"
        },
        {
          "@language": "en",
          "@value": "Generative Engine"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Sistema que responde a uma pergunta com texto gerado por um modelo de linguagem, em geral com base em documentos recuperados da web ou de um índice."
        },
        {
          "@language": "en",
          "@value": "System that answers a question with text generated by a language model, usually grounded in documents retrieved from the web or an index."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2311.09735"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cls",
      "termCode": "cls",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Mudança cumulativa de layout"
        },
        {
          "@language": "en",
          "@value": "Cumulative Layout Shift (CLS)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Mede quanto o conteúdo pula de lugar durante o carregamento. Bom: até 0,1."
        },
        {
          "@language": "en",
          "@value": "Measures how much content jumps around while loading. Good: 0.1 or less."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://web.dev/articles/cls"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#agentic-browser",
      "termCode": "agentic-browser",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Navegador agêntico"
        },
        {
          "@language": "en",
          "@value": "Agentic Browser"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Navegador ou modo de assistente que navega, clica e preenche páginas sozinho para cumprir uma tarefa, como os modos agente do ChatGPT e do Gemini."
        },
        {
          "@language": "en",
          "@value": "Browser or assistant mode that browses, clicks and fills in pages on its own to complete a task, such as the agent modes of ChatGPT and Gemini."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#faceted-navigation",
      "termCode": "faceted-navigation",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Navegação facetada"
        },
        {
          "@language": "en",
          "@value": "Faceted Navigation"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Filtros de listagem (cor, tamanho, preço) que geram muitas combinações de URL e podem consumir o rastreamento com páginas quase iguais."
        },
        {
          "@language": "en",
          "@value": "Listing filters (color, size, price) that create many URL combinations and can waste crawling on near-identical pages."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/crawling-managing-faceted-navigation"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#b2a",
      "termCode": "b2a",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Negócio para agente"
        },
        {
          "@language": "en",
          "@value": "Business-to-Agent (B2A)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo em que a empresa projeta produtos, dados e atendimento para serem consumidos por agentes de IA, não só por pessoas."
        },
        {
          "@language": "en",
          "@value": "Model in which a company designs products, data and service to be consumed by AI agents, not only people."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#nap",
      "termCode": "nap",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Nome, endereço e telefone"
        },
        {
          "@language": "en",
          "@value": "NAP (Name, Address, Phone)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Dados de contato da empresa. Devem ser idênticos no site, no Perfil da Empresa, em diretórios e no schema, para que buscadores e IAs reconheçam a mesma entidade."
        },
        {
          "@language": "en",
          "@value": "Business contact details. They must be identical on the site, the Business Profile, directories and schema so search engines and AI recognize the same entity."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#orchestration",
      "termCode": "orchestration",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Orquestração"
        },
        {
          "@language": "en",
          "@value": "Orchestration"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Camada que coordena modelos, ferramentas e etapas de um fluxo de IA, decidindo o que roda, em que ordem e com quais dados."
        },
        {
          "@language": "en",
          "@value": "Layer that coordinates models, tools and steps in an AI workflow, deciding what runs, in what order and with what data."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#crawl-budget",
      "termCode": "crawl-budget",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Orçamento de rastreamento"
        },
        {
          "@language": "en",
          "@value": "Crawl Budget"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quantidade de URLs que o robô se dispõe a rastrear num site em um período, limitada pela capacidade do servidor e pelo interesse do buscador. Importa sobretudo em sites grandes."
        },
        {
          "@language": "en",
          "@value": "Number of URLs a bot is willing to crawl on a site in a period, limited by server capacity and the search engine's demand. It matters mostly for large sites."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/large-site-managing-crawl-budget"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cro",
      "termCode": "cro",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização da taxa de conversão"
        },
        {
          "@language": "en",
          "@value": "Conversion Rate Optimization (CRO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Melhoria da página para que mais visitantes realizem a ação desejada, com testes e análise de comportamento."
        },
        {
          "@language": "en",
          "@value": "Improving a page so more visitors complete the desired action, using tests and behavior analysis."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#chunk-optimization",
      "termCode": "chunk-optimization",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização de trechos"
        },
        {
          "@language": "en",
          "@value": "Chunk Optimization"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Escrever cada seção para funcionar sozinha quando for recortada em pedaços pelo sistema de recuperação: assunto explícito, sem pronomes soltos e com a resposta no início."
        },
        {
          "@language": "en",
          "@value": "Writing each section to work on its own when the retrieval system cuts it into pieces: explicit subject, no dangling pronouns and the answer first."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#dpo",
      "termCode": "dpo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização direta de preferências"
        },
        {
          "@language": "en",
          "@value": "Direct Preference Optimization (DPO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Alternativa mais simples ao RLHF que treina o modelo direto nas comparações de preferência, sem modelo de recompensa separado."
        },
        {
          "@language": "en",
          "@value": "Simpler alternative to RLHF that trains the model directly on preference comparisons, without a separate reward model."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2305.18290"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#llmo",
      "termCode": "llmo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização para LLMs"
        },
        {
          "@language": "en",
          "@value": "LLM Optimization (LLMO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Outro nome usado no mercado para GEO, com foco em como os modelos de linguagem representam e citam a marca."
        },
        {
          "@language": "en",
          "@value": "Another market name for GEO, focused on how language models represent and cite the brand."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#seo",
      "termCode": "seo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização para mecanismos de busca"
        },
        {
          "@language": "en",
          "@value": "Search Engine Optimization (SEO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Conjunto de práticas técnicas, editoriais e de autoridade que aumentam a chance de uma página ser rastreada, indexada e bem posicionada nos resultados orgânicos de buscadores."
        },
        {
          "@language": "en",
          "@value": "Set of technical, editorial and authority practices that increase the chance of a page being crawled, indexed and ranked well in a search engine's organic results."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/fundamentals/seo-starter-guide"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#aeo",
      "termCode": "aeo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização para motores de resposta"
        },
        {
          "@language": "en",
          "@value": "Answer Engine Optimization (AEO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Otimização para que o conteúdo seja escolhido como resposta direta, em trechos em destaque, assistentes de voz e respostas de IA. Muitas vezes usado como sinônimo parcial de GEO."
        },
        {
          "@language": "en",
          "@value": "Optimization so content is chosen as the direct answer in featured snippets, voice assistants and AI answers. Often used as a partial synonym of GEO."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#geo",
      "termCode": "geo",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Otimização para motores generativos"
        },
        {
          "@language": "en",
          "@value": "Generative Engine Optimization (GEO)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Disciplina que aumenta a chance de uma marca, página ou fato ser encontrado, usado e citado corretamente por sistemas de IA generativa, como ChatGPT, Gemini, Perplexity, Copilot e os resumos de IA do Google. O termo vem do artigo de Aggarwal e colegas (2023)."
        },
        {
          "@language": "en",
          "@value": "Discipline that increases the chance of a brand, page or fact being found, used and correctly cited by generative AI systems such as ChatGPT, Gemini, Perplexity, Copilot and Google's AI summaries. The term comes from the paper by Aggarwal et al. (2023)."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2311.09735"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#local-pack",
      "termCode": "local-pack",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Pacote local"
        },
        {
          "@language": "en",
          "@value": "Local Pack (Map Pack)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Bloco com mapa e três empresas que aparece no topo de buscas com intenção local."
        },
        {
          "@language": "en",
          "@value": "Block with a map and three businesses shown at the top of searches with local intent."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#pagerank",
      "termCode": "pagerank",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "PageRank"
        },
        {
          "@language": "en",
          "@value": "PageRank"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Algoritmo original do Google que mede a importância de uma página pelos links que ela recebe, ponderados pela importância de quem linka. Segue em uso, com muitas variações."
        },
        {
          "@language": "en",
          "@value": "Google's original algorithm measuring a page's importance by the links it receives, weighted by the importance of the linking pages. Still used, with many variations."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://research.google/pubs/the-anatomy-of-a-large-scale-hypertextual-web-search-engine/"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#pagination",
      "termCode": "pagination",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Paginação"
        },
        {
          "@language": "en",
          "@value": "Pagination"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Divisão de uma lista longa em várias páginas. Cada página deve ter URL própria e rastreável e links para as outras."
        },
        {
          "@language": "en",
          "@value": "Splitting a long list across several pages. Each page needs its own crawlable URL and links to the others."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#knowledge-panel",
      "termCode": "knowledge-panel",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Painel de conhecimento"
        },
        {
          "@language": "en",
          "@value": "Knowledge Panel"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quadro com fatos sobre uma entidade (pessoa, empresa, lugar), alimentado pelo Knowledge Graph do Google."
        },
        {
          "@language": "en",
          "@value": "Box with facts about an entity (person, company, place), fed by Google's Knowledge Graph."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#keyword",
      "termCode": "keyword",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Palavra-chave"
        },
        {
          "@language": "en",
          "@value": "Keyword"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Termo ou expressão que as pessoas digitam no buscador e que uma página pretende atender."
        },
        {
          "@language": "en",
          "@value": "Word or phrase people type into a search engine and that a page aims to serve."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#long-tail-keyword",
      "termCode": "long-tail-keyword",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Palavra-chave de cauda longa"
        },
        {
          "@language": "en",
          "@value": "Long-tail Keyword"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Consulta mais específica e longa, com volume menor, concorrência menor e intenção geralmente mais clara."
        },
        {
          "@language": "en",
          "@value": "Longer, more specific query with lower volume, lower competition and usually clearer intent."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#share-of-voice",
      "termCode": "share-of-voice",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Participação de voz em IA"
        },
        {
          "@language": "en",
          "@value": "Share of Voice (AI)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Proporção das respostas de IA, num conjunto de perguntas, em que a marca aparece, comparada aos concorrentes."
        },
        {
          "@language": "en",
          "@value": "Share of AI answers, across a set of questions, in which the brand appears, compared with competitors."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#parameters",
      "termCode": "parameters",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Parâmetros (pesos)"
        },
        {
          "@language": "en",
          "@value": "Parameters (Weights)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Números internos ajustados no treinamento que guardam o que o modelo aprendeu. Modelos atuais têm de bilhões a trilhões de parâmetros."
        },
        {
          "@language": "en",
          "@value": "Internal numbers adjusted in training that store what the model learned. Current models have billions to trillions of parameters."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#lost-in-the-middle",
      "termCode": "lost-in-the-middle",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Perdido no meio"
        },
        {
          "@language": "en",
          "@value": "Lost in the Middle"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Efeito observado em LLMs que usam pior as informações no meio de um contexto longo do que as do começo e do fim."
        },
        {
          "@language": "en",
          "@value": "Effect observed in LLMs, which use information in the middle of a long context worse than at the start and end."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2307.03172"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#google-business-profile",
      "termCode": "google-business-profile",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Perfil da Empresa no Google"
        },
        {
          "@language": "en",
          "@value": "Google Business Profile (GBP)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ficha gratuita da empresa no Google Search e no Maps, com categoria, endereço, horário, fotos, avaliações e posts. Antigo Google Meu Negócio."
        },
        {
          "@language": "en",
          "@value": "Free business listing on Google Search and Maps, with category, address, hours, photos, reviews and posts. Formerly Google My Business."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://support.google.com/business"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#original-research",
      "termCode": "original-research",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Pesquisa própria"
        },
        {
          "@language": "en",
          "@value": "Original Research"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Dados coletados pela própria marca (pesquisas, testes, levantamentos). Geram links, menções e fatos que só ela pode oferecer, o que favorece a citação."
        },
        {
          "@language": "en",
          "@value": "Data collected by the brand itself (surveys, tests, studies). It earns links, mentions and facts only that brand can offer, which favors citation."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#content-pruning",
      "termCode": "content-pruning",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Poda de conteúdo"
        },
        {
          "@language": "en",
          "@value": "Content Pruning"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Revisão de páginas fracas ou desatualizadas para melhorar, juntar, redirecionar ou remover."
        },
        {
          "@language": "en",
          "@value": "Reviewing weak or outdated pages to improve, merge, redirect or remove them."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#citation-position",
      "termCode": "citation-position",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Posição da citação"
        },
        {
          "@language": "en",
          "@value": "Citation Position"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Ordem em que a fonte aparece na resposta ou na lista de fontes. Fontes citadas primeiro recebem mais atenção e cliques."
        },
        {
          "@language": "en",
          "@value": "Order in which a source appears in the answer or the source list. Sources cited first get more attention and clicks."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#average-position",
      "termCode": "average-position",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Posição média"
        },
        {
          "@language": "en",
          "@value": "Average Position"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Média da posição mais alta em que a página apareceu nas consultas em que foi exibida."
        },
        {
          "@language": "en",
          "@value": "Average of the highest position the page held across the queries where it appeared."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#next-token-prediction",
      "termCode": "next-token-prediction",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Previsão do próximo token"
        },
        {
          "@language": "en",
          "@value": "Next-token Prediction"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tarefa básica de um LLM: estimar qual token vem a seguir dado o texto anterior. A geração repete isso token a token."
        },
        {
          "@language": "en",
          "@value": "An LLM's basic task: estimating which token comes next given the preceding text. Generation repeats this token by token."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#nlp",
      "termCode": "nlp",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Processamento de linguagem natural"
        },
        {
          "@language": "en",
          "@value": "Natural Language Processing (NLP)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Área da IA dedicada a fazer computadores entenderem e produzirem linguagem humana."
        },
        {
          "@language": "en",
          "@value": "Field of AI devoted to making computers understand and produce human language."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#crawl-depth",
      "termCode": "crawl-depth",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Profundidade de clique"
        },
        {
          "@language": "en",
          "@value": "Crawl Depth (Click Depth)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quantos cliques separam uma página da home. Páginas muito profundas tendem a ser rastreadas com menos frequência."
        },
        {
          "@language": "en",
          "@value": "How many clicks separate a page from the home page. Very deep pages tend to be crawled less often."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#prompt",
      "termCode": "prompt",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Prompt"
        },
        {
          "@language": "en",
          "@value": "Prompt"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Texto de entrada que diz ao modelo o que fazer, com instruções, contexto, exemplos e formato desejado."
        },
        {
          "@language": "en",
          "@value": "Input text telling the model what to do, with instructions, context, examples and the desired format."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#few-shot",
      "termCode": "few-shot",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Prompt com poucos exemplos"
        },
        {
          "@language": "en",
          "@value": "Few-shot Prompting"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Incluir alguns exemplos de entrada e saída no prompt para mostrar o padrão esperado."
        },
        {
          "@language": "en",
          "@value": "Including a few input-output examples in the prompt to show the expected pattern."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#system-prompt",
      "termCode": "system-prompt",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Prompt de sistema"
        },
        {
          "@language": "en",
          "@value": "System Prompt"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Instruções de base que o desenvolvedor dá ao modelo, valendo para toda a conversa: papel, regras, tom e limites."
        },
        {
          "@language": "en",
          "@value": "Baseline instructions the developer gives the model for the whole conversation: role, rules, tone and limits."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#zero-shot",
      "termCode": "zero-shot",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Prompt sem exemplos"
        },
        {
          "@language": "en",
          "@value": "Zero-shot Prompting"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Pedir a tarefa sem dar exemplos, contando só com as instruções."
        },
        {
          "@language": "en",
          "@value": "Asking for the task without giving examples, relying only on instructions."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#agent-readiness",
      "termCode": "agent-readiness",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Prontidão para agentes"
        },
        {
          "@language": "en",
          "@value": "Agent Readiness"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Quanto um site pode ser usado por agentes de IA: conteúdo legível, formulários com rótulos corretos, ações declaradas, APIs documentadas e políticas claras."
        },
        {
          "@language": "en",
          "@value": "How usable a site is for AI agents: readable content, correctly labeled forms, declared actions, documented APIs and clear policies."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#same-as",
      "termCode": "same-as",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Propriedade sameAs"
        },
        {
          "@language": "en",
          "@value": "sameAs"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Propriedade Schema.org que aponta perfis oficiais da mesma entidade em outros lugares (Wikidata, LinkedIn, Instagram), ajudando a desambiguação."
        },
        {
          "@language": "en",
          "@value": "Schema.org property pointing to the same entity's official profiles elsewhere (Wikidata, LinkedIn, Instagram), helping disambiguation."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://schema.org/sameAs"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#brand-safety-ai",
      "termCode": "brand-safety-ai",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Proteção de marca em IA"
        },
        {
          "@language": "en",
          "@value": "Brand Protection in AI"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Monitorar e corrigir o que IAs dizem sobre a marca: fatos errados, confusão com homônimos, associação a temas negativos e conteúdo de concorrentes."
        },
        {
          "@language": "en",
          "@value": "Monitoring and correcting what AI says about the brand: wrong facts, confusion with namesakes, association with negative topics and competitor content."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#a2a",
      "termCode": "a2a",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo Agent2Agent"
        },
        {
          "@language": "en",
          "@value": "Agent2Agent Protocol (A2A)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo aberto, lançado pelo Google em 2025, para agentes de IA de fornecedores diferentes se descobrirem e trocarem tarefas."
        },
        {
          "@language": "en",
          "@value": "Open protocol, launched by Google in 2025, for AI agents from different vendors to discover each other and exchange tasks."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://a2a-protocol.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#mcp",
      "termCode": "mcp",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo de contexto de modelo"
        },
        {
          "@language": "en",
          "@value": "Model Context Protocol (MCP)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Protocolo aberto, criado pela Anthropic em 2024, que padroniza como aplicações de IA se conectam a ferramentas e fontes de dados externas."
        },
        {
          "@language": "en",
          "@value": "Open protocol, created by Anthropic in 2024, that standardizes how AI applications connect to external tools and data sources."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://modelcontextprotocol.io"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#content-provenance",
      "termCode": "content-provenance",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Proveniência de conteúdo"
        },
        {
          "@language": "en",
          "@value": "Content Provenance (C2PA)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Registro verificável da origem e das edições de um arquivo de mídia, como no padrão C2PA, que mostra se a peça foi criada ou alterada por IA."
        },
        {
          "@language": "en",
          "@value": "Verifiable record of a media file's origin and edits, as in the C2PA standard, showing whether it was created or altered by AI."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://c2pa.org"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#pretraining",
      "termCode": "pretraining",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Pré-treinamento"
        },
        {
          "@language": "en",
          "@value": "Pretraining"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Primeira e mais cara etapa do treino, em que o modelo aprende linguagem e conhecimento geral prevendo tokens em textos enormes."
        },
        {
          "@language": "en",
          "@value": "First and most expensive training stage, in which the model learns language and general knowledge by predicting tokens in huge texts."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#brand-facts-page",
      "termCode": "brand-facts-page",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Página de fatos da marca"
        },
        {
          "@language": "en",
          "@value": "Brand Facts Page"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página com os fatos oficiais e verificáveis da empresa (fundação, sede, serviços, números com fonte e data), feita para ser lida e citada por pessoas e IAs."
        },
        {
          "@language": "en",
          "@value": "Page with the company's official, verifiable facts (founding, headquarters, services, sourced and dated figures), made to be read and cited by people and AI."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#serp",
      "termCode": "serp",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Página de resultados do buscador"
        },
        {
          "@language": "en",
          "@value": "Search Engine Results Page (SERP)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página que o buscador devolve para uma consulta, com resultados orgânicos, anúncios e recursos como mapas, vídeos, perguntas relacionadas e resumos gerados por IA."
        },
        {
          "@language": "en",
          "@value": "Page a search engine returns for a query, combining organic results, ads and features such as maps, videos, related questions and AI-generated summaries."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#pillar-page",
      "termCode": "pillar-page",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Página pilar"
        },
        {
          "@language": "en",
          "@value": "Pillar Page"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página abrangente sobre um tema central que liga e recebe links das páginas de detalhe do cluster."
        },
        {
          "@language": "en",
          "@value": "Comprehensive page on a core topic that links to and from the cluster's detail pages."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#orphan-page",
      "termCode": "orphan-page",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Página órfã"
        },
        {
          "@language": "en",
          "@value": "Orphan Page"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página sem nenhum link interno apontando para ela. Robôs e pessoas têm dificuldade para encontrá-la."
        },
        {
          "@language": "en",
          "@value": "Page with no internal links pointing to it. Bots and people struggle to find it."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#entity-home",
      "termCode": "entity-home",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Página-casa da entidade"
        },
        {
          "@language": "en",
          "@value": "Entity Home"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Página que a própria entidade controla e que define oficialmente quem ela é, normalmente a página \"Sobre\". Serve de referência para buscadores e IAs."
        },
        {
          "@language": "en",
          "@value": "Page the entity itself controls that officially defines who it is, usually the \"About\" page. It is the reference for search engines and AI."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#post-training",
      "termCode": "post-training",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Pós-treinamento"
        },
        {
          "@language": "en",
          "@value": "Post-training"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Etapas depois do pré-treino que tornam o modelo útil e seguro: ajuste com instruções, preferências humanas e reforço."
        },
        {
          "@language": "en",
          "@value": "Stages after pretraining that make the model helpful and safe: instruction tuning, human preferences and reinforcement."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#quantization",
      "termCode": "quantization",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Quantização"
        },
        {
          "@language": "en",
          "@value": "Quantization"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Redução da precisão numérica dos pesos (por exemplo, de 16 para 4 bits) para o modelo ocupar menos memória e rodar mais rápido, com pequena perda de qualidade."
        },
        {
          "@language": "en",
          "@value": "Reducing the numeric precision of weights (for example, from 16 to 4 bits) so the model uses less memory and runs faster, with a small quality loss."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#crawling",
      "termCode": "crawling",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Rastreamento"
        },
        {
          "@language": "en",
          "@value": "Crawling"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Processo pelo qual o robô do buscador descobre e baixa páginas seguindo links e sitemaps."
        },
        {
          "@language": "en",
          "@value": "Process by which a search engine's bot discovers and downloads pages by following links and sitemaps."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/fundamentals/how-search-works"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#react-agent",
      "termCode": "react-agent",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "ReAct"
        },
        {
          "@language": "en",
          "@value": "ReAct"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Padrão em que o modelo alterna raciocínio e ação (usar uma ferramenta, observar o resultado) até concluir a tarefa."
        },
        {
          "@language": "en",
          "@value": "Pattern in which the model alternates reasoning and acting (using a tool, observing the result) until the task is done."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2210.03629"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#named-entity-recognition",
      "termCode": "named-entity-recognition",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Reconhecimento de entidades nomeadas"
        },
        {
          "@language": "en",
          "@value": "Named Entity Recognition (NER)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Tarefa de identificar no texto nomes de pessoas, empresas, lugares, datas e valores."
        },
        {
          "@language": "en",
          "@value": "Task of identifying names of people, companies, places, dates and amounts in text."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#dense-retrieval",
      "termCode": "dense-retrieval",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Recuperação densa"
        },
        {
          "@language": "en",
          "@value": "Dense Retrieval"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Recuperação de passagens comparando embeddings da pergunta e dos documentos, em vez de palavras."
        },
        {
          "@language": "en",
          "@value": "Retrieving passages by comparing embeddings of the question and the documents instead of words."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://arxiv.org/abs/2004.04906"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#serp-feature",
      "termCode": "serp-feature",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Recurso da página de resultados"
        },
        {
          "@language": "en",
          "@value": "SERP Feature"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Qualquer elemento além dos links azuis: trecho em destaque, painel de conhecimento, pacote local, carrossel, perguntas relacionadas, resumo por IA."
        },
        {
          "@language": "en",
          "@value": "Any element beyond the blue links: featured snippet, knowledge panel, local pack, carousel, related questions, AI summary."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#training-opt-out",
      "termCode": "training-opt-out",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Recusa de uso para treino"
        },
        {
          "@language": "en",
          "@value": "Training Opt-out"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Bloquear robôs de treino (por exemplo GPTBot) sem bloquear os de busca (OAI-SearchBot), para não ceder conteúdo ao treino e continuar aparecendo nas respostas."
        },
        {
          "@language": "en",
          "@value": "Blocking training bots (for example GPTBot) without blocking search bots (OAI-SearchBot), so content is not given to training but still appears in answers."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#cdn",
      "termCode": "cdn",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Rede de distribuição de conteúdo"
        },
        {
          "@language": "en",
          "@value": "Content Delivery Network (CDN)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Rede de servidores espalhados que entrega arquivos do ponto mais próximo do visitante, reduzindo o tempo de carregamento. Alguns CDNs também bloqueiam robôs de IA por padrão."
        },
        {
          "@language": "en",
          "@value": "Network of distributed servers that delivers files from the point closest to the visitor, cutting load time. Some CDNs also block AI bots by default."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#neural-network",
      "termCode": "neural-network",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Rede neural"
        },
        {
          "@language": "en",
          "@value": "Neural Network"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Modelo formado por camadas de unidades conectadas cujos pesos são ajustados no treinamento para transformar entradas em saídas."
        },
        {
          "@language": "en",
          "@value": "Model made of layers of connected units whose weights are adjusted in training to turn inputs into outputs."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#redirect-301",
      "termCode": "redirect-301",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Redirecionamento 301"
        },
        {
          "@language": "en",
          "@value": "301 Redirect"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Resposta HTTP que indica mudança permanente de endereço e transfere os sinais da URL antiga para a nova."
        },
        {
          "@language": "en",
          "@value": "HTTP response indicating a permanent move, passing the old URL's signals to the new one."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://developers.google.com/search/docs/crawling-indexing/301-redirects"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#index-coverage",
      "termCode": "index-coverage",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Relatório de indexação"
        },
        {
          "@language": "en",
          "@value": "Index Coverage (Page Indexing Report)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Relatório do Google Search Console que mostra quais URLs estão indexadas e o motivo das que não estão."
        },
        {
          "@language": "en",
          "@value": "Google Search Console report showing which URLs are indexed and why the others are not."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#digital-pr",
      "termCode": "digital-pr",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Relações públicas digitais"
        },
        {
          "@language": "en",
          "@value": "Digital PR"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Produção de notícias, dados e histórias para conseguir menções e links em veículos e sites de autoridade."
        },
        {
          "@language": "en",
          "@value": "Producing news, data and stories to earn mentions and links from media and authoritative sites."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#proximity-relevance-prominence",
      "termCode": "proximity-relevance-prominence",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Relevância, distância e proeminência"
        },
        {
          "@language": "en",
          "@value": "Relevance, Distance and Prominence"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Os três critérios que o Google declara para ordenar resultados locais: quanto a empresa combina com a busca, quão perto está e quão conhecida é."
        },
        {
          "@language": "en",
          "@value": "The three criteria Google states for ordering local results: how well the business matches the search, how close it is and how well known it is."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      },
      "subjectOf": "https://support.google.com/business/answer/7091"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#rendering",
      "termCode": "rendering",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Renderização"
        },
        {
          "@language": "en",
          "@value": "Rendering"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Execução do HTML, CSS e JavaScript da página para obter o conteúdo final que o usuário vê. Conteúdo que só aparece depois do JavaScript pode ser lido com atraso ou não ser lido por alguns robôs."
        },
        {
          "@language": "en",
          "@value": "Executing a page's HTML, CSS and JavaScript to obtain the final content the user sees. Content that only appears after JavaScript may be read late, or not at all, by some bots."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#server-side-rendering",
      "termCode": "server-side-rendering",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Renderização no servidor"
        },
        {
          "@language": "en",
          "@value": "Server-side Rendering (SSR)"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "O servidor entrega o HTML já montado, em vez de deixar o navegador montar a página com JavaScript. Robôs, inclusive os de IA que não executam JavaScript, leem o conteúdo na hora."
        },
        {
          "@language": "en",
          "@value": "The server delivers fully built HTML instead of letting the browser build the page with JavaScript. Bots, including AI bots that do not run JavaScript, read the content immediately."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#reranking",
      "termCode": "reranking",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Reordenação"
        },
        {
          "@language": "en",
          "@value": "Reranking"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Segunda etapa que reavalia os documentos recuperados com um modelo mais preciso e escolhe os melhores para o contexto."
        },
        {
          "@language": "en",
          "@value": "Second step that re-scores retrieved documents with a more accurate model and picks the best for the context."
        }
      ],
      "inDefinedTermSet": {
        "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#glossario"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/raphaelsousapereira/glossario-seo-geo-ia#rich-results",
      "termCode": "rich-results",
      "name": [
        {
          "@language": "pt-BR",
          "@value": "Resultados aprimorados"
        },
        {
          "@language": "en",
          "@value": "Rich Results"
        }
      ],
      "description": [
        {
          "@language": "pt-BR",
          "@value": "Resultados com elementos extras, como estrelas, preço, perguntas ou eventos, gerados a partir de dados estruturados válidos."
        },
        {
          "@language": "en",
          "@value": "Results with extra elements, such as stars, price, questions or events, generated from valid structured data."
        }
      ],
      "inDefinedTermSet": {
